<!DOCTYPE html>
<!--
  SAIC - PPMS
  Tela disponivel para usuarios autorizados pelo campo acesso_ppms.
-->
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <base target="_top">
  <title>PPMS - SiSMen</title>
  <style>
    :root {
      --bg: #eef4f7;
      --surface: #ffffff;
      --surface-soft: #f7fbfc;
      --ink: #263033;
      --muted: #66747c;
      --line: #d8e4e8;
      --red: #b31f2a;
      --blue: #315f72;
      --green: #2f7d55;
      --shadow: 0 18px 38px rgba(31, 48, 56, 0.10);
      --radius: 8px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: Arial, Helvetica, sans-serif;
      margin: 0;
      min-height: 100vh;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    button {
      border: 0;
      cursor: pointer;
      font-weight: 800;
    }

    button:disabled {
      cursor: not-allowed;
      opacity: 0.62;
    }

    label {
      color: var(--ink);
      display: block;
      font-size: 13px;
      font-weight: 800;
      margin-bottom: 7px;
    }

    input,
    select,
    textarea {
      background: #ffffff;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      color: var(--ink);
      min-height: 42px;
      outline: none;
      padding: 10px 12px;
      width: 100%;
    }

    textarea {
      min-height: 92px;
      resize: vertical;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(49, 95, 114, 0.14);
    }

    input[readonly] {
      background: var(--surface-soft);
      color: var(--muted);
      font-weight: 800;
    }

    input:disabled,
    select:disabled,
    textarea:disabled {
      background: #eef4f6;
      color: #7a8a90;
      cursor: not-allowed;
    }

    .app-shell {
      display: grid;
      grid-template-columns: 250px minmax(0, 1fr);
      min-height: 100vh;
    }

    .sidebar {
      background: linear-gradient(180deg, #5f6668 0%, #50575a 52%, #454b4e 100%);
      border-right: 3px solid #df0209;
      box-shadow: 12px 0 28px rgba(41, 48, 51, 0.10);
      color: #ffffff;
      height: 100vh;
      overflow-y: auto;
      padding: 24px 18px;
      position: sticky;
      top: 0;
    }

    .sidebar::after {
      content: none;
    }

    .brand {
      border-bottom: 1px solid rgba(255, 255, 255, 0.16);
      padding-bottom: 22px;
    }

    .brand strong {
      display: block;
      font-size: 20px;
      line-height: 1.1;
    }

    .brand span {
      color: rgba(255, 255, 255, 0.76);
      display: block;
      font-size: 12px;
      margin-top: 4px;
    }

    .side-nav {
      display: grid;
      gap: 8px;
      margin-top: 26px;
    }

    .side-nav button {
      background: transparent;
      border-radius: var(--radius);
      color: rgba(255, 255, 255, 0.84);
      min-height: 42px;
      padding: 10px 12px;
      text-align: left;
    }

    .side-nav button.active,
    .side-nav button:hover {
      background: rgba(255, 255, 255, 0.14);
      color: #ffffff;
    }

    .side-nav-separator {
      background: rgba(255, 255, 255, 0.16);
      height: 1px;
      margin: 10px 0;
    }

    .side-nav button.nav-voltar {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.18);
      color: #ffffff;
    }

    .content {
      min-width: 0;
      padding: 28px;
    }

    .page-banner {
      background: linear-gradient(135deg, #ffffff 0%, #eef6f8 100%);
      border: 1px solid rgba(216, 228, 232, 0.8);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      min-height: 142px;
      overflow: hidden;
      padding: 28px 30px;
      position: relative;
    }

    .page-banner::before,
    .page-banner::after {
      content: "";
      height: 8px;
      left: 0;
      pointer-events: none;
      position: absolute;
      width: 100%;
    }

    .page-banner::before {
      background: linear-gradient(100deg, var(--red) 0%, rgba(179, 31, 42, 0.7) 34%, transparent 86%);
      clip-path: polygon(0 0, 100% 0, 88% 100%, 0 100%);
      top: 0;
    }

    .page-banner::after {
      background: linear-gradient(280deg, #75848a 0%, rgba(117, 132, 138, 0.62) 36%, transparent 88%);
      bottom: 0;
      clip-path: polygon(12% 0, 100% 0, 100% 100%, 0 100%);
    }

    .banner-content {
      align-items: center;
      display: flex;
      gap: 20px;
      justify-content: space-between;
      position: relative;
      z-index: 1;
    }

    .eyebrow {
      color: var(--red);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0;
      margin: 0 0 8px;
      text-transform: uppercase;
    }

    .page-banner h1 {
      color: var(--ink);
      font-size: clamp(30px, 4vw, 44px);
      letter-spacing: 0;
      line-height: 1.08;
      margin: 0;
    }

    .page-banner span {
      color: var(--muted);
      display: block;
      font-weight: 700;
      margin-top: 8px;
    }

    .summary-card {
      background: rgba(255, 255, 255, 0.88);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      min-width: 230px;
      padding: 16px;
    }

    .summary-card small {
      color: var(--muted);
      display: block;
      font-weight: 800;
    }

    .summary-card strong {
      color: var(--ink);
      display: block;
      font-size: 18px;
      margin-top: 6px;
    }

    .status-line {
      color: var(--muted);
      font-size: 14px;
      font-weight: 700;
      margin: 18px 0;
      min-height: 22px;
    }

    .status-line.error {
      color: #b42318;
    }

    .status-line.success {
      color: var(--green);
    }

    .section {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      margin-top: 18px;
      padding: 22px;
    }

    .section-title {
      align-items: center;
      color: var(--ink);
      display: flex;
      font-size: 19px;
      gap: 10px;
      line-height: 1.2;
      margin: 0 0 18px;
    }

    .section-title::before {
      background: var(--red);
      border-radius: 999px;
      content: "";
      height: 24px;
      width: 4px;
    }

    .grid-2,
    .grid-3,
    .grid-4,
    .grid-5 {
      display: grid;
      gap: 16px;
    }

    .grid-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .grid-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .grid-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .grid-5 {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .grid-endereco-ppms {
      display: grid;
      gap: 16px;
      grid-template-columns: minmax(110px, 0.8fr) minmax(150px, 1fr) minmax(70px, 0.45fr) minmax(190px, 1.3fr) minmax(110px, 0.8fr);
    }

    .campo-rua-ppms,
    .campo-complemento-ppms {
      grid-column: span 2;
    }

    .field-span-2 {
      grid-column: span 2;
    }

    .field-span-3 {
      grid-column: span 3;
    }

    .field-full {
      grid-column: 1 / -1;
    }

    .field-helper {
      color: var(--muted);
      display: block;
      font-size: 12px;
      font-weight: 800;
      min-height: 18px;
      padding-top: 5px;
    }

    .campo-condicional {
      display: none;
      margin-top: 8px;
    }

    .campo-condicional.visivel {
      display: block;
    }

    .check-field {
      background: var(--surface-soft);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      min-height: 42px;
      padding: 10px 12px;
    }

    .check-field > label {
      margin-bottom: 8px;
    }

    .checkbox-row {
      display: flex;
      flex-direction: column;
      flex-wrap: wrap;
      gap: 8px;
    }

    .check-field.compacto {
      padding: 9px 12px;
    }

    .check-field.compacto .checkbox-row {
      align-items: center;
      flex-direction: row;
      gap: 12px;
    }

    .check-field.sem-titulo > label {
      display: none;
    }

    .checkbox-option {
      align-items: center;
      color: var(--ink);
      display: flex;
      font-size: 13px;
      font-weight: 800;
      gap: 7px;
      margin: 0;
    }

    .checkbox-option input {
      min-height: auto;
      width: auto;
    }

    .actions {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 18px;
    }

    .btn-primary {
      background: var(--blue);
      border-radius: var(--radius);
      box-shadow: 0 10px 20px rgba(49, 95, 114, 0.16);
      color: #ffffff;
      min-height: 44px;
      padding: 11px 16px;
    }

    .btn-secondary {
      background: #ffffff;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      color: var(--ink);
      min-height: 44px;
      padding: 11px 16px;
    }

    .ultimos-ppms-wrapper {
      position: relative;
    }

    .btn-ultimos-ppms {
      align-items: center;
      background: #ffffff;
      border: 1px solid var(--line);
      border-radius: 999px;
      color: var(--blue);
      display: inline-flex;
      height: 44px;
      justify-content: center;
      padding: 0;
      width: 44px;
    }

    .icone-relogio {
      border: 3px solid currentColor;
      border-radius: 50%;
      display: inline-block;
      height: 20px;
      position: relative;
      width: 20px;
    }

    .icone-relogio::before,
    .icone-relogio::after {
      background: currentColor;
      border-radius: 999px;
      content: "";
      left: 8px;
      position: absolute;
      top: 3px;
      transform-origin: bottom center;
      width: 2px;
    }

    .icone-relogio::before {
      height: 7px;
    }

    .icone-relogio::after {
      height: 5px;
      transform: rotate(90deg);
    }

    .ultimos-ppms-popover {
      background: #ffffff;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      bottom: calc(100% + 8px);
      box-shadow: 0 20px 42px rgba(15, 23, 42, 0.18);
      display: none;
      min-width: 320px;
      padding: 10px;
      position: absolute;
      right: 0;
      z-index: 30;
    }

    .ultimos-ppms-popover.ativo {
      display: block;
    }

    .ultimos-titulo {
      color: var(--ink);
      font-size: 13px;
      font-weight: 900;
      margin-bottom: 8px;
    }

    .ultimo-ppms-item {
      background: var(--surface-soft);
      border-radius: var(--radius);
      color: var(--ink);
      display: block;
      margin-top: 7px;
      padding: 9px;
      text-align: left;
      width: 100%;
    }

    .ultimo-ppms-item strong,
    .ultimo-ppms-item span {
      display: block;
    }

    .ultimo-ppms-item span {
      color: var(--muted);
      font-size: 12px;
      margin-top: 3px;
    }

    .ultimos-vazio {
      color: var(--muted);
      font-size: 13px;
      font-weight: 700;
      padding: 8px 2px;
    }

    .saving-inline {
      align-items: center;
      color: var(--muted);
      display: inline-flex;
      font-size: 13px;
      font-weight: 800;
      gap: 8px;
      min-height: 28px;
    }

    .saving-inline.success {
      color: var(--green);
    }

    .saving-inline.error {
      color: #b42318;
    }

    .saving-spinner,
    .navegacao-spinner {
      animation: girar 0.8s linear infinite;
      border-radius: 999px;
      border-style: solid;
    }

    .saving-spinner {
      border-color: rgba(49, 95, 114, 0.18);
      border-top-color: var(--blue);
      border-width: 2px;
      height: 16px;
      width: 16px;
    }

    @keyframes girar {
      to {
        transform: rotate(360deg);
      }
    }

    .navegacao-overlay {
      align-items: center;
      background: rgba(15, 23, 42, 0.42);
      display: none;
      inset: 0;
      justify-content: center;
      padding: 22px;
      position: fixed;
      z-index: 150;
    }

    .navegacao-card {
      align-items: center;
      background: #ffffff;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: 0 24px 60px rgba(15, 23, 42, 0.24);
      color: var(--ink);
      display: inline-flex;
      gap: 12px;
      min-width: 260px;
      padding: 18px 22px;
    }

    .navegacao-spinner {
      border-color: rgba(49, 95, 114, 0.18);
      border-top-color: var(--blue);
      border-width: 3px;
      height: 22px;
      width: 22px;
    }

    .navegacao-card strong {
      font-size: 15px;
      font-weight: 900;
    }

    @media (max-width: 980px) {
      .app-shell {
        grid-template-columns: 1fr;
      }

      .sidebar {
        height: auto;
        position: relative;
      }

      .content {
        padding: 18px;
      }

      .banner-content {
        align-items: stretch;
        flex-direction: column;
      }

      .grid-2,
      .grid-3,
      .grid-4,
      .grid-5,
      .grid-endereco-ppms,
      .field-span-2,
      .campo-rua-ppms,
      .campo-complemento-ppms,
      .field-full {
        grid-column: 1 / -1;
        grid-template-columns: 1fr;
      }

      .field-span-3 {
        grid-column: 1 / -1;
      }

      .check-field.compacto .checkbox-row {
        align-items: flex-start;
        flex-direction: column;
      }
    }

    @media (max-width: 620px) {
      body {
        font-size: 16px;
        line-height: 1.5;
      }

      input,
      select,
      textarea,
      button {
        font-size: 16px;
        min-height: 52px;
        padding: 13px 14px;
      }
    }
  </style>
</head>

<body>
  <div id="navegacaoOverlay" class="navegacao-overlay" aria-live="polite" aria-label="Carregando pagina">
    <div class="navegacao-card">
      <span class="navegacao-spinner"></span>
      <strong id="navegacaoMensagem">Carregando...</strong>
    </div>
  </div>

  <div class="app-shell">
    <aside class="sidebar" aria-label="PPMS">
      <div class="brand">
        <strong>PPMS</strong>
        <span>Sistema de Gest&atilde;o dos Atendimentos do SiSMen</span>
      </div>

      <nav class="side-nav">
        <button type="button" onclick="navegarModuloPrincipal('index')">Atendimento</button>
        <button type="button" onclick="navegarModuloPrincipal('eventos_coletivos')">Grupos e Palestras</button>
        <button type="button" onclick="navegarModuloPrincipal('incidente_critico')">Incidente Cr&iacute;tico</button>
        <button id="btnNavPPMS" type="button" class="active" onclick="navegarModuloPrincipal('ppms')">PPMS</button>
      </nav>
    </aside>

    <main class="content">
      <header class="page-banner">
        <div class="banner-content">
          <div>
            <p class="eyebrow">PPMS</p>
            <h1>Registro PPMS</h1>
            <span>Sistema de Gest&atilde;o dos Atendimentos do SiSMen</span>
          </div>
        </div>
      </header>

      <div id="statusTela" class="status-line"><?= mensagemLoginInicial ?></div>

      <section class="section" aria-label="Identificacao do fato">
        <h2 class="section-title">Identifica&ccedil;&atilde;o do Fato</h2>
        <div class="grid-3">
          <div>
            <label for="dataFato">Data do Fato</label>
            <input id="dataFato" type="text" inputmode="numeric" maxlength="10" placeholder="dd/mm/aaaa" oninput="mascaraDataBrasil(this); atualizarDiaSemana()" onblur="validarAnoDataCampo(this); atualizarDiaSemana()" required>
          </div>

          <div>
            <label for="horaFato">Hora do Fato</label>
            <input id="horaFato" type="time" required>
          </div>

          <div>
            <label for="diaSemana">Dia da Semana</label>
            <input id="diaSemana" type="text" readonly>
          </div>
        </div>
      </section>

      <section class="section" aria-label="Dados PPMS">
        <h2 class="section-title">Dados PPMS</h2>
        <div class="grid-3">
          <div>
            <label for="meioUtilizado">Meio Utilizado</label>
            <select id="meioUtilizado" onchange="atualizarMeioOutros()" required>
              <option value="">Selecione</option>
              <option value="arma de fogo">Arma de fogo</option>
              <option value="corda">Corda</option>
              <option value="armas brancas">Armas brancas</option>
              <option value="medicamento">Medicamento</option>
              <option value="auto-lesao">Auto-les&atilde;o</option>
              <option value="precipitacao">Precipita&ccedil;&atilde;o</option>
              <option value="outros">Outros</option>
            </select>
            <div id="grupoMeioOutros" class="campo-condicional">
              <input id="meioUtilizadoOutros" type="text" placeholder="Detalhe o meio utilizado" oninput="converterMaiusculasSemAcento(this)">
            </div>
          </div>

          <div>
            <label for="tentativaAnterior">Tentativa anterior</label>
            <select id="tentativaAnterior" required>
              <option value="">Selecione</option>
              <option value="sim">Sim</option>
              <option value="nao">N&atilde;o</option>
            </select>
          </div>

          <div>
            <label for="fatorPrecipitante">Fator Precipitante</label>
            <input id="fatorPrecipitante" type="text" placeholder="Descreva o fator precipitante" required>
          </div>

          <div class="check-field compacto sem-titulo field-span-3">
            <label>Acompanhamentos e passagens</label>
            <div class="checkbox-row">
              <label class="checkbox-option" for="acompanhamentoCaps">
                <input id="acompanhamentoCaps" type="checkbox">
                Acompanhamento em psicoterapia pelo CAPS/NAPS
              </label>
              <label class="checkbox-option" for="passagemCaps">
                <input id="passagemCaps" type="checkbox">
                Passagem pelo CAPS/NAPS
              </label>
              <label class="checkbox-option" for="acompanhamentoPsiquiatria">
                <input id="acompanhamentoPsiquiatria" type="checkbox">
                Acompanhamento em psiquiatria
              </label>
              <label class="checkbox-option" for="passagemPsiquiatria">
                <input id="passagemPsiquiatria" type="checkbox">
                Passagem pela psiquiatria
              </label>
            </div>
          </div>
        </div>
      </section>

      <section class="section" aria-label="Dados pessoais e funcionais">
        <h2 class="section-title">Dados Pessoais e Funcionais</h2>
        <div class="grid-5">
          <div>
            <label for="postoGraduacao">Posto/Gradua&ccedil;&atilde;o</label>
            <select id="postoGraduacao" required>
              <option value="">Selecione</option>
              <option>Sd PM</option>
              <option>Cb PM</option>
              <option>3&ordm; Sgt PM</option>
              <option>2&ordm; Sgt PM</option>
              <option>1&ordm; Sgt PM</option>
              <option>Subten PM</option>
              <option>Asp of PM</option>
              <option>2&ordm; Ten PM</option>
              <option>1&ordm; Ten PM</option>
              <option>Cap PM</option>
              <option>Maj PM</option>
              <option>Ten Cel PM</option>
              <option>Cel PM</option>
            </select>
          </div>

          <div>
            <label for="opmAtual">OPM Atual/&Uacute;ltima</label>
            <input id="opmAtual" type="text" list="listaOPM" placeholder="Digite ou selecione a OPM" oninput="converterMaiusculasSemAcento(this); limparErroVisualCampo(this)" onblur="padronizarCampoOPM(this)" required>
            <datalist id="listaOPM">
              <option value="CAPS"></option>
              <option value="PMRG"></option>
              <option value="APMBB"></option>
              <option value="COPOM"></option>
              <option value="CCB"></option>
              <option value="CRPM"></option>
              <option value="C MED"></option>
              <option value="1.BPM/M"></option>
              <option value="2.BPM/M"></option>
              <option value="3.BPM/M"></option>
              <option value="4.BPM/M"></option>
              <option value="5.BPM/M"></option>
              <option value="6.BPM/M"></option>
              <option value="7.BPM/M"></option>
              <option value="8.BPM/M"></option>
              <option value="9.BPM/M"></option>
              <option value="10.BPM/M"></option>
              <option value="11.BPM/M"></option>
              <option value="12.BPM/M"></option>
              <option value="13.BPM/M"></option>
              <option value="14BPM/M"></option>
              <option value="15.BPM/M"></option>
              <option value="16.BPM/M"></option>
              <option value="17.BPM/M"></option>
              <option value="18.BPM/M"></option>
              <option value="19.BPM/M"></option>
              <option value="20.BPM/M"></option>
              <option value="21.BPM/M"></option>
              <option value="22.BPM/M"></option>
              <option value="23.BPM/M"></option>
              <option value="24.BPM/M"></option>
              <option value="25.BPM/M"></option>
              <option value="26.BPM/M"></option>
              <option value="27.BPM/M"></option>
              <option value="28.BPM/M"></option>
              <option value="29.BPM/M"></option>
              <option value="30.BPM/M"></option>
              <option value="31.BPM/M"></option>
              <option value="32.BPM/M"></option>
              <option value="33.BPM/M"></option>
              <option value="35.BPM/M"></option>
              <option value="36.BPM/M"></option>
              <option value="37.BPM/M"></option>
              <option value="38.BPM/M"></option>
              <option value="39.BPM/M"></option>
              <option value="40.BPM/M"></option>
