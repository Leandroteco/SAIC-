  <script>
    const webAppUrl = "<?= webAppUrl ?>";
    let tokenGoogle = "<?= tokenGoogleInicial ?>";
    let usuarioLogado = <?!= usuarioInicialJson ?>;
    let mensagemLoginInicial = <?!= JSON.stringify(mensagemLoginInicial || "") ?>;
    let ultimosPPMSCarregados = false;
    let ultimosPPMSCarregando = false;
    let navegacaoAlteracoesPendentes = false;

    window.addEventListener("load", function() {
      if (!tokenGoogle || !usuarioLogado || !usuarioLogado.autorizado) {
        mostrarStatus(mensagemLoginInicial || "Abra PPMS pelo menu do formulario.", "error");
        bloquearTela();
        return;
      }

      if (!usuarioPodeAcessarPPMS()) {
        mostrarStatus("Acesso permitido somente para usuarios autorizados ao PPMS.", "error");
        bloquearTela();
        return;
      }

      document.getElementById("responsavel").value = formatarResponsavelSistema(usuarioLogado.nome || usuarioLogado.email || "");
      preencherDataFatoSeVazia();
      atualizarDiaSemana();
      atualizarCalculosDatas();
      atualizarEscalaPorSituacao();
      atualizarObrigatoriedadeDataInatividade();
      registrarLimpezaStatusAoEditar();
      configurarMenuPrincipalPorPerfil();
      mostrarStatus("Pronto para registrar PPMS.", "");
    });

    document.addEventListener("click", function(evento) {
      const wrapper = document.querySelector(".ultimos-ppms-wrapper");

      if (wrapper && !wrapper.contains(evento.target)) {
        fecharUltimosPPMS();
      }
    });

    function usuarioPodeAcessarPPMS() {
      const valor = usuarioLogado && usuarioLogado.acessoPpms;

      return valor === true ||
        String(valor || "")
          .toLowerCase()
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .trim() === "sim";
    }

    function configurarMenuPrincipalPorPerfil() {
      const botaoPPMS = document.getElementById("btnNavPPMS");

      if (botaoPPMS) {
        botaoPPMS.style.display = usuarioPodeAcessarPPMS() ? "" : "none";
      }
    }

    function navegarModuloPrincipal(pagina) {
      if (pagina === "ppms") return;

      if (!tokenGoogle || !webAppUrl) {
        mostrarStatus("Sessao expirada. Acesse novamente pelo formulario.", "error");
        return;
      }

      if (!confirmarNavegacaoComAlteracoesPendentes()) return;

      mostrarCarregamentoNavegacao(obterMensagemCarregamentoModulo(pagina));

      const form = document.createElement("form");
      form.method = "post";
      form.action = webAppUrl;
      form.target = "_top";
      form.style.display = "none";

      const campoToken = document.createElement("input");
      campoToken.type = "hidden";
      campoToken.name = "credential";
      campoToken.value = tokenGoogle;

      const campoDestino = document.createElement("input");
      campoDestino.type = "hidden";
      campoDestino.name = "state";
      campoDestino.value = pagina;

      form.appendChild(campoToken);
      form.appendChild(campoDestino);
      document.body.appendChild(form);

      setTimeout(function() {
        form.submit();
        form.remove();
      }, 80);
    }

    function obterMensagemCarregamentoModulo(pagina) {
      const mensagens = {
        index: "Carregando Atendimento...",
        eventos_coletivos: "Carregando Grupos e Palestras...",
        incidente_critico: "Carregando Incidente Cr\u00edtico..."
      };

      return mensagens[pagina] || "Carregando...";
    }

    function confirmarNavegacaoComAlteracoesPendentes() {
      if (!navegacaoAlteracoesPendentes) return true;

      return window.confirm("Há dados preenchidos que ainda não foram salvos. Deseja sair mesmo assim?");
    }

    function marcarAlteracaoPendenteNavegacao() {
      navegacaoAlteracoesPendentes = true;
    }

    function limparAlteracaoPendenteNavegacao() {
      navegacaoAlteracoesPendentes = false;
    }

    function salvarRegistroPPMS() {
      if (!validarFormularioPPMS()) return;

      definirStatusSalvar(true, "Salvando PPMS...");

      google.script.run
        .withSuccessHandler(function(retorno) {
          definirStatusSalvar(false, "Salvo.", "success");
          limparFormularioPPMS();
          limparAlteracaoPendenteNavegacao();
          ultimosPPMSCarregados = false;
          mostrarStatus(retorno && retorno.mensagem ? retorno.mensagem : "Registro PPMS salvo com sucesso.", "success");
        })
        .withFailureHandler(function(erro) {
          definirStatusSalvar(false, obterMensagemErro(erro), "error");
          mostrarStatus(obterMensagemErro(erro), "error");
        })
        .salvarPPMS(montarDadosPPMS(), tokenGoogle);
    }

    function montarDadosPPMS() {
      return {
        dataFato: valorDataCampo("dataFato"),
        horaFato: valorCampo("horaFato"),
        postoGraduacao: valorCampo("postoGraduacao"),
        opmAtual: valorCampo("opmAtual"),
        situacaoStatus: valorCampo("situacaoStatus"),
        servico: obterServicoPPMS(),
        dataIngresso: valorDataCampo("dataIngresso"),
        dataInatividade: valorDataCampo("dataInatividade"),
        meioUtilizado: valorCampo("meioUtilizado"),
        meioUtilizadoOutros: valorCampo("meioUtilizadoOutros"),
        fatorPrecipitante: valorCampo("fatorPrecipitante"),
        tentativaAnterior: valorCampo("tentativaAnterior"),
        acompanhamentoCaps: document.getElementById("acompanhamentoCaps").checked,
        acompanhamentoPsiquiatria: document.getElementById("acompanhamentoPsiquiatria").checked,
        passagemCaps: document.getElementById("passagemCaps").checked,
        passagemPsiquiatria: document.getElementById("passagemPsiquiatria").checked,
        numeroFilhos: valorCampo("numeroFilhos"),
        dataNascimento: valorDataCampo("dataNascimento"),
        estadoCivil: valorCampo("estadoCivil"),
        sexo: valorCampo("sexo"),
        cep: valorCampo("cep"),
        rua: valorCampo("rua"),
        bairro: valorCampo("bairro"),
        cidade: valorCampo("cidade"),
        estado: valorCampo("estado"),
        numero: valorCampo("numero"),
        tipoLocalEndereco: valorCampo("tipoLocalEndereco"),
        complemento: valorCampo("complemento")
      };
    }

    function validarFormularioPPMS() {
      const camposObrigatorios = [
        "dataFato",
        "horaFato",
        "postoGraduacao",
        "opmAtual",
        "situacaoStatus",
        "dataIngresso",
        "meioUtilizado",
        "fatorPrecipitante",
        "tentativaAnterior",
        "dataNascimento",
        "estadoCivil",
        "sexo",
        "cep",
        "rua",
        "bairro",
        "cidade",
        "estado",
        "numero",
        "tipoLocalEndereco"
      ];

      if (campoMeioOutrosObrigatorio()) {
        camposObrigatorios.push("meioUtilizadoOutros");
      }

      if (statusExigeDataInatividade()) {
        camposObrigatorios.push("dataInatividade");
      }

      if (situacaoPermiteEscala() && !obterServicoPPMS()) {
        ["servico", "folga", "inTinere"].forEach(function(id) {
          const campo = document.getElementById(id);
          if (campo) campo.parentElement.style.color = "#b42318";
        });
        mostrarStatus("Informe se estava em servi\u00e7o, folga ou in tinere.", "error");
        return false;
      }

      let valido = true;
      let opmInvalida = false;
      camposObrigatorios.forEach(function(id) {
        const campo = document.getElementById(id);
        if (!campo) return;

        if (!campo.value.trim()) {
          marcarCampoObrigatorio(campo);
          valido = false;
        }
      });

      const campoOPM = document.getElementById("opmAtual");
      if (campoOPM && campoOPM.value.trim() && !padronizarCampoOPM(campoOPM)) {
        marcarCampoObrigatorio(campoOPM);
        valido = false;
        opmInvalida = true;
      }

      if (!validarDatasFormulario(["dataFato", "dataIngresso", "dataInatividade", "dataNascimento"], ["dataFato", "dataIngresso", "dataNascimento"])) {
        valido = false;
      }

      if (!valido) {
        mostrarStatus(opmInvalida ? "Selecione uma OPM válida da lista." : "Preencha os campos obrigatorios destacados.", "error");
      }

      return valido;
    }

    function alternarUltimosPPMS(evento) {
      if (evento) evento.stopPropagation();

      const painel = document.getElementById("painelUltimosPPMS");
      if (!painel) return;

      if (painel.classList.contains("ativo")) {
        fecharUltimosPPMS();
        return;
      }

      painel.classList.add("ativo");
      carregarUltimosPPMS(false);
    }

    function fecharUltimosPPMS() {
      const painel = document.getElementById("painelUltimosPPMS");
      if (painel) painel.classList.remove("ativo");
    }

    function carregarUltimosPPMS(forcarAtualizacao) {
      const painel = document.getElementById("painelUltimosPPMS");
      if (!painel || ultimosPPMSCarregando) return;
      if (ultimosPPMSCarregados && !forcarAtualizacao) return;

      if (!window.google || !google.script || !google.script.run) {
        painel.innerHTML = '<div class="ultimos-vazio">Abra pelo Apps Script para carregar a lista.</div>';
        return;
      }

      ultimosPPMSCarregando = true;
      painel.innerHTML = '<div class="ultimos-vazio">Carregando...</div>';

      google.script.run
        .withSuccessHandler(function(lista) {
          ultimosPPMSCarregando = false;
          ultimosPPMSCarregados = true;
          renderizarUltimosPPMS(lista || []);
        })
        .withFailureHandler(function(erro) {
          ultimosPPMSCarregando = false;
          painel.innerHTML = '<div class="ultimos-vazio">Erro ao carregar: ' + escaparHtml(obterMensagemErro(erro)) + '</div>';
        })
        .obterUltimosPPMSResponsavel(tokenGoogle);
    }

    function renderizarUltimosPPMS(lista) {
      const painel = document.getElementById("painelUltimosPPMS");
      if (!painel) return;

      if (!lista.length) {
        painel.innerHTML = '<div class="ultimos-titulo">&Uacute;ltimos PPMS</div>' +
          '<div class="ultimos-vazio">Nenhum registro salvo por este usu&aacute;rio.</div>';
        return;
      }

      painel.innerHTML = '<div class="ultimos-titulo">&Uacute;ltimos PPMS</div>' + lista.map(function(item) {
        const titulo = item.dataFato ? "Fato em " + item.dataFato : "Registro PPMS";
        const detalhe = [
          item.opmAtual ? "OPM " + item.opmAtual : "",
          item.meioUtilizado ? "Meio " + item.meioUtilizado : "",
          item.dataHoraCadastro ? "Salvo em " + item.dataHoraCadastro : ""
        ].filter(Boolean).join(" - ");

        return '<div class="ultimo-ppms-item">' +
          '<strong>' + escaparHtml(titulo) + '</strong>' +
          '<span>' + escaparHtml(detalhe) + '</span>' +
        '</div>';
      }).join("");
    }

    function limparFormularioPPMS() {
      document.querySelectorAll("input, select, textarea").forEach(function(campo) {
        if (campo.id === "responsavel") return;
        if (campo.type === "checkbox") {
          campo.checked = false;
        } else if (campo.id === "numeroFilhos") {
          campo.value = "0";
        } else {
          campo.value = "";
        }

        limparErroVisualCampo(campo);
      });

      preencherDataFatoSeVazia();
      atualizarDiaSemana();
      atualizarCalculosDatas();
      atualizarMeioOutros();
      atualizarEscalaPorSituacao();
      atualizarObrigatoriedadeDataInatividade();
      limparAlteracaoPendenteNavegacao();
    }

    function preencherDataFatoSeVazia() {
      const campo = document.getElementById("dataFato");
      if (campo && !campo.value.trim()) campo.value = formatarDataBrasil(new Date());
    }

    function atualizarMeioOutros() {
      const grupo = document.getElementById("grupoMeioOutros");
      const campo = document.getElementById("meioUtilizadoOutros");
      const obrigatorio = campoMeioOutrosObrigatorio();

      if (grupo) grupo.classList.toggle("visivel", obrigatorio);
      if (campo) {
        campo.required = obrigatorio;
        if (!obrigatorio) {
          campo.value = "";
          limparErroVisualCampo(campo);
        }
      }
    }

    function campoMeioOutrosObrigatorio() {
      return normalizarTexto(valorCampo("meioUtilizado")) === "outros";
    }

    function alternarServicoFolga(campoMarcado) {
      if (!campoMarcado || !campoMarcado.checked) return;

      ["servico", "folga", "inTinere"].forEach(function(id) {
        const campo = document.getElementById(id);
        if (campo && campo !== campoMarcado) {
          campo.checked = false;
          campo.parentElement.style.color = "";
        }
      });
    }

    function atualizarEscalaPorSituacao() {
      const permiteEscala = situacaoPermiteEscala();

      ["servico", "folga", "inTinere"].forEach(function(id) {
        const campo = document.getElementById(id);
        if (!campo) return;

        campo.disabled = !permiteEscala;
        campo.parentElement.style.color = "";
        if (!permiteEscala) campo.checked = false;
      });
    }

    function situacaoPermiteEscala() {
      const situacao = normalizarTexto(valorCampo("situacaoStatus"));

      return situacao === "agregado(a)" ||
        situacao === "ativo administrativo" ||
        situacao === "ativo operacional";
    }

    function statusExigeDataInatividade() {
      const situacao = normalizarTexto(valorCampo("situacaoStatus"));
      return situacao === "inativo" || situacao === "exonerado(a)";
    }

    function atualizarObrigatoriedadeDataInatividade() {
      const campo = document.getElementById("dataInatividade");
      if (!campo) return;

      const exigida = statusExigeDataInatividade();
      campo.required = exigida;
      campo.disabled = !exigida;

      if (!exigida) {
        campo.value = "";
        limparErroVisualCampo(campo);
      }

      atualizarCalculosDatas();
    }

    function obterServicoPPMS() {
      if (document.getElementById("servico") && document.getElementById("servico").checked) return "servico";
      if (document.getElementById("folga") && document.getElementById("folga").checked) return "folga";
      if (document.getElementById("inTinere") && document.getElementById("inTinere").checked) return "in tinere";

      return "";
    }

    function atualizarDiaSemana() {
      const campo = document.getElementById("diaSemana");
      if (!campo) return;

      const data = obterDataPorCampoBrasil("dataFato");
      campo.value = data ? obterNomeDiaSemana(data) : "";
    }

    function atualizarCalculosDatas() {
      const hoje = new Date();

      preencherTexto("idadeCalculada", calcularIdadeAnos(obterDataPorCampoBrasil("dataNascimento"), hoje));
      preencherTexto("tempoServico", calcularAnosMeses(obterDataPorCampoBrasil("dataIngresso"), hoje, "Tempo de servi\u00e7o"));
      preencherTexto("tempoInatividade", calcularAnosMeses(obterDataPorCampoBrasil("dataInatividade"), hoje, "Tempo de inatividade"));
    }

    function calcularIdadeAnos(data, hoje) {
      if (!data) return "";

      let anos = hoje.getFullYear() - data.getFullYear();
      const aniversarioPassou = hoje.getMonth() > data.getMonth() ||
        (hoje.getMonth() === data.getMonth() && hoje.getDate() >= data.getDate());

      if (!aniversarioPassou) anos--;

      return anos >= 0 ? "Idade: " + anos + " ano" + (anos === 1 ? "" : "s") : "";
    }

    function calcularAnosMeses(data, hoje, rotulo) {
      if (!data) return "";

      let anos = hoje.getFullYear() - data.getFullYear();
      let meses = hoje.getMonth() - data.getMonth();

      if (hoje.getDate() < data.getDate()) meses--;
      if (meses < 0) {
        anos--;
        meses += 12;
      }

      if (anos < 0) return "";

      return rotulo + ": " + anos + " ano" + (anos === 1 ? "" : "s") + " e " +
        meses + " mes" + (meses === 1 ? "" : "es");
    }

    function obterDataPorCampoBrasil(id) {
      const valor = valorCampo(id);
      const partes = valor.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);

      if (!partes) return null;

      const data = new Date(Number(partes[3]), Number(partes[2]) - 1, Number(partes[1]));

      if (data.getFullYear() !== Number(partes[3]) ||
        data.getMonth() !== Number(partes[2]) - 1 ||
        data.getDate() !== Number(partes[1])) {
        return null;
      }

      return data;
    }

    function obterNomeDiaSemana(data) {
      return [
        "domingo",
        "segunda-feira",
        "terca-feira",
        "quarta-feira",
        "quinta-feira",
        "sexta-feira",
        "sabado"
      ][data.getDay()];
    }

    function preencherTexto(id, texto) {
      const el = document.getElementById(id);
      if (el) el.innerText = texto || "";
    }

    function buscarCep() {
      const cep = document.getElementById("cep").value.replace(/\D/g, "");

      if (cep.length !== 8) return;

      fetch("https://viacep.com.br/ws/" + cep + "/json/")
        .then(function(resposta) {
          return resposta.json();
        })
        .then(function(dados) {
          if (!dados.erro) {
            document.getElementById("rua").value = dados.logradouro || "";
            document.getElementById("bairro").value = dados.bairro || "";
            document.getElementById("cidade").value = dados.localidade || "";
            document.getElementById("estado").value = dados.uf || "";
            ["rua", "bairro", "cidade", "estado"].forEach(function(id) {
              limparErroVisualCampo(document.getElementById(id));
            });
          } else {
            mostrarStatus("CEP n\u00e3o encontrado.", "error");
          }
        })
        .catch(function() {
          mostrarStatus("Erro ao buscar CEP.", "error");
        });
    }

    function registrarLimpezaStatusAoEditar() {
      document.querySelectorAll("input, select, textarea").forEach(function(campo) {
        campo.addEventListener("input", function() {
          marcarAlteracaoPendenteNavegacao();
          limparStatusOperacao();
        });
        campo.addEventListener("change", function() {
          marcarAlteracaoPendenteNavegacao();
          limparStatusOperacao();
        });
      });
    }

    function limparStatusOperacao() {
      mostrarStatus("", "");
      definirStatusSalvar(false, "");
    }

    function bloquearTela() {
      document.querySelectorAll("input, select, textarea, button").forEach(function(campo) {
        campo.disabled = true;
      });
    }

    function mostrarCarregamentoNavegacao(texto) {
      const overlay = document.getElementById("navegacaoOverlay");
      const mensagem = document.getElementById("navegacaoMensagem");

      if (mensagem) mensagem.innerText = texto || "Carregando...";
      if (overlay) overlay.style.display = "flex";
    }

    function definirStatusSalvar(salvando, texto, tipo) {
      const el = document.getElementById("statusSalvarPPMS");
      const botao = document.getElementById("btnSalvarPPMS");

      if (botao) botao.disabled = salvando;
      if (!el) return;

      el.className = "saving-inline" + (tipo ? " " + tipo : "");
      el.innerHTML = salvando
        ? '<span class="saving-spinner"></span><span>' + escaparHtml(texto || "Salvando...") + '</span>'
        : escaparHtml(texto || "");
    }

    function valorCampo(id) {
      const campo = document.getElementById(id);
      return campo ? campo.value.trim() : "";
    }

    function valorDataCampo(id) {
      const campo = document.getElementById(id);
      return campo ? converterDataBrasilParaISO(campo.value) : "";
    }

    function converterMaiusculasSemAcento(campo) {
      campo.value = String(campo.value || "")
        .toUpperCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");
    }

    function chaveComparacaoOPM(valor) {
      return String(valor || "")
        .toUpperCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^A-Z0-9]/g, "");
    }

    function obterOpcoesOPM() {
      const lista = document.getElementById("listaOPM");

      if (!lista) return [];

      return Array.from(lista.options)
        .map(function(opcao) {
          return String(opcao.value || "").trim();
        })
        .filter(Boolean);
    }

    function padronizarCampoOPM(campo) {
      const valor = campo ? String(campo.value || "").trim() : "";

      if (!campo || !valor) return true;

      const chave = chaveComparacaoOPM(valor);
      const encontrado = obterOpcoesOPM().find(function(opcao) {
        return chaveComparacaoOPM(opcao) === chave;
      });

      if (encontrado) {
        campo.value = encontrado;
        limparErroVisualCampo(campo);
        return true;
      }

      return false;
    }

    function mascaraCEP(campo) {
      let valor = campo.value.replace(/\D/g, "").substring(0, 8);
      valor = valor.replace(/(\d{5})(\d)/, "$1-$2");
      campo.value = valor;
    }

    function mascaraDataBrasil(campo) {
      let valor = campo.value.replace(/\D/g, "").substring(0, 8);

      valor = valor.replace(/(\d{2})(\d)/, "$1/$2");
      valor = valor.replace(/(\d{2})(\d)/, "$1/$2");

      campo.value = valor;
    }

    function validarAnoDataCampo(campo) {
      if (!campo.value) {
        limparErroVisualCampo(campo);
        return true;
      }

      if (dataBrasilValida(campo.value)) {
        limparErroVisualCampo(campo);
        return true;
      }

      campo.style.border = "2px solid #d32f2f";
      return false;
    }

    function validarDatasFormulario(ids, obrigatorios) {
      const obrigatoriosMapa = {};
      let valido = true;

      (obrigatorios || []).forEach(function(id) {
        obrigatoriosMapa[id] = true;
      });

      ids.forEach(function(id) {
        const campo = document.getElementById(id);
        if (!campo) return;

        if (obrigatoriosMapa[id] && !campo.value.trim()) {
          campo.style.border = "2px solid #d32f2f";
          valido = false;
          return;
        }

        if (!validarAnoDataCampo(campo)) {
          valido = false;
        }
      });

      return valido;
    }

    function dataBrasilValida(valor) {
      const partes = String(valor || "").trim().match(/^(\d{2})\/(\d{2})\/(\d{4})$/);

      if (!partes) return false;

      const dia = Number(partes[1]);
      const mes = Number(partes[2]);
      const ano = Number(partes[3]);

      if (ano < 1 || ano > 9999 || mes < 1 || mes > 12 || dia < 1) return false;

      const data = new Date(ano, mes - 1, dia);

      return data.getFullYear() === ano &&
        data.getMonth() === mes - 1 &&
        data.getDate() === dia;
    }

    function converterDataBrasilParaISO(valor) {
      const partes = String(valor || "").trim().match(/^(\d{2})\/(\d{2})\/(\d{4})$/);

      if (!partes) return "";

      return partes[3] + "-" + partes[2] + "-" + partes[1];
    }

    function ajustarNumeroFilhos(campo) {
      let valor = Number(campo.value);

      if (campo.value === "") return;
      if (valor < 0) valor = 0;
      if (valor > 10) valor = 10;

      campo.value = valor;
    }

    function limparErroVisualCampo(campo) {
      if (!campo) return;
      campo.style.border = "1px solid var(--line)";
    }

    function marcarCampoObrigatorio(campo) {
      if (!campo) return;
      campo.style.border = "2px solid #d32f2f";
    }

    function mostrarStatus(mensagem, tipo) {
      const el = document.getElementById("statusTela");
      el.className = "status-line" + (tipo ? " " + tipo : "");
      el.innerText = mensagem || "";
    }

    function formatarDataBrasil(data) {
      const dia = String(data.getDate()).padStart(2, "0");
      const mes = String(data.getMonth() + 1).padStart(2, "0");
      const ano = data.getFullYear();

      return dia + "/" + mes + "/" + ano;
    }

    function formatarResponsavelSistema(texto) {
      const original = String(texto || "").trim();
      const conectivos = {
        "da": true,
        "de": true,
        "do": true,
        "das": true,
        "dos": true,
        "e": true
      };

      if (!original) return "";
      if (original.indexOf("@") >= 0) return original.toLowerCase();

      return original
        .toLowerCase()
        .split(/\s+/)
        .map(function(parte, indice) {
          const limpa = parte.normalize("NFD").replace(/[\u0300-\u036f]/g, "");

          if (limpa === "pm") return "PM";
          if (indice > 0 && conectivos[limpa]) return limpa;
          if (/^\d/.test(parte)) return parte.replace(/[a-zA-Z]+/g, function(trecho) {
            return trecho.charAt(0).toUpperCase() + trecho.slice(1);
          });

          return parte.charAt(0).toUpperCase() + parte.slice(1);
        })
        .join(" ");
    }

    function normalizarTexto(valor) {
      return String(valor || "")
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .trim();
    }

    function obterMensagemErro(erro) {
      return erro && erro.message ? erro.message : "Nao foi possivel concluir a operacao.";
    }

    function escaparHtml(valor) {
      return String(valor === null || valor === undefined ? "" : valor)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }
  </script>
