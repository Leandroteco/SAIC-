        usuarioLogado &&
        usuarioLogado.autorizado &&
        usuarioLogado.perfil === "administrador";

      document.getElementById("telaLogin").style.display = administrador ? "none" : "block";
      document.getElementById("conteudoSistema").style.display = administrador ? "block" : "none";
    });
  </script>

  <script>
    // Estado do mapa: camadas, tema, filtros e renderizacao da leitura gerencial.
    let mapaCalorLeaflet = null;
    let camadaNaps = null;
    let camadaPontos = null;
    let temaMapaEscuro = false;
    let mapaCalorAtual = null;

    document.addEventListener("DOMContentLoaded", function() {
      const administrador = tokenGoogle &&
        usuarioLogado &&
        usuarioLogado.autorizado &&
        usuarioLogado.perfil === "administrador";

      if (!administrador) return;

      preencherMesAtualMapa();
      carregarTemaMapaSalvo();
      inicializarMapaCalor();
      carregarMapaCalor();
    });

    function carregarTemaMapaSalvo() {
      try {
        temaMapaEscuro = localStorage.getItem("saicMapaCalorTema") === "escuro";
      } catch (erro) {
        temaMapaEscuro = false;
      }

      aplicarTemaMapa();
    }

    function alternarTemaMapa() {
      temaMapaEscuro = !temaMapaEscuro;

      try {
        localStorage.setItem("saicMapaCalorTema", temaMapaEscuro ? "escuro" : "claro");
      } catch (erro) {}

      aplicarTemaMapa();

      if (mapaCalorAtual) {
        renderizarCamadasMapa(mapaCalorAtual);
      }

      if (mapaCalorLeaflet) {
        setTimeout(function() {
          mapaCalorLeaflet.invalidateSize();
        }, 50);
      }
    }

    function aplicarTemaMapa() {
      document.body.classList.toggle("mapa-tema-escuro", temaMapaEscuro);

      const botao = document.getElementById("btnTemaMapa");
      const legendaTexto = document.getElementById("legendaDemandaMapa");
      const legendaIcone = document.getElementById("legendaDemandaIcone");
      const legendaNapsIcone = document.getElementById("legendaNapsIcone");

      if (botao) {
        botao.innerText = temaMapaEscuro ? "Modo claro" : "Modo escuro";
        botao.setAttribute("aria-pressed", temaMapaEscuro ? "true" : "false");
      }

      if (legendaTexto) {
        legendaTexto.innerText = temaMapaEscuro ? "Calor por pessoas" : "CEP dos cadastrados";
      }

      if (legendaIcone) {
        legendaIcone.style.background = temaMapaEscuro
          ? "linear-gradient(90deg, #f59e0b, #f97316, #dc2626)"
          : "#c62828";
      }

      if (legendaNapsIcone) {
        legendaNapsIcone.style.background = temaMapaEscuro ? "#38bdf8" : "#2f6f89";
      }
    }

    function preencherMesAtualMapa() {
      const hoje = new Date();
      const inicio = new Date(hoje.getFullYear(), hoje.getMonth(), 1);
      const fim = new Date(hoje.getFullYear(), hoje.getMonth() + 1, 0);

      document.getElementById("dataInicial").value = formatarDataInputMapa(inicio);
      document.getElementById("dataFinal").value = formatarDataInputMapa(fim);
    }

    function formatarDataInputMapa(data) {
      const ano = data.getFullYear();
      const mes = String(data.getMonth() + 1).padStart(2, "0");
      const dia = String(data.getDate()).padStart(2, "0");

      return ano + "-" + mes + "-" + dia;
    }

    function coletarFiltrosMapa() {
      const campoMinimo = document.getElementById("minAtendimentosRegiao");
      const campoDistancia = document.getElementById("distanciaAlertaKm");

      return {
        dataInicial: document.getElementById("dataInicial").value,
        dataFinal: document.getElementById("dataFinal").value,
        minAtendimentosRegiao: campoMinimo ? Number(campoMinimo.value || 3) : 3,
        distanciaAlertaKm: campoDistancia ? Number(campoDistancia.value || 20) : 20
      };
    }

    function inicializarMapaCalor() {
      const elementoMapa = document.getElementById("mapaCalor");

      if (!window.L) {
        elementoMapa.innerHTML = '<div class="map-fallback">Nao foi possivel carregar o mapa interativo. Verifique a conexao para carregar a biblioteca de mapas.</div>';
        return;
      }

      const limitesSaoPaulo = L.latLngBounds(
        L.latLng(-25.35, -53.20),
        L.latLng(-19.70, -44.00)
      );

      mapaCalorLeaflet = L.map("mapaCalor", {
        maxBounds: limitesSaoPaulo,
        maxBoundsViscosity: 1,
        minZoom: 6,
        zoomControl: true,
        preferCanvas: true
      }).setView([-22.25, -48.55], 7);

      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 18,
        attribution: "&copy; OpenStreetMap"
      }).addTo(mapaCalorLeaflet);

      L.control.scale({ metric: true, imperial: false }).addTo(mapaCalorLeaflet);
    }

    function mostrarCarregamentoNavegacao(texto) {
      const overlay = document.getElementById("navegacaoOverlay");
      const mensagem = document.getElementById("navegacaoMensagem");

      if (mensagem) mensagem.innerText = texto || "Carregando...";
      if (overlay) overlay.style.display = "flex";
    }

    function ocultarCarregamentoNavegacao() {
      const overlay = document.getElementById("navegacaoOverlay");

      if (overlay) overlay.style.display = "none";
    }

    function carregarMapaCalor() {
      const botao = document.getElementById("btnAtualizarMapa");
      const status = document.getElementById("statusMapa");

      botao.disabled = true;
      mostrarCarregamentoNavegacao("Carregando mapa de calor...");
      status.className = "status-line";
      status.innerText = "Carregando mapa de calor...";

      if (!window.google || !google.script || !google.script.run) {
        botao.disabled = false;
        ocultarCarregamentoNavegacao();
        status.className = "status-line error";
        status.innerText = "Abra esta pagina pelo Apps Script para carregar os dados reais.";
        return;
      }

      google.script.run
        .withSuccessHandler(function(resposta) {
          botao.disabled = false;
          ocultarCarregamentoNavegacao();
          renderizarMapaCalor(resposta || {});
        })
        .withFailureHandler(function(erro) {
          botao.disabled = false;
          ocultarCarregamentoNavegacao();
          status.className = "status-line error";
          status.innerText = "Erro ao carregar mapa de calor: " + (erro && erro.message ? erro.message : erro);
        })
        .obterDadosMapaCalor(coletarFiltrosMapa(), tokenGoogle);
    }

    function renderizarMapaCalor(dados) {
      const resumo = dados.resumo || {};
      const mapa = dados.mapa || {};

      mapaCalorAtual = mapa;
      atualizarMetricasMapa(resumo, mapa);
      atualizarLeituraGerencial(mapa.bairros || mapa.calor || [], mapa.residencias || []);
      renderizarCamadasMapa(mapa);

      const status = document.getElementById("statusMapa");
      status.className = "status-line";
      status.innerText = "Mapa atualizado. Periodo: " + ((dados.periodo && dados.periodo.rotulo) || "periodo informado") + ".";
    }

    function atualizarMetricasMapa(resumo, mapa) {
      document.getElementById("metricAtendimentos").innerText = formatarInteiroMapa(resumo.totalAtendimentos);
      document.getElementById("metricFaltas").innerText = formatarInteiroMapa(resumo.totalFaltas);
      document.getElementById("metricPessoas").innerText = formatarInteiroMapa(resumo.pessoasDistintas);
      document.getElementById("metricNaps").innerText = formatarInteiroMapa(
        resumo.totalNaps !== undefined ? resumo.totalNaps : ((mapa.naps || []).length)
      );
      document.getElementById("metricRegioes").innerText = formatarInteiroMapa(resumo.regioesMapeadas);
      document.getElementById("metricDistancia").innerText = formatarKmMapa(
        resumo.maiorDistanciaNapsKm !== undefined ? resumo.maiorDistanciaNapsKm : resumo.distanciaMediaAtualKm
      );
    }

    function atualizarLeituraGerencial(bairros, residencias) {
      const alvo = document.getElementById("leituraGerencial");
      const listaBairros = Array.isArray(bairros) ? bairros : [];
      const residenciaMaisDistante = obterResidenciaMaisDistanteMapa(residencias);

      if (listaBairros.length === 0 && !residenciaMaisDistante) {
        alvo.innerHTML = '<div class="ranking-meta">Nenhum bairro localizado no periodo.</div>';
        return;
      }

      const blocos = [];

      if (residenciaMaisDistante) {
        const cep = residenciaMaisDistante.cep || "não informado";
        const bairro = residenciaMaisDistante.bairro || "não informado";
        const cidadeEstado = [residenciaMaisDistante.cidade, residenciaMaisDistante.estado]
          .filter(function(item) { return String(item || "").trim(); })
          .join(" / ");
        const detalhes = [];

        if (cidadeEstado) detalhes.push("Cidade/UF: " + cidadeEstado);
        detalhes.push("NAPS mais próximo: " + (residenciaMaisDistante.napsMaisProximo || "não informado"));

        blocos.push(
          '<div class="bairro-item residencia-distante">' +
            '<div>' +
              '<div class="residencia-distante-label">Residência mais distante dos NAPS</div>' +
              '<div class="bairro-nome">CEP ' + escaparHtmlMapa(cep) + ' · Bairro: ' + escaparHtmlMapa(bairro) + '</div>' +
              '<div class="bairro-detalhe">' + escaparHtmlMapa(detalhes.join(" · ")) + '</div>' +
            '</div>' +
            '<div class="bairro-total">' + formatarKmMapa(residenciaMaisDistante.distanciaNapsMaisProximoKm) +
              '<small>até o NAPS mais próximo</small>' +
            '</div>' +
          '</div>'
        );
      }

      const cincoMaisAtendidos = listaBairros.slice().sort(function(a, b) {
        return Number(b.atendimentos || 0) - Number(a.atendimentos || 0);
      }).slice(0, 5);

      if (cincoMaisAtendidos.length > 0) {
        blocos.push('<div class="ranking-meta">Cinco bairros com mais atendimentos</div>');
      }

      blocos.push(cincoMaisAtendidos.map(function(item, indice) {
        const nomeBairro = item.bairro || item.regiao || "Bairro nao informado";
        const distancia = item.distanciaNapsMaisProximoKm !== undefined
          ? item.distanciaNapsMaisProximoKm
          : item.distanciaAtualMediaKm;
        const nomeNapsMaisProximo = item.napsMaisProximo || "NAPS mais próximo";

        return '<div class="bairro-item">' +
          '<span class="bairro-posicao">' + (indice + 1) + '</span>' +
          '<div>' +
            '<div class="bairro-nome">' + escaparHtmlMapa(nomeBairro) + '</div>' +
            '<div class="bairro-detalhe">' + formatarKmMapa(distancia) + ' de distância do ' + escaparHtmlMapa(nomeNapsMaisProximo) + '</div>' +
          '</div>' +
          '<div class="bairro-total">' +
            formatarInteiroMapa(item.atendimentos) + '<small> atendimento(s)</small>' +
            '<br>' + formatarInteiroMapa(item.pessoasDistintas) + '<small> pessoa(s)</small>' +
          '</div>' +
        '</div>';
      }).join(""));

      alvo.innerHTML = blocos.join("");
    }

    function obterResidenciaMaisDistanteMapa(residencias) {
      const lista = Array.isArray(residencias) ? residencias : [];

      return lista.filter(function(item) {
        const distancia = Number(item && item.distanciaNapsMaisProximoKm);

        return item &&
          String(item.napsMaisProximo || "").trim() &&
          !isNaN(distancia);
      }).sort(function(a, b) {
        const diferenca = Number(b.distanciaNapsMaisProximoKm || 0) - Number(a.distanciaNapsMaisProximoKm || 0);

        if (diferenca !== 0) return diferenca;
        return String(a.cep || "").localeCompare(String(b.cep || ""), "pt-BR");
      })[0] || null;
    }

    function renderizarCamadasMapa(mapa) {
      if (!mapaCalorLeaflet || !window.L) return;

      limparCamadasMapa();

      const calor = mapa.calor || [];
      const residencias = mapa.residencias || calor;
      const naps = mapa.naps || [];
      const limites = [];
      const maxPessoasResidencia = residencias.reduce(function(maximo, item) {
        return Math.max(maximo, Number(item.pessoasDistintas || 0));
      }, 1);

      camadaPontos = L.layerGroup().addTo(mapaCalorLeaflet);
      residencias.forEach(function(item) {
        if (!item.latitude || !item.longitude) return;

        if (temaMapaEscuro) {
          const intensidade = calcularIntensidadeCalorMapa(item, maxPessoasResidencia);
          const corCalor = obterCorCalorMapa(intensidade);

          L.circleMarker([item.latitude, item.longitude], {
            radius: calcularRaioCalorMapa(item, maxPessoasResidencia),
            color: corCalor,
            opacity: 0.58,
            weight: 1,
            fillColor: corCalor,
            fillOpacity: Math.min(0.62, 0.26 + intensidade * 0.38)
          }).bindPopup(popupResidenciaMapa(item)).addTo(camadaPontos);
        } else {
          L.circleMarker([item.latitude, item.longitude], {
            radius: Math.max(5, Math.min(9, 4 + Number(item.pessoasDistintas || 1) / 8)),
            color: "#ffffff",
            weight: 2,
            fillColor: "#c62828",
            fillOpacity: 0.92
          }).bindPopup(popupResidenciaMapa(item)).addTo(camadaPontos);
        }

        limites.push([item.latitude, item.longitude]);
      });

      calor.forEach(function(item) {
        limites.push([item.latitude, item.longitude]);
      });

      camadaNaps = L.layerGroup().addTo(mapaCalorLeaflet);
      naps.forEach(function(item) {
        if (!item.latitude || !item.longitude) return;

        L.circleMarker([item.latitude, item.longitude], {
          radius: temaMapaEscuro ? 9 : 8,
          color: temaMapaEscuro ? "#dbeafe" : "#ffffff",
          weight: 2,
          fillColor: temaMapaEscuro ? "#38bdf8" : "#2f6f89",
          fillOpacity: temaMapaEscuro ? 0.98 : 0.95
        }).bindPopup(popupNapsMapa(item)).addTo(camadaNaps);
        limites.push([item.latitude, item.longitude]);
      });

      if (limites.length > 0) {
        mapaCalorLeaflet.fitBounds(limites, { padding: [28, 28], maxZoom: 11 });
      } else {
        mapaCalorLeaflet.setView([-22.25, -48.55], 7);
      }
    }

    function calcularIntensidadeCalorMapa(item, maxPessoas) {
      const pessoas = Math.max(1, Number(item.pessoasDistintas || 1));
      const maximo = Math.max(1, Number(maxPessoas || 1));

      return Math.max(0.12, Math.min(1, pessoas / maximo));
    }

    function calcularRaioCalorMapa(item, maxPessoas) {
      const intensidade = calcularIntensidadeCalorMapa(item, maxPessoas);

      return Math.round(14 + Math.sqrt(intensidade) * 30);
    }

    function obterCorCalorMapa(intensidade) {
      if (intensidade >= 0.68) return "#dc2626";
      if (intensidade >= 0.36) return "#f97316";
      return "#f59e0b";
    }

    function limparCamadasMapa() {
      [camadaNaps, camadaPontos].forEach(function(camada) {
        if (camada && mapaCalorLeaflet) {
          mapaCalorLeaflet.removeLayer(camada);
        }
      });

      camadaNaps = null;
      camadaPontos = null;
    }

    function popupRegiaoMapa(item) {
      const nomeNapsMaisProximo = item.napsMaisProximo || "NAPS mais próximo";

      return '<strong>' + escaparHtmlMapa(item.bairro || item.regiao || "Bairro") + '</strong><br>' +
        '<span class="map-popup-metric">Atendimentos: ' + formatarInteiroMapa(item.atendimentos) + '</span><br>' +
        '<span class="map-popup-metric">Pessoas: ' + formatarInteiroMapa(item.pessoasDistintas) + '</span><br>' +
        'Distância do ' + escaparHtmlMapa(nomeNapsMaisProximo) + ': ' + formatarKmMapa(
          item.distanciaNapsMaisProximoKm !== undefined
            ? item.distanciaNapsMaisProximoKm
            : item.distanciaAtualMediaKm
        );
    }

    function popupResidenciaMapa(item) {
      const nomeNapsMaisProximo = item.napsMaisProximo || "NAPS mais próximo";

      return '<strong>CEP ' + escaparHtmlMapa(item.cep || item.regiao || "nao informado") + '</strong><br>' +
        (item.bairro ? escaparHtmlMapa(item.bairro) + '<br>' : '') +
        '<span class="map-popup-metric">Atendimentos: ' + formatarInteiroMapa(item.atendimentos) + '</span><br>' +
        '<span class="map-popup-metric">Pessoas: ' + formatarInteiroMapa(item.pessoasDistintas) + '</span><br>' +
        'Distância do ' + escaparHtmlMapa(nomeNapsMaisProximo) + ': ' + formatarKmMapa(
          item.distanciaNapsMaisProximoKm !== undefined
            ? item.distanciaNapsMaisProximoKm
            : item.distanciaAtualMediaKm
        );
    }

    function popupNapsMapa(item) {
      return '<strong>' + escaparHtmlMapa(item.naps || "NAPS") + '</strong><br>' +
        '<span class="map-popup-metric">Atendimentos: ' + formatarInteiroMapa(item.atendimentos) + '</span><br>' +
        '<span class="map-popup-metric">Pessoas: ' + formatarInteiroMapa(item.pessoasDistintas) + '</span><br>' +
        'Distancia media: ' + formatarKmMapa(item.distanciaMediaKm);
    }

    function formatarInteiroMapa(valor) {
      return Number(valor || 0).toLocaleString("pt-BR", { maximumFractionDigits: 0 });
    }

    function formatarKmMapa(valor) {
      return Number(valor || 0).toLocaleString("pt-BR", {
        minimumFractionDigits: 0,
        maximumFractionDigits: 1
      }) + " km";
    }

    function escaparHtmlMapa(valor) {
      return String(valor === null || valor === undefined ? "" : valor)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }
  </script>
</body>
</html>


