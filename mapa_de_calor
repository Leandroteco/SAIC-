<!DOCTYPE html>
<!--
  SAIC - Mapa de calor
  Arquivo organizado para manutencao visual e funcional no Apps Script.
  Mantem filtros, mapa, pontos, modo escuro e chamadas ao codigo.gs.
-->
<html>
<head>
  <meta charset="UTF-8">
  <base target="_top">
  <script src="https://accounts.google.com/gsi/client" async defer></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <style>
    /*
      CSS principal
      - Variaveis visuais
      - Layout institucional
      - Cards de leitura gerencial
      - Mapa Leaflet, pontos e modo escuro
      - Responsividade
    */
    :root {
      --bg: #f4f8fb;
      --surface: #ffffff;
      --surface-soft: #f8fbfd;
      --line: #d8e2ea;
      --line-soft: #edf3f7;
      --text: #334155;
      --muted: #64748b;
      --primary: #3b82a0;
      --primary-dark: #2f6f89;
      --primary-soft: #7fb6cc;
      --sidebar: #6f97ad;
      --sidebar-soft: #7fb6cc;
      --success: #6ca88d;
      --warning: #a16207;
      --danger: #b42318;
      --shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
    }

    * {
      box-sizing: border-box;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: "Segoe UI", Arial, sans-serif;
      margin: 0;
      min-height: 100vh;
    }

    .login-box {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 8px;
      box-shadow: var(--shadow);
      margin: 60px auto;
      max-width: 480px;
      padding: 28px;
      text-align: center;
    }

    .login-box h2 {
      color: var(--primary);
      margin: 0 0 10px;
    }

    .login-box p {
      color: var(--muted);
      margin: 0 0 18px;
    }

    #conteudoSistema {
      min-height: 100vh;
    }

    .app-shell {
      display: grid;
      grid-template-columns: 248px minmax(0, 1fr);
      min-height: 100vh;
    }

    .sidebar {
      background: linear-gradient(180deg, var(--sidebar) 0%, var(--sidebar-soft) 100%);
      color: #ffffff;
      display: flex;
      flex-direction: column;
      gap: 28px;
      min-height: 100vh;
      padding: 26px 20px;
      position: sticky;
      top: 0;
    }

    .brand {
      align-items: center;
      display: flex;
      gap: 12px;
      min-width: 0;
    }

    .brand-mark {
      align-items: center;
      background: rgba(255, 255, 255, 0.14);
      border: 1px solid rgba(255, 255, 255, 0.26);
      border-radius: 8px;
      display: flex;
      font-size: 20px;
      font-weight: 900;
      height: 46px;
      justify-content: center;
      width: 46px;
    }

    .brand-title {
      display: block;
      font-size: 18px;
      font-weight: 900;
      line-height: 1.1;
    }

    .brand-subtitle {
      color: rgba(255, 255, 255, 0.72);
      display: block;
      font-size: 12px;
      font-weight: 700;
      margin-top: 4px;
    }

    .side-nav {
      display: grid;
      gap: 8px;
    }

    .nav-item {
      align-items: center;
      background: rgba(255, 255, 255, 0.16);
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 8px;
      color: #ffffff;
      display: flex;
      font-size: 14px;
      font-weight: 800;
      gap: 10px;
      padding: 12px 14px;
    }

    .nav-dot {
      background: #ffffff;
      border-radius: 999px;
      height: 8px;
      opacity: 0.9;
      width: 8px;
    }

    .sidebar-footer {
      border-top: 1px solid rgba(255, 255, 255, 0.22);
      color: rgba(255, 255, 255, 0.74);
      display: grid;
      gap: 4px;
      margin-top: auto;
      padding-top: 18px;
    }

    .sidebar-footer strong {
      color: #ffffff;
      font-size: 14px;
    }

    .page-content {
      min-width: 0;
      padding: 28px;
    }

    .topbar {
      align-items: center;
      display: flex;
      justify-content: space-between;
      gap: 18px;
      margin: 0 auto 22px;
      max-width: 1180px;
    }

    .topbar h1 {
      color: var(--text);
      font-size: 28px;
      margin: 0 0 6px;
    }

    .subtitle {
      color: var(--muted);
      font-size: 14px;
      font-weight: 700;
      margin: 0;
    }

    main {
      display: grid;
      gap: 18px;
      margin: 0 auto;
      max-width: 1180px;
    }

    .panel {
      background: var(--surface);
      border: 1px solid var(--line-soft);
      border-radius: 8px;
      box-shadow: var(--shadow);
      padding: 22px;
    }

    .section-title {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 18px;
    }

    .section-title h2 {
      color: var(--text);
      font-size: 18px;
      margin: 0;
    }

    .section-title span {
      color: var(--muted);
      font-size: 13px;
      font-weight: 800;
    }

    .hero-grid {
      display: grid;
      gap: 18px;
      grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
    }

    .map-card {
      background:
        linear-gradient(90deg, rgba(216, 226, 234, 0.58) 1px, transparent 1px),
        linear-gradient(0deg, rgba(216, 226, 234, 0.58) 1px, transparent 1px),
        var(--surface-soft);
      background-size: 34px 34px;
      border: 1px solid var(--line);
      border-radius: 8px;
      min-height: 420px;
      overflow: hidden;
      position: relative;
    }

    .map-card::before {
      background: rgba(59, 130, 160, 0.09);
      border: 1px solid rgba(59, 130, 160, 0.2);
      border-radius: 44% 56% 45% 55%;
      content: "";
      height: 58%;
      left: 20%;
      position: absolute;
      top: 18%;
      transform: rotate(-8deg);
      width: 54%;
    }

    .heat-point {
      border-radius: 999px;
      filter: blur(1px);
      position: absolute;
      transform: translate(-50%, -50%);
    }

    .heat-point.high {
      background: rgba(180, 35, 24, 0.48);
      box-shadow: 0 0 38px 18px rgba(180, 35, 24, 0.24);
      height: 96px;
      width: 96px;
    }

    .heat-point.medium {
      background: rgba(161, 98, 7, 0.42);
      box-shadow: 0 0 32px 14px rgba(161, 98, 7, 0.20);
      height: 78px;
      width: 78px;
    }

    .heat-point.low {
      background: rgba(108, 168, 141, 0.44);
      box-shadow: 0 0 28px 12px rgba(108, 168, 141, 0.18);
      height: 62px;
      width: 62px;
    }

    .map-label {
      background: rgba(255, 255, 255, 0.88);
      border: 1px solid var(--line);
      border-radius: 8px;
      box-shadow: 0 12px 28px rgba(15, 23, 42, 0.10);
      color: var(--text);
      font-size: 13px;
      font-weight: 900;
      left: 22px;
      padding: 10px 12px;
      position: absolute;
      top: 22px;
    }

    .status-card {
      background: var(--surface-soft);
      border: 1px solid var(--line);
      border-radius: 8px;
      display: grid;
      gap: 16px;
      padding: 18px;
    }

    .status-card h3 {
      color: var(--primary-dark);
      font-size: 16px;
      margin: 0;
    }

    .status-card p {
      color: var(--muted);
      font-size: 14px;
      line-height: 1.55;
      margin: 0;
    }

    .metric-list {
      display: grid;
      gap: 10px;
    }

    .metric-item {
      align-items: center;
      background: #ffffff;
      border: 1px solid var(--line-soft);
      border-radius: 8px;
      display: flex;
      justify-content: space-between;
      gap: 14px;
      padding: 13px 14px;
    }

    .metric-item span {
      color: var(--muted);
      font-size: 13px;
      font-weight: 800;
    }

    .metric-item strong {
      color: var(--text);
      font-size: 14px;
    }

    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 16px;
    }

    .legend span {
      align-items: center;
      color: var(--muted);
      display: inline-flex;
      font-size: 12px;
      font-weight: 800;
      gap: 6px;
    }

    .legend i {
      border-radius: 999px;
      display: inline-block;
      height: 10px;
      width: 10px;
    }

    @media (max-width: 920px) {
      .app-shell {
        grid-template-columns: 1fr;
      }

      .sidebar {
        min-height: auto;
        position: relative;
      }

      .hero-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .page-content {
        padding: 18px 14px;
      }

      .topbar {
        align-items: flex-start;
        flex-direction: column;
      }

      .section-title {
        flex-direction: column;
      }

      .map-card {
        min-height: 320px;
      }
    }
  /* Design institucional alinhado ao Index aprovado */
:root {
  --bg: #f4f8fb;
  --surface: #ffffff;
  --surface-soft: #f8fbfd;
  --line: #d8e2ea;
  --line-soft: #edf3f7;
  --text: #334155;
  --muted: #64748b;
  --primary: #df0209;
  --primary-dark: #a90008;
  --primary-soft: #f4d6d7;
  --sidebar: #3f4141;
  --sidebar-soft: #2e3030;
  --success: #0f766e;
  --success-dark: #115e59;
  --shadow: 0 20px 46px rgba(41, 48, 51, 0.10);
}

body {
  background: linear-gradient(180deg, #f4f8fb 0%, #eaf2f6 100%);
}

.app-shell {
  background: transparent;
}

.sidebar {
  background: linear-gradient(180deg, #5f6668 0%, #50575a 52%, #454b4e 100%);
  border-right: 3px solid #df0209;
  box-shadow: 12px 0 28px rgba(41, 48, 51, 0.10);
}

.brand-mark.preview-brand-logo {
  background: #ffffff;
  border: 3px solid #df0209;
  border-radius: 999px;
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.22);
  height: 66px;
  overflow: hidden;
  padding: 0;
  width: 66px;
}

.brand-mark.preview-brand-logo img {
  display: block;
  height: 100%;
  object-fit: cover;
  object-position: center;
  width: 100%;
}

.brand-title {
  color: #ffffff;
  letter-spacing: 0;
}

.brand-title strong,
.brand-title span {
  display: block;
}

.brand-title span {
  color: rgba(255, 255, 255, 0.72);
  font-size: 12px;
  font-weight: 700;
  margin-top: 4px;
}

.brand-subtitle {
  color: rgba(255, 255, 255, 0.72);
}

.side-nav a.active,
.side-nav .nav-item.active,
.side-nav .nav-item {
  background: rgba(255, 255, 255, 0.12);
  box-shadow: none;
}

.nav-dot {
  background: #ffffff;
}

.sidebar-footer {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.16);
}

.reports-content,
.dashboard-content,
.page-content {
  background:
    radial-gradient(circle at 88% 0%, rgba(127, 182, 204, 0.18), rgba(127, 182, 204, 0) 30%),
    #f4f8fb;
}

.topbar.preview-institutional-header {
  align-items: center;
  background:
    radial-gradient(circle at 50% 18%, rgba(255,255,255,0.96), rgba(255,255,255,0) 50%),
    linear-gradient(180deg, #ffffff 0%, #f3f4f2 100%);
  border: 1px solid #d9dddc;
  border-radius: 0 0 8px 8px;
  box-shadow: 0 18px 38px rgba(41, 48, 51, 0.10);
  display: grid;
  gap: 24px;
  grid-template-columns: minmax(260px, 1fr) auto;
  margin: 24px 34px 18px;
  min-height: 142px;
  overflow: visible;
  padding: 28px 34px;
  position: relative;
}

.topbar.preview-institutional-header::before,
.topbar.preview-institutional-header::after {
  content: "";
  pointer-events: none;
  position: absolute;
  z-index: 0;
}

.topbar.preview-institutional-header::before {
  background: linear-gradient(90deg, #df0209 0%, #df0209 62%, rgba(223, 2, 9, 0.72) 82%, rgba(223, 2, 9, 0) 100%);
  clip-path: polygon(0 0, 100% 0, 100% 20%, 0 100%);
  height: 11px;
  left: 0;
  top: 0;
  width: 100%;
}

.topbar.preview-institutional-header::after {
  background: linear-gradient(90deg, rgba(63, 65, 65, 0) 0%, rgba(63, 65, 65, 0.72) 20%, #3f4141 42%, #3f4141 100%);
  bottom: 0;
  clip-path: polygon(0 78%, 100% 0, 100% 100%, 0 100%);
  height: 11px;
  left: 0;
  width: 100%;
}

.preview-title-block,
.preview-logo-group,
.topbar.preview-institutional-header .actions {
  position: relative;
  z-index: 1;
}

.preview-title-block {
  border-left: 6px solid #df0209;
  padding-left: 18px;
}

.topbar.preview-institutional-header h1 {
  color: #293033;
  font-size: 32px;
  letter-spacing: 0;
}

.topbar.preview-institutional-header .subtitle,
.topbar.preview-institutional-header span {
  color: #626a6d;
  font-weight: 800;
}

.preview-logo-group {
  align-items: center;
  display: flex;
  gap: 14px;
}

.preview-logo-card {
  align-items: center;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  display: flex;
  height: 78px;
  justify-content: center;
  overflow: visible;
  padding: 0;
  width: 78px;
}

.preview-logo-card.logo-pm {
  width: 104px;
}

.preview-logo-card img {
  display: block;
  filter: contrast(1.08) saturate(1.06);
  height: 100%;
  image-rendering: auto;
  mix-blend-mode: multiply;
  object-fit: contain;
  width: 100%;
}

.preview-logo-card.logo-ssp img,
.preview-logo-card.logo-pm img {
  filter: contrast(1.12) saturate(1.08);
}

main,
.panel,
.filters-panel,
.tab-panel,
.card,
.metric-card,
.status-card,
.chart-card,
.ranking-card,
