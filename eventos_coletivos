    function converterMaiusculasSemAcento(campo) {
      campo.value = String(campo.value || "")
        .toUpperCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");
    }

    function chaveComparacaoOPM(valor) {
      return String(valor || "")
        .toUpperCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^A-Z0-9]/g, "");
    }

    function obterOpcoesOPM() {
      const lista = document.getElementById("listaOPM");

      if (!lista) return [];

      return Array.from(lista.options)
        .map(function(opcao) {
          return String(opcao.value || "").trim();
        })
        .filter(Boolean);
    }

    function padronizarCampoOPM(campo) {
      const valor = campo ? String(campo.value || "").trim() : "";

      if (!campo || !valor) return true;

      const chave = chaveComparacaoOPM(valor);
      const encontrado = obterOpcoesOPM().find(function(opcao) {
        return chaveComparacaoOPM(opcao) === chave;
      });

      if (encontrado) {
        campo.value = encontrado;
        limparErroVisualCampo(campo);
        return true;
      }

      return false;
    }

    function marcarCampoOPMInvalido(campo) {
      if (campo) campo.style.border = "2px solid #d32f2f";
    }

    function sugerirDominioEmail(campo) {
      const lista = document.getElementById("sugestoesEmail");

      if (!lista) return;

      const dominio = "policiamilitar.sp.gov.br";
      const valor = String((campo && campo.value) || "").trim();
      const partes = valor.split("@");

      if (partes.length !== 2 || !partes[0]) {
        lista.innerHTML = "";
        return;
      }

      const usuario = partes[0];
      const dominioDigitado = partes[1].toLowerCase();

      if (dominioDigitado && dominio.indexOf(dominioDigitado) !== 0) {
        lista.innerHTML = "";
        return;
      }

      const sugestao = usuario + "@" + dominio;

      if (valor.toLowerCase() === sugestao.toLowerCase()) {
        lista.innerHTML = "";
        return;
      }

      lista.innerHTML = '<option value="' + escaparAttr(sugestao) + '"></option>';
    }

    function mascaraRE(campo) {
      let valor = campo.value.toUpperCase().replace(/[^0-9A]/g, "");
      let numerosAntesHifen = "";
      let digitoFinal = "";

      for (let i = 0; i < valor.length; i++) {
        const caractere = valor.charAt(i);

        if (numerosAntesHifen.length < 6) {
          if (/[0-9]/.test(caractere)) numerosAntesHifen += caractere;
          continue;
        }

        if (!digitoFinal && /[0-9A]/.test(caractere)) {
          digitoFinal = caractere;
          break;
        }
      }

      campo.value = digitoFinal ? numerosAntesHifen + "-" + digitoFinal : numerosAntesHifen;
    }

    function mascaraCPF(campo) {
      let valor = campo.value.replace(/\D/g, "").substring(0, 11);

      valor = valor.replace(/(\d{3})(\d)/, "$1.$2");
      valor = valor.replace(/(\d{3})(\d)/, "$1.$2");
      valor = valor.replace(/(\d{3})(\d{1,2})$/, "$1-$2");

      campo.value = valor;
    }

    function mascaraTelefone(campo) {
      let valor = campo.value.replace(/\D/g, "").substring(0, 11);

      if (valor.length <= 10) {
        valor = valor.replace(/(\d{2})(\d)/, "($1) $2");
        valor = valor.replace(/(\d{4})(\d)/, "$1-$2");
      } else {
        valor = valor.replace(/(\d{2})(\d)/, "($1) $2");
        valor = valor.replace(/(\d{5})(\d)/, "$1-$2");
      }

      campo.value = valor;
    }

    function mascaraCEP(campo) {
      let valor = campo.value.replace(/\D/g, "").substring(0, 8);

      valor = valor.replace(/(\d{5})(\d)/, "$1-$2");

      campo.value = valor;
    }

    function mascaraDataBrasil(campo) {
      let valor = campo.value.replace(/\D/g, "").substring(0, 8);

      valor = valor.replace(/(\d{2})(\d)/, "$1/$2");
      valor = valor.replace(/(\d{2})(\d)/, "$1/$2");

      campo.value = valor;
    }

    function validarAnoDataCampo(campo) {
      if (!campo.value) {
        limparErroVisualCampo(campo);
        return true;
      }

      if (dataBrasilValida(campo.value)) {
        limparErroVisualCampo(campo);
        return true;
      }

      campo.style.border = "2px solid #d32f2f";
      return false;
    }

    function validarDatasFormulario(ids, obrigatorios) {
      const obrigatoriosMapa = {};
      let valido = true;

      (obrigatorios || []).forEach(function(id) {
        obrigatoriosMapa[id] = true;
      });

      ids.forEach(function(id) {
        const campo = document.getElementById(id);
        if (!campo) return;

        if (obrigatoriosMapa[id] && !campo.value.trim()) {
          campo.style.border = "2px solid #d32f2f";
          valido = false;
          return;
        }

        if (!validarAnoDataCampo(campo)) {
          valido = false;
        }
      });

      if (!valido) {
        mostrarStatus("Confira as datas informadas.", "error");
      }

      return valido;
    }

    function dataBrasilValida(valor) {
      const valorIso = converterDataBrasilParaISO(valor);
      const partes = valorIso.match(/^(\d{4})-(\d{2})-(\d{2})$/);

      if (!partes) return false;

      const ano = Number(partes[1]);
      const mes = Number(partes[2]);
      const dia = Number(partes[3]);

      if (ano < 1 || ano > 9999 || mes < 1 || mes > 12 || dia < 1) return false;

      const data = new Date(ano, mes - 1, dia);

      return data.getFullYear() === ano &&
        data.getMonth() === mes - 1 &&
        data.getDate() === dia;
    }

    function converterDataBrasilParaISO(valor) {
      const texto = String(valor || "").trim();
      const iso = texto.match(/^(\d{4})-(\d{2})-(\d{2})$/);

      if (iso) return iso[1] + "-" + iso[2] + "-" + iso[3];

      const partes = texto.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);

      if (!partes) return "";

      return partes[3] + "-" + partes[2] + "-" + partes[1];
    }

    function formatarDataBrasilInput(data) {
      const dia = String(data.getDate()).padStart(2, "0");
      const mes = String(data.getMonth() + 1).padStart(2, "0");
      const ano = String(data.getFullYear()).padStart(4, "0");

      return ano + "-" + mes + "-" + dia;
    }

    function atualizarCalculosDatasEvento() {
      const hoje = new Date();
      const dataEvento = obterDataCampoEvento("dataEvento");

      preencherTextoEvento(
        "diaEvento",
        dataEvento ? "Dia do evento: " + obterNomeDiaSemanaEvento(dataEvento) : ""
      );
      preencherTextoEvento(
        "idadeCalculada",
        calcularIdadeAnosEvento(obterDataCampoEvento("dataNascimento"), hoje)
      );
      preencherTextoEvento(
        "tempoServico",
        calcularAnosMesesEvento(obterDataCampoEvento("dataIngresso"), hoje, "Tempo de servi\u00e7o")
      );
      preencherTextoEvento(
        "tempoInatividade",
        calcularAnosMesesEvento(obterDataCampoEvento("dataInatividade"), hoje, "Tempo de inatividade")
      );
    }

    function obterDataCampoEvento(id) {
      const valorIso = converterDataBrasilParaISO(valorCampo(id));
      const partes = valorIso.match(/^(\d{4})-(\d{2})-(\d{2})$/);

      if (!partes) return null;

      const ano = Number(partes[1]);
      const mes = Number(partes[2]);
      const dia = Number(partes[3]);
      const data = new Date(ano, mes - 1, dia);

      if (data.getFullYear() !== ano || data.getMonth() !== mes - 1 || data.getDate() !== dia) {
        return null;
      }

      return data;
    }

    function calcularIdadeAnosEvento(data, hoje) {
      if (!data) return "";

      let anos = hoje.getFullYear() - data.getFullYear();
      const aniversarioPassou = hoje.getMonth() > data.getMonth() ||
        (hoje.getMonth() === data.getMonth() && hoje.getDate() >= data.getDate());

      if (!aniversarioPassou) anos--;

      return anos >= 0 ? "Idade: " + anos + " ano" + (anos === 1 ? "" : "s") : "";
    }

    function calcularAnosMesesEvento(data, hoje, rotulo) {
      if (!data) return "";

      let anos = hoje.getFullYear() - data.getFullYear();
      let meses = hoje.getMonth() - data.getMonth();

      if (hoje.getDate() < data.getDate()) meses--;
      if (meses < 0) {
        anos--;
        meses += 12;
      }

      if (anos < 0) return "";

      return rotulo + ": " + anos + " ano" + (anos === 1 ? "" : "s") + " e " +
        meses + " " + (meses === 1 ? "m\u00eas" : "meses");
    }

    function obterNomeDiaSemanaEvento(data) {
      return [
        "domingo",
        "segunda-feira",
        "ter\u00e7a-feira",
        "quarta-feira",
        "quinta-feira",
        "sexta-feira",
        "s\u00e1bado"
      ][data.getDay()];
    }

