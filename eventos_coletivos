    }

    function removerParticipanteManual(indice) {
      participantesManuais.splice(indice, 1);
      renderizarParticipantes();
      atualizarContador();
    }

    function atualizarParticipantesDoLink(silencioso) {
      const modoSilencioso = silencioso === true;
      const chaveEvento = idEventoAtual || tokenEventoAtual;

      if (!chaveEvento) {
        mostrarStatus("Gere o link do evento antes de atualizar os participantes.", "error");
        return;
      }

      if (!modoSilencioso) {
        definirStatusAtualizarParticipantes(true, "Atualizando participantes...");
        setCarregando(true, "Atualizando participantes enviados pelo link...");
      }

      google.script.run
        .withSuccessHandler(function(retorno) {
          if (!modoSilencioso) setCarregando(false);
          idEventoAtual = retorno.idEvento || idEventoAtual;
          tokenEventoAtual = retorno.tokenEvento || tokenEventoAtual;
          participantesLink = retorno.participantes || [];
          renderizarParticipantes();
          atualizarContador();

          if (!modoSilencioso) {
            const total = participantesLink.length;
            definirStatusAtualizarParticipantes(
              false,
              total > 0 ? "Lista atualizada." : "Sem novos envios.",
              total > 0 ? "success" : ""
            );
            mostrarStatus(
              total > 0
                ? "Participantes atualizados: " + total + "."
                : "Nenhum participante enviado pelo link ainda.",
              total > 0 ? "success" : ""
            );
          }
        })
        .withFailureHandler(function(erro) {
          if (!modoSilencioso) setCarregando(false);
          if (!modoSilencioso) {
            definirStatusAtualizarParticipantes(false, obterMensagemErro(erro), "error");
            mostrarStatus(obterMensagemErro(erro), "error");
          }
        })
        .listarParticipantesEvento(chaveEvento, tokenGoogle);
    }

    function salvarEvento() {
      if (!validarDatasFormulario(["dataEvento"], ["dataEvento"])) return;
      if (!validarTemaEvento("Informe o tema antes de salvar.")) return;

      const dadosEvento = montarDadosEvento();

      if (tipoEventoAtual === "palestra" && !dadosEvento.modalidadeEvento) {
        mostrarStatus("Informe a modalidade da palestra.", "error");
        document.getElementById("modalidadeEvento").focus();
        return;
      }

      if (tipoEventoAtual !== "palestra" && participantesManuais.length + participantesLink.length < 1) {
        mostrarStatus("Inclua ao menos um participante ou aguarde os envios pelo link.", "error");
        return;
      }

      definirStatusSalvarEvento(true, "Salvando " + (rotulosEvento[tipoEventoAtual] || "evento") + "...");
      setCarregando(true, "Salvando " + (rotulosEvento[tipoEventoAtual] || "evento") + "...");
      google.script.run
        .withSuccessHandler(function(retorno) {
          setCarregando(false);
          definirStatusSalvarEvento(false, "Salvo com sucesso.", "success");
          resetarEstadoEvento();
          limparIdentificacaoEvento();
          renderizarParticipantes();
          atualizarContador();
          atualizarBotaoCancelarEvento();
          limparAlteracaoPendenteNavegacao();
          mostrarStatus("Pronto para iniciar um grupo ou palestra.", "success", true);
        })
        .withFailureHandler(function(erro) {
          setCarregando(false);
          definirStatusSalvarEvento(false, obterMensagemErro(erro), "error");
          mostrarStatus(obterMensagemErro(erro), "error");
        })
        .salvarEventoColetivo(dadosEvento, participantesManuais, tokenGoogle);
    }

    function renderizarParticipantes() {
      const destino = document.getElementById("listaParticipantes");

      if (tipoEventoAtual === "palestra") {
        destino.innerHTML = "";
        return;
      }

      const linhas = [];
      participantesManuais.forEach(function(item, indice) {
        linhas.push({
          origem: "manual",
          nome: item.nome,
          re: item.re,
          cpf: item.cpf,
          status: "na lista",
          acao: '<button type="button" class="btn-danger" onclick="removerParticipanteManual(' + indice + ')">Remover</button>'
        });
      });

      participantesLink.forEach(function(item) {
        if (String(item.status || "").toLowerCase() === "cancelado") return;

        linhas.push({
          origem: "rascunho",
          nome: item.nome,
          re: item.re,
          cpf: item.cpf,
          status: item.status || "pendente",
          acao: '<button type="button" class="btn-danger" onclick="abrirModalCancelarParticipante(\'' + escaparAttr(item.idParticipante) + '\')">Cancelar</button>'
        });
      });

      if (linhas.length === 0) {
        destino.innerHTML = '<div class="empty-state">Nenhum participante listado ainda.</div>';
        return;
      }

      destino.innerHTML =
        '<table class="mini-table">' +
        '<thead><tr><th>Origem</th><th>Nome</th><th>R.E.</th><th>CPF</th><th>Status</th><th></th></tr></thead>' +
        '<tbody>' +
        linhas.map(function(item) {
          return '<tr>' +
            '<td>' + escaparHtml(item.origem) + '</td>' +
            '<td>' + escaparHtml(item.nome) + '</td>' +
            '<td>' + escaparHtml(item.re) + '</td>' +
            '<td>' + escaparHtml(item.cpf) + '</td>' +
            '<td>' + escaparHtml(item.status) + '</td>' +
            '<td>' + item.acao + '</td>' +
            '</tr>';
        }).join("") +
        '</tbody></table>';
    }

    function atualizarContador() {
      const total = tipoEventoAtual === "palestra"
        ? Number(document.getElementById("quantidadeInformada").value || 0)
        : participantesManuais.length + participantesLink.length;

      document.getElementById("contadorEvento").innerText = total + (total === 1 ? " participante" : " participantes");
    }

    document.getElementById("quantidadeInformada").addEventListener("input", atualizarContador);

    function validarTemaEvento(mensagem) {
      if (valorCampo("tema")) return true;

      mostrarStatus(mensagem || "Informe o tema.", "error");
      document.getElementById("tema").focus();
      return false;
    }

    function setCarregando(carregando, mensagem) {
      document.getElementById("btnGerarLink").disabled = carregando;
      document.getElementById("btnAdicionarParticipanteManual").disabled = carregando;
      document.getElementById("btnAtualizarParticipantes").disabled = carregando;
      document.getElementById("btnSalvarEvento").disabled = carregando;
      document.getElementById("btnCancelarEvento").disabled = carregando;
      document.getElementById("btnConfirmarCancelamentoEvento").disabled = carregando;
      document.getElementById("btnConfirmarCancelamentoParticipante").disabled = carregando;

      if (mensagem) mostrarStatus(mensagem, "");
    }

    function definirStatusSalvarEvento(salvando, texto, tipo) {
      const el = document.getElementById("statusSalvarEvento");

      if (!el) return;

      el.className = "saving-inline" + (tipo ? " " + tipo : "");
      el.innerHTML = salvando
        ? '<span class="saving-spinner"></span><span>' + escaparHtml(texto || "Salvando...") + '</span>'
        : escaparHtml(texto || "");
    }

    function definirStatusGerarLink(gerando, texto, tipo) {
      const el = document.getElementById("statusGerarLink");

      if (!el) return;

      el.className = "saving-inline" + (tipo ? " " + tipo : "");
      el.innerHTML = gerando
        ? '<span class="saving-spinner"></span><span>' + escaparHtml(texto || "Gerando...") + '</span>'
        : escaparHtml(texto || "");
    }

    function definirStatusAdicionarParticipante(adicionando, texto, tipo) {
      const el = document.getElementById("statusAdicionarParticipante");

      if (!el) return;

      el.className = "saving-inline" + (tipo ? " " + tipo : "");
      el.innerHTML = adicionando
        ? '<span class="saving-spinner"></span><span>' + escaparHtml(texto || "Adicionando...") + '</span>'
        : escaparHtml(texto || "");
    }

    function definirStatusAtualizarParticipantes(atualizando, texto, tipo) {
      const el = document.getElementById("statusAtualizarParticipantes");

      if (!el) return;

      el.className = "saving-inline" + (tipo ? " " + tipo : "");
      el.innerHTML = atualizando
        ? '<span class="saving-spinner"></span><span>' + escaparHtml(texto || "Atualizando...") + '</span>'
        : escaparHtml(texto || "");
    }

    function definirStatusCancelarEvento(cancelando, texto, tipo) {
      const el = document.getElementById("statusCancelarEvento");

      if (!el) return;

      el.className = "saving-inline" + (tipo ? " " + tipo : "");
      el.innerHTML = cancelando
        ? '<span class="saving-spinner"></span><span>' + escaparHtml(texto || "Cancelando...") + '</span>'
        : escaparHtml(texto || "");
    }

    function definirStatusCancelarParticipante(cancelando, texto, tipo) {
      const el = document.getElementById("statusCancelarParticipante");

      if (!el) return;

      el.className = "saving-inline" + (tipo ? " " + tipo : "");
      el.innerHTML = cancelando
        ? '<span class="saving-spinner"></span><span>' + escaparHtml(texto || "Cancelando...") + '</span>'
        : escaparHtml(texto || "");
    }

    function mostrarStatus(mensagem, tipo, centralizado) {
      const el = document.getElementById("statusTela");
      el.className = "status-line" + (tipo ? " " + tipo : "") + (centralizado ? " centered" : "");
      el.innerText = mensagem || "";
    }

    function obterMensagemErro(erro) {
      return erro && erro.message ? erro.message : "Nao foi possivel concluir a operacao.";
    }

    function escaparHtml(valor) {
      return String(valor === null || valor === undefined ? "" : valor)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function escaparAttr(valor) {
      return escaparHtml(valor);
    }
  </script>
</body>
</html>
