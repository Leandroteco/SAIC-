<!DOCTYPE html>
<!--
  SAIC - Grupos e Palestras
  Tela leve para Workshop, PROSEN e Palestras.
  Workshop/PROSEN recebem participantes nominais; Palestra registra quantidade.
-->
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Grupos e Palestras - SiSMen</title>
  <style>
    :root {
      --bg: #eef4f7;
      --surface: #ffffff;
      --surface-soft: #f7fbfc;
      --ink: #263033;
      --muted: #66747c;
      --line: #d8e4e8;
      --red: #b31f2a;
      --red-soft: #f5e1e3;
      --blue: #315f72;
      --blue-soft: #dbeef5;
      --green: #2f7d55;
      --gold: #b0872f;
      --shadow: 0 18px 38px rgba(31, 48, 56, 0.10);
      --radius: 8px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: var(--bg);
      color: var(--ink);
      font-family: "Segoe UI", Arial, sans-serif;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    button {
      border: 0;
      cursor: pointer;
      font-weight: 800;
    }

    button:disabled {
      cursor: not-allowed;
      opacity: 0.62;
    }

    label {
      display: block;
      margin-bottom: 6px;
      color: #475569;
      font-size: 13px;
      font-weight: 800;
    }

    input,
    select,
    textarea {
      width: 100%;
      min-height: 42px;
      padding: 10px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface-soft);
      color: var(--ink);
      font-size: 14px;
      outline: none;
    }

    textarea {
      min-height: 90px;
      resize: vertical;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(49, 95, 114, 0.14);
    }

    .app-shell {
      display: grid;
      grid-template-columns: 250px minmax(0, 1fr);
      min-height: 100vh;
    }

    .sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      padding: 24px 18px;
      background: linear-gradient(180deg, #5f6668 0%, #50575a 52%, #454b4e 100%);
      border-right: 3px solid #df0209;
      box-shadow: 12px 0 28px rgba(41, 48, 51, 0.10);
      color: #ffffff;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
    }

    .sidebar::after {
      content: none;
    }

    .brand {
      border-bottom: 1px solid rgba(255, 255, 255, 0.16);
      padding-bottom: 22px;
    }

    .brand-home-link {
      align-items: center;
      background: transparent;
      border: 0;
      color: inherit;
      cursor: pointer;
      display: flex;
      gap: 12px;
      margin: 0;
      min-height: 0;
      padding: 0;
      text-align: left;
      width: 100%;
    }

    .brand-mark.preview-brand-logo {
      align-items: center;
      background: #ffffff;
      border: 3px solid #df0209;
      border-radius: 999px;
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.22);
      display: flex;
      flex: 0 0 auto;
      height: 66px;
      justify-content: center;
      overflow: hidden;
      width: 66px;
    }

    .brand-mark.preview-brand-logo img {
      display: block;
      height: 100%;
      object-fit: cover;
      object-position: center;
      width: 100%;
    }

    .brand-home-copy {
      min-width: 0;
    }

    .brand-title {
      color: #ffffff;
      display: block;
      font-size: 18px;
      font-weight: 900;
      letter-spacing: 0;
      line-height: 1.1;
    }

    .brand-subtitle {
      color: rgba(255, 255, 255, 0.72);
      display: block;
      font-size: 12px;
      font-weight: 700;
      margin-top: 4px;
    }

    .brand-home-link:hover .brand-title {
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    .brand-home-link:focus-visible {
      outline: 2px solid #ffffff;
      outline-offset: 5px;
    }

    .side-nav {
      display: grid;
      gap: 8px;
      margin-top: 26px;
    }

    .side-nav button {
      align-items: center;
      background: transparent;
      border: 0;
      border-radius: var(--radius);
      color: rgba(255, 255, 255, 0.84);
      display: flex;
      font-size: 14px;
      font-weight: 800;
      gap: 10px;
      justify-content: flex-start;
      min-height: 42px;
      padding: 10px 12px;
      text-align: left;
      width: 100%;
    }

    .side-nav button:hover,
    .side-nav button.active {
      background: rgba(255, 255, 255, 0.14);
      color: #ffffff;
    }

    .nav-dot {
      background: #ffffff;
      border-radius: 999px;
      height: 7px;
      width: 7px;
    }

    .side-nav button.nav-subitem {
      font-size: 13px;
      font-weight: 700;
      min-height: 36px;
      padding: 8px 10px;
    }

    .side-nav-module {
      display: grid;
      gap: 4px;
    }

    .side-nav-submenu {
      display: grid;
      gap: 4px;
      margin: 0 0 4px 17px;
      padding-left: 10px;
    }

    .side-nav button.nav-subitem.active {
      background: rgba(255, 255, 255, 0.10);
      box-shadow: inset 3px 0 0 #ffffff;
    }

    .side-nav button.nav-voltar {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.18);
      color: #ffffff;
    }

    .side-nav button.nav-voltar:hover {
      background: rgba(255, 255, 255, 0.18);
    }

    .session-footer {
      border-top: 1px solid rgba(255, 255, 255, 0.16);
      margin-top: auto;
      padding-top: 14px;
    }

    .btn-encerrar-sessao {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: var(--radius);
      color: #ffffff;
      cursor: pointer;
      display: block;
      font-size: 12px;
      font-weight: 800;
      min-height: 36px;
      padding: 8px 10px;
      text-align: left;
      width: 100%;
    }

    .btn-encerrar-sessao:hover {
      background: rgba(255, 255, 255, 0.16);
    }

    .content {
      min-width: 0;
      padding: 28px;
    }

    .page-banner {
      position: relative;
      overflow: hidden;
      min-height: 142px;
      padding: 28px 30px;
      border: 1px solid rgba(216, 228, 232, 0.8);
      border-radius: var(--radius);
      background: linear-gradient(135deg, #ffffff 0%, #eef6f8 100%);
      box-shadow: var(--shadow);
    }

    .page-banner::before,
    .page-banner::after {
      content: "";
      position: absolute;
      left: 0;
      width: 100%;
      height: 8px;
      pointer-events: none;
    }

    .page-banner::before {
      top: 0;
      background: linear-gradient(100deg, var(--red) 0%, rgba(179, 31, 42, 0.7) 34%, transparent 86%);
      clip-path: polygon(0 0, 100% 0, 88% 100%, 0 100%);
    }

    .page-banner::after {
      bottom: 0;
      background: linear-gradient(280deg, #75848a 0%, rgba(117, 132, 138, 0.62) 36%, transparent 88%);
      clip-path: polygon(12% 0, 100% 0, 100% 100%, 0 100%);
    }

    .banner-content {
      position: relative;
      z-index: 1;
      display: flex;
      justify-content: space-between;
      gap: 20px;
      align-items: center;
    }

    .eyebrow {
      margin: 0 0 8px;
      color: var(--red);
      font-size: 13px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0;
    }

    .page-banner h1 {
      margin: 0;
      color: var(--ink);
      font-size: clamp(30px, 4vw, 44px);
      line-height: 1.08;
      letter-spacing: 0;
    }

    .page-banner span {
      display: block;
      margin-top: 8px;
      color: var(--muted);
      font-weight: 700;
    }

    .summary-card {
      min-width: 230px;
      padding: 16px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: rgba(255, 255, 255, 0.88);
    }

    .summary-card small {
      display: block;
      color: var(--muted);
      font-weight: 800;
    }

    .summary-card strong {
      display: block;
      margin-top: 6px;
      font-size: 18px;
      color: var(--ink);
    }

    .status-line {
      min-height: 22px;
      margin: 18px 0;
      color: var(--muted);
      font-size: 14px;
      font-weight: 700;
    }

    .status-line.error {
      color: #b42318;
    }

    .status-line.success {
      color: var(--green);
    }

    .status-line.centered {
      text-align: center;
    }

    .section {
      margin-top: 18px;
      padding: 22px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface);
      box-shadow: var(--shadow);
    }

    .section-title {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 0 0 18px;
      color: var(--ink);
      font-size: 19px;
      line-height: 1.2;
    }

    .section-title::before {
      content: "";
      width: 4px;
      height: 24px;
      border-radius: 999px;
      background: var(--red);
    }

    .section-title-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 16px;
    }

    .section-title-row .section-title {
      margin-bottom: 0;
    }

    .section-title-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .grid-3 {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    .field-full {
      grid-column: 1 / -1;
    }

    .field-span-2 {
      grid-column: span 2;
    }

    .event-grid,
    .participant-form-grid {
      gap: 12px;
    }

    .participant-form-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .manual-posto {
      order: 4;
      grid-column: span 3;
    }
    .manual-re {
      order: 1;
      grid-column: span 4;
    }
    .manual-cpf {
      order: 2;
      grid-column: span 4;
    }
    .manual-situacao {
      order: 10;
      grid-column: span 6;
    }
    .manual-nome {
      order: 5;
      grid-column: span 9;
    }
    .manual-email {
      order: 7;
      grid-column: span 4;
    }
    .manual-telefone {
      order: 3;
      grid-column: span 4;
    }
    .manual-opm {
      order: 11;
      grid-column: span 6;
    }
    .manual-ingresso {
      order: 12;
      grid-column: span 6;
    }
    .manual-estado-civil {
      order: 9;
      grid-column: span 6;
    }
    .manual-sexo {
      order: 6;
      grid-column: span 4;
    }
    .manual-nascimento {
      order: 8;
      grid-column: span 4;
    }
    .manual-cep {
      order: 13;
      grid-column: span 2;
    }
    .manual-rua {
      order: 14;
      grid-column: span 8;
    }
    .manual-numero {
      order: 15;
      grid-column: span 2;
    }
    .manual-complemento {
      order: 19;
      grid-column: span 3;
    }
    .manual-bairro {
      order: 16;
      grid-column: span 3;
    }
    .manual-cidade {
      order: 17;
      grid-column: span 4;
    }
    .manual-estado {
      order: 18;
      grid-column: span 2;
    }

    .manual-futuro {
      display: none;
    }

    .event-grid input,
    .event-grid select,
    .event-grid textarea,
    .participant-form-grid input,
    .participant-form-grid select,
    .participant-form-grid textarea {
      min-height: 42px;
      padding: 10px;
    }

    .event-grid textarea {
      min-height: 76px;
    }

    .observacoes-grupo textarea {
      height: 42px;
      min-height: 42px;
      resize: none;
    }

    .observacoes-grupo .event-cancel-row {
      margin-top: 4px;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
      margin-top: 18px;
    }

    .participant-actions {
      justify-content: space-between;
      gap: 14px;
    }

    .participant-actions-main {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
    }

    .btn-primary {
      min-height: 44px;
      padding: 11px 16px;
      border-radius: var(--radius);
      background: var(--blue);
      color: #ffffff;
      box-shadow: 0 10px 20px rgba(49, 95, 114, 0.16);
    }

    .btn-secondary {
      min-height: 44px;
      padding: 11px 16px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: #ffffff;
      color: var(--ink);
    }

    .btn-transparent {
      min-height: 34px;
      padding: 7px 10px;
      border: 1px solid transparent;
      border-radius: var(--radius);
      background: transparent;
      color: var(--muted);
      box-shadow: none;
    }

    .event-cancel-row {
      display: flex;
      justify-content: flex-end;
      margin-top: 8px;
    }

    .btn-danger {
      min-height: 38px;
      padding: 9px 12px;
      border-radius: var(--radius);
      background: var(--red-soft);
      color: var(--red);
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 50;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 18px;
      background: rgba(18, 32, 39, 0.38);
    }

    .modal-backdrop.active {
      display: flex;
    }

    .modal-box {
      width: min(460px, 100%);
      padding: 24px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: #ffffff;
      box-shadow: 0 24px 60px rgba(18, 32, 39, 0.24);
    }

    .modal-box h2 {
      margin: 0 0 10px;
      color: var(--ink);
      font-size: 22px;
      line-height: 1.2;
    }

    .modal-box p {
      margin: 0;
      color: var(--muted);
      font-size: 14px;
      font-weight: 700;
      line-height: 1.6;
    }

    .modal-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 20px;
    }

    .event-pill {
      display: inline-flex;
      align-items: center;
      min-height: 36px;
      padding: 8px 12px;
      border-radius: 999px;
      background: var(--blue-soft);
      color: var(--blue);
      font-size: 13px;
      font-weight: 900;
      text-transform: uppercase;
    }

    .saving-inline {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 28px;
      color: var(--muted);
      font-size: 13px;
      font-weight: 800;
    }

    .saving-inline.success {
      color: var(--green);
    }

    .saving-inline.error {
      color: #b42318;
    }

    .field-helper {
      color: var(--muted);
      display: block;
      font-size: 12px;
      font-weight: 800;
      min-height: 18px;
      padding-top: 5px;
    }

    .event-save-actions {
      display: grid;
      gap: 10px;
    }

    .event-save-actions .event-pill {
      justify-self: start;
    }

    .btn-success {
      align-items: center;
      background: #0f766e;
      border-radius: 8px;
      box-shadow: 0 10px 22px rgba(15, 118, 110, 0.20);
      color: #ffffff;
      display: flex;
      font-size: 18px;
      gap: 10px;
      justify-content: center;
      margin-top: 0;
      min-height: 50px;
      padding: 12px 18px;
      width: 100%;
    }

    .btn-success:hover {
      background: #115e59;
    }

    .btn-success:disabled {
      cursor: wait;
      opacity: 0.78;
    }

    .saving-spinner {
      width: 16px;
      height: 16px;
      border: 2px solid rgba(49, 95, 114, 0.18);
      border-top-color: var(--blue);
      border-radius: 999px;
      animation: girar 0.8s linear infinite;
    }

    @keyframes girar {
      to {
        transform: rotate(360deg);
      }
    }

    .navegacao-overlay {
      align-items: center;
      background: rgba(15, 23, 42, 0.42);
      display: none;
      inset: 0;
      justify-content: center;
      padding: 22px;
      position: fixed;
      z-index: 150;
    }

    .navegacao-card {
      align-items: center;
      background: #ffffff;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: 0 24px 60px rgba(15, 23, 42, 0.24);
      color: var(--ink);
      display: inline-flex;
      gap: 12px;
      min-width: 260px;
      padding: 18px 22px;
    }

    .confirmacao-navegacao-overlay {
      align-items: center;
      background: rgba(15, 23, 42, 0.44);
      display: none;
      inset: 0;
      justify-content: center;
      padding: 22px;
      position: fixed;
      z-index: 180;
    }

    .confirmacao-navegacao-overlay.ativo {
      display: flex;
    }

    .confirmacao-navegacao-modal {
      background: #ffffff;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: 0 28px 70px rgba(15, 23, 42, 0.28);
      padding: 24px;
      width: min(460px, 94vw);
    }

    .confirmacao-navegacao-modal span {
      color: var(--red);
      display: block;
      font-size: 12px;
      font-weight: 900;
      margin-bottom: 6px;
      text-transform: uppercase;
    }

    .confirmacao-navegacao-modal h2 {
      color: var(--ink);
      font-size: 24px;
      margin: 0 0 10px;
    }

    .confirmacao-navegacao-modal p {
      color: var(--muted);
      font-size: 14px;
      font-weight: 700;
      line-height: 1.6;
      margin: 0;
    }

    .confirmacao-navegacao-acoes {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: flex-end;
      margin-top: 20px;
    }

    .confirmacao-navegacao-acoes button {
      margin-top: 0;
      width: auto;
    }

    .navegacao-spinner {
      animation: girar 0.8s linear infinite;
      border: 3px solid rgba(49, 95, 114, 0.18);
      border-radius: 999px;
      border-top-color: var(--blue);
      height: 22px;
      width: 22px;
    }

    .navegacao-card strong {
      font-size: 15px;
      font-weight: 900;
    }

    .sessao-overlay {
      align-items: center;
      background: rgba(15, 23, 42, 0.44);
      display: none;
      inset: 0;
      justify-content: center;
      padding: 20px;
      position: fixed;
      z-index: 190;
    }

    .sessao-overlay.ativo {
      display: flex;
    }

    .sessao-modal {
      background: #ffffff;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.22);
      max-width: 420px;
      padding: 22px;
      width: min(420px, 100%);
    }

    .sessao-modal span {
      color: var(--red);
      display: block;
      font-size: 12px;
      font-weight: 900;
      text-transform: uppercase;
    }

    .sessao-modal h2 {
      color: var(--ink);
      font-size: 20px;
      margin: 8px 0 8px;
    }

    .sessao-modal p {
      color: var(--muted);
      font-size: 14px;
      line-height: 1.45;
      margin: 0;
    }

    .sessao-acoes {
      display: flex;
      gap: 10px;
      justify-content: flex-end;
      margin-top: 18px;
    }

    .sessao-acoes button {
      margin-top: 0;
      width: auto;
    }

    .link-box {
      display: none;
      margin-top: 14px;
      padding: 14px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface-soft);
    }

    .link-box input {
      font-size: 13px;
    }

    .participant-panel {
      display: none;
    }

    .quantity-panel {
      display: none;
    }

    .mini-table {
      width: 100%;
      border-collapse: collapse;
      overflow: hidden;
      border-radius: var(--radius);
      font-size: 14px;
    }

    .mini-table th,
    .mini-table td {
      padding: 10px;
      border-bottom: 1px solid var(--line);
      text-align: left;
      vertical-align: top;
    }

    .mini-table th {
      background: var(--surface-soft);
      color: var(--muted);
      font-size: 12px;
      text-transform: uppercase;
    }

    .empty-state {
      padding: 16px;
      border: 1px dashed var(--line);
      border-radius: var(--radius);
      color: var(--muted);
      font-weight: 700;
      text-align: center;
    }

    .required-note {
      margin: 8px 0 0;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.45;
    }

    @media (max-width: 900px) {
      .app-shell {
        grid-template-columns: 1fr;
      }

      .sidebar {
        position: relative;
        height: auto;
      }

      .side-nav {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .content {
        padding: 18px;
      }

      .banner-content,
      .grid-2,
      .grid-3 {
        grid-template-columns: 1fr;
      }

      .field-span-2 {
        grid-column: 1 / -1;
      }

      .participant-form-grid > div,
      .manual-nome {
        grid-column: 1 / -1;
      }

      .banner-content {
        align-items: stretch;
