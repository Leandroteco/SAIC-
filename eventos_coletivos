  <script>
    const webAppUrl = "<?= webAppUrl ?>";
    let tokenGoogle = "<?= tokenGoogleInicial ?>";
    let usuarioLogado = <?!= usuarioInicialJson ?>;
    let tipoEventoInicial = "<?= tipoEventoInicial ?>";
    let tipoEventoAtual = "grupo";
    let idEventoAtual = "";
    let tokenEventoAtual = "";
    let linkParticipanteAtual = "";
    let participantesManuais = [];
    let participantesLink = [];
    let eventoRascunhoAberto = false;
    let idParticipanteCancelamentoAtual = "";
    let navegacaoAlteracoesPendentes = false;
    let acaoConfirmadaNavegacao = null;

    const rotulosEvento = {
      grupo: "Grupo",
      palestra: "Palestra"
    };

    const titulosEvento = {
      grupo: "Grupos",
      palestra: "Palestras"
    };

    const temasPorTipoEvento = {
      grupo: [
        "PPAD",
        "PROSEN",
        "Grupo de Conflitos Internos",
        "Grupo PrAP",
        "Grupo de Família",
        "Grupo de Mulheres",
        "Estresse",
        "Intervenção Focal APMBB",
        "Conflitos Profissionais",
        "Workshop"
      ],
      palestra: [
        "PrAP",
        "Qualidade de Vida / Inatividade",
        "Álcool e Outras Drogas",
        "PPMS",
        "PROSEN: Relacionamento Conjugal / Interpessoal",
        "Inteligência Emocional",
        "Fatores de Risco e de Proteção",
        "Mudança de Identidade",
        "CAPS na OPM",
        "Funcionamento NAPS",
        "Gestão das Emoções",
        "Relacionamento Interno no Trabalho",
        "Pós-Venção"
      ]
    };

    window.addEventListener("load", function() {
      const hoje = new Date();
      document.getElementById("dataEvento").value = formatarDataBrasilInput(hoje);
      atualizarCalculosDatasEvento();

      if (!tokenGoogle || !usuarioLogado || !usuarioLogado.autorizado) {
        mostrarStatus("Abra Grupos e Palestras pelo menu do formulario.", "error");
        bloquearTela();
        return;
      }

      document.getElementById("napsAtendimento").value = usuarioLogado.naps || "";
      selecionarEvento(rotulosEvento[tipoEventoInicial] ? tipoEventoInicial : "grupo");
      configurarMenuPrincipalPorPerfil();
      registrarLimpezaStatusAoEditarEvento();
      carregarRascunhoEventoAberto();
    });

    function selecionarEvento(tipo, preservarEstado) {
      tipo = normalizarTipoEventoTela(tipo);

      if (eventoRascunhoAberto && preservarEstado !== true && tipo !== tipoEventoAtual) {
        atualizarNavegacaoEvento();
        mostrarStatus("Finalize o evento em aberto antes de iniciar outro.", "error");
        return;
      }

      if (tipo !== tipoEventoAtual && preservarEstado !== true) {
        resetarEstadoEvento();
      }

      tipoEventoAtual = tipo;
      const usaParticipantes = tipoEventoAtual === "grupo";
      const usaModalidade = tipoEventoAtual === "palestra";
      const rotulo = rotulosEvento[tipoEventoAtual] || "Grupo/Palestra";
      const titulo = titulosEvento[tipoEventoAtual] || rotulo;

      atualizarNavegacaoEvento();
      atualizarOpcoesTemaEvento(
        tipoEventoAtual,
        preservarEstado === true ? document.getElementById("tema").value : ""
      );

      document.getElementById("tituloPagina").innerText = titulo;
      document.getElementById("tipoEvento").value = rotulo;
      document.getElementById("participantPanel").style.display = usaParticipantes ? "block" : "none";
      document.getElementById("listaPanel").style.display = usaParticipantes ? "block" : "none";
      document.getElementById("linkActions").style.display = usaParticipantes ? "flex" : "none";
      document.getElementById("quantityPanel").style.display = usaParticipantes ? "none" : "block";
      document.getElementById("modalidadePanel").style.display = usaModalidade ? "block" : "none";
      document.getElementById("observacoesPanel").className = usaModalidade ? "field-span-2" : "observacoes-grupo";
      if (!usaModalidade) document.getElementById("modalidadeEvento").value = "";
      document.getElementById("btnSalvarEvento").innerText = "Salvar " + rotulo;
      atualizarContador();
      renderizarParticipantes();
      atualizarBotaoCancelarEvento();
    }

    function normalizarTipoEventoTela(tipo) {
      const texto = String(tipo || "").toLowerCase().trim();

      if (texto === "palestra" || texto === "palestras") return "palestra";
      if (texto === "grupo" || texto === "grupos" || texto === "workshop" || texto === "prosen") return "grupo";

      return "grupo";
    }

    function atualizarNavegacaoEvento() {
      ["grupo", "palestra"].forEach(function(item) {
        const botao = document.getElementById("nav-" + item);
        if (botao) botao.classList.toggle("active", item === tipoEventoAtual);
      });
    }

    function atualizarOpcoesTemaEvento(tipo, valorSelecionado) {
      const campoTema = document.getElementById("tema");
      const temas = temasPorTipoEvento[tipo] || [];
      const valorAtual = valorSelecionado !== undefined ? valorSelecionado : campoTema.value;

      campoTema.innerHTML = '<option value="">Selecione</option>';

      temas.forEach(function(tema) {
        const option = document.createElement("option");
        option.value = tema;
        option.textContent = tema;
        campoTema.appendChild(option);
      });

      if (valorAtual && temas.indexOf(valorAtual) === -1) {
        const optionAtual = document.createElement("option");
        optionAtual.value = valorAtual;
        optionAtual.textContent = valorAtual;
        campoTema.appendChild(optionAtual);
      }

      campoTema.value = valorAtual || "";
    }

    function mostrarCarregamentoNavegacao(texto) {
      const overlay = document.getElementById("navegacaoOverlay");
      const mensagem = document.getElementById("navegacaoMensagem");

      if (mensagem) mensagem.innerText = texto || "Carregando...";
      if (overlay) overlay.style.display = "flex";
    }

    function encerrarSessaoSAIC() {
      const overlay = document.getElementById("sessaoOverlay");
      const texto = document.getElementById("sessaoTexto");

      if (texto) {
        texto.innerText = "Ao encerrar, o SAIC voltar\u00e1 para a tela de login neste navegador.";

        if (typeof navegacaoAlteracoesPendentes !== "undefined" && navegacaoAlteracoesPendentes) {
          texto.innerText = "Existem dados n\u00e3o salvos. Ao encerrar a sess\u00e3o, eles ser\u00e3o perdidos.";
        }
      }

      if (overlay) {
        overlay.classList.add("ativo");
        return;
      }

      confirmarEncerrarSessaoSAIC();
    }

    function fecharModalEncerrarSessao() {
      const overlay = document.getElementById("sessaoOverlay");

      if (overlay) overlay.classList.remove("ativo");
    }

    function confirmarEncerrarSessaoSAIC() {
      tokenGoogle = "";
      usuarioLogado = null;
      fecharModalEncerrarSessao();
      mostrarCarregamentoNavegacao("Encerrando sess\u00e3o...");

      setTimeout(function() {
        if (webAppUrl) {
          try {
            window.top.location.href = webAppUrl;
          } catch (erro) {
            window.location.href = webAppUrl;
          }
        } else {
          window.location.reload();
        }
      }, 120);
    }

    function usuarioPodeAcessarPPMS() {
      const valor = usuarioLogado && usuarioLogado.acessoPpms;

      return valor === true ||
        String(valor || "")
          .toLowerCase()
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .trim() === "sim";
    }

    function configurarMenuPrincipalPorPerfil() {
      const botaoPPMS = document.getElementById("btnNavPPMS");

      if (botaoPPMS) {
        botaoPPMS.style.display = usuarioPodeAcessarPPMS() ? "" : "none";
      }
    }

    function navegarModuloPrincipal(pagina) {
      if (pagina === "eventos_coletivos") return;

      if (!tokenGoogle || !webAppUrl) {
        mostrarStatus("Sessao expirada. Acesse novamente pelo formulario.", "error");
        return;
      }

      if (pagina === "ppms" && !usuarioPodeAcessarPPMS()) {
        mostrarStatus("Recurso disponivel somente para usuarios autorizados.", "error");
        return;
      }

      if (navegacaoAlteracoesPendentes) {
        abrirConfirmacaoNavegacao(function() {
          navegarModuloPrincipal(pagina);
        });
        return;
      }

      mostrarCarregamentoNavegacao(obterMensagemCarregamentoModulo(pagina));

      const form = document.createElement("form");
      form.method = "post";
      form.action = webAppUrl;
      form.target = "_top";
      form.style.display = "none";

      const campoToken = document.createElement("input");
      campoToken.type = "hidden";
      campoToken.name = "credential";
      campoToken.value = tokenGoogle;

      const campoDestino = document.createElement("input");
      campoDestino.type = "hidden";
      campoDestino.name = "state";
      campoDestino.value = pagina;

      form.appendChild(campoToken);
      form.appendChild(campoDestino);
      document.body.appendChild(form);

      setTimeout(function() {
        form.submit();
        form.remove();
      }, 80);
    }

    function obterMensagemCarregamentoModulo(pagina) {
      const mensagens = {
        index: "Carregando p\u00e1gina inicial...",
        atendimento: "Carregando Atendimento...",
        incidente_critico: "Carregando Incidente Cr\u00edtico...",
        ppms: "Carregando PPMS..."
      };

      return mensagens[pagina] || "Carregando...";
    }

    function abrirConfirmacaoNavegacao(acaoConfirmada) {
      acaoConfirmadaNavegacao = typeof acaoConfirmada === "function" ? acaoConfirmada : null;

      const overlay = document.getElementById("confirmacaoNavegacaoOverlay");
      if (overlay) overlay.classList.add("ativo");
    }

    function fecharConfirmacaoNavegacao() {
      acaoConfirmadaNavegacao = null;

      const overlay = document.getElementById("confirmacaoNavegacaoOverlay");
      if (overlay) overlay.classList.remove("ativo");
    }

    function confirmarSaidaSemSalvar() {
      const acao = acaoConfirmadaNavegacao;
      acaoConfirmadaNavegacao = null;
      navegacaoAlteracoesPendentes = false;

      const overlay = document.getElementById("confirmacaoNavegacaoOverlay");
      if (overlay) overlay.classList.remove("ativo");

      if (typeof acao === "function") acao();
    }

    function marcarAlteracaoPendenteNavegacao() {
      navegacaoAlteracoesPendentes = true;
    }

    function limparAlteracaoPendenteNavegacao() {
      navegacaoAlteracoesPendentes = false;
    }

    function resetarEstadoEvento() {
      idEventoAtual = "";
      tokenEventoAtual = "";
      linkParticipanteAtual = "";
      participantesManuais = [];
      participantesLink = [];
      eventoRascunhoAberto = false;
      document.getElementById("linkParticipante").value = "";
      document.getElementById("linkBox").style.display = "none";
      document.getElementById("quantidadeInformada").value = "";
      document.getElementById("modalidadeEvento").value = "";
      atualizarBotaoCancelarEvento();
    }

    function limparIdentificacaoEvento() {
      document.getElementById("dataEvento").value = formatarDataBrasilInput(new Date());
      document.getElementById("tema").value = "";
      document.getElementById("observacoes").value = "";
      document.getElementById("quantidadeInformada").value = "";
      document.getElementById("modalidadeEvento").value = "";
