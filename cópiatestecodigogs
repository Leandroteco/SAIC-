      idAtendimento: idAtendimento,
      nome: linha[2] || "",
      cpf: linha[3] || "",
      tipoVinculo: linha[4] || "",
      parentesco: linha[5] || "",
      observacoes: linha[6] || ""
    });
  }

  return mapa;
}

