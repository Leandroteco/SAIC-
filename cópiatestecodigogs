function numeroColunaParaLetra(numero) {
  let letra = "";
  let atual = Number(numero || 0);

  while (atual > 0) {
    const resto = (atual - 1) % 26;
    letra = String.fromCharCode(65 + resto) + letra;
    atual = Math.floor((atual - 1) / 26);
  }

  return letra || "?";
}

