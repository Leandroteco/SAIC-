      </div>

      <div class="grid-2">
        <section class="panel">
          <h2>Faixa et&aacute;ria</h2>
          <table class="mini-table">
            <thead>
              <tr>
                <th>Faixa</th>
                <th>Quantidade</th>
                <th>%</th>
              </tr>
            </thead>
            <tbody>
              <? if (dados.faixaEtaria.length === 0) { ?>
                <tr><td colspan="3">Nenhum registro encontrado no per&iacute;odo.</td></tr>
              <? } ?>
              <? dados.faixaEtaria.forEach(function(item) { ?>
                <tr>
                  <td><?= item.nome ?></td>
                  <td><?= item.valor ?></td>
