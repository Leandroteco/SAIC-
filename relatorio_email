            </tbody>
          </table>
        </section>
      </div>
    </main>

    <footer class="footer">
      <span>Relat&oacute;rio enviado para destinat&aacute;rios ativos da aba emails_relatorio</span>
      <span>P&aacute;gina 2 de 2</span>
    </footer>
  </section>
</body>
</html>
