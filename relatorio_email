              <tr><td>Faltas</td><td><?= dados.mes.resumo.totalFaltas ?></td><td><?= dados.mes.anterior.totalFaltas ?></td><td><?= dados.mes.variacaoFaltas ?></td></tr>
              <tr><td>Altas</td><td><?= dados.mes.resumo.totalAltas ?></td><td><?= dados.mes.anterior.totalAltas ?></td><td><?= dados.mes.variacaoAltas ?></td></tr>
