                <span><?= item.nome ?></span>
                <div class="track"><div class="bar <?= item.cor ?>" style="width:<?= item.largura ?>%"></div></div>
                <strong><?= item.valor ?></strong>
              </div>
            <? }); ?>
          </div>
        </section>

        <section class="panel">
          <h2>Perfil</h2>
          <div class="bars">
            <? dados.perfilSituacao.forEach(function(item) { ?>
              <div class="bar-row">
