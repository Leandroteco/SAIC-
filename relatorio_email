            <thead>
              <tr>
                <th>Faixa</th>
                <th>Quantidade</th>
                <th>%</th>
              </tr>
            </thead>
            <tbody>
              <? if (dados.tempoServico.length === 0) { ?>
                <tr><td colspan="3">Nenhum registro encontrado no per&iacute;odo.</td></tr>
              <? } ?>
              <? dados.tempoServico.forEach(function(item) { ?>
                <tr>
                  <td><?= item.nome ?></td>
                  <td><?= item.valor ?></td>
                  <td><?= item.percentual ?></td>
                </tr>
              <? }); ?>
            </tbody>
          </table>
        </section>
      </div>

      <div class="grid-2">
        <section class="panel">
          <h2>Resumo semanal</h2>
          <table class="mini-table">
            <thead>
              <tr>
                <th>Indicador</th>
                <th>Semana atual</th>
                <th>Semana anterior</th>
                <th>Varia&ccedil;&atilde;o</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Atendimentos</td><td><?= dados.semana.resumo.totalAtendimentos ?></td><td><?= dados.semana.anterior.totalAtendimentos ?></td><td><?= dados.semana.variacaoAtendimentos ?></td></tr>
              <tr><td>Pessoas</td><td><?= dados.semana.resumo.pessoasDistintas ?></td><td><?= dados.semana.anterior.pessoasDistintas ?></td><td><?= formatarVariacaoRelatorioEmail(dados.semana.resumo.pessoasDistintas, dados.semana.anterior.pessoasDistintas) ?></td></tr>
