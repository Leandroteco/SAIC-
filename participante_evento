  <script>
    const tokenEvento = "<?= tokenEventoInicial ?>";
    let eventoAtual = null;
    let etapaParticipanteAtual = 1;
    let ultimoCepConsultado = "";
    let cepParticipanteInexistente = false;
    let selectMobileAtual = "";
    const selectsMobileParticipante = ["postoGraduacao", "situacaoStatus", "sexo", "estadoCivil"];
    const etapasParticipante = [
      { numero: 1, titulo: "Identifica\u00e7\u00e3o" },
      { numero: 2, titulo: "Dados Funcionais" },
      { numero: 3, titulo: "Endere\u00e7o" },
      { numero: 4, titulo: "Contato" }
    ];

    aplicarClasseAndroidParticipante();

    window.addEventListener("load", function() {
      inicializarSelectsMobile();

      if (!tokenEvento) {
        mostrarStatus("Link do evento nao informado.", "error");
        return;
      }

      google.script.run
        .withSuccessHandler(function(evento) {
          if (!evento || !evento.encontrado) {
            mostrarStatus(evento && evento.mensagem ? evento.mensagem : "Evento nao localizado.", "error");
            return;
          }

          eventoAtual = evento;
          preencherEvento(evento);
          document.getElementById("conteudo").style.display = "block";
          inicializarEtapasParticipante();
          mostrarStatus("Preencha seus dados e envie ao responsavel pelo evento.", "");
        })
        .withFailureHandler(function(erro) {
          mostrarStatus(obterMensagemErro(erro), "error");
        })
        .obterEventoPorTokenPublico(tokenEvento);
    });

    function aplicarClasseAndroidParticipante() {
      const agente = navigator.userAgent || "";

      if (/Android/i.test(agente)) {
        document.body.classList.add("android");
      }
    }

    function preencherEvento(evento) {
      document.getElementById("tituloEvento").innerText = evento.tipoEventoRotulo || "Cadastro de Participante";
      document.getElementById("infoTipo").innerText = evento.tipoEventoRotulo || "-";
      document.getElementById("infoData").innerText = evento.dataEvento || "-";
      document.getElementById("infoNaps").innerText = evento.napsAtendimento || "-";
      document.getElementById("infoTema").innerText = evento.tema || "-";
    }

    function inicializarEtapasParticipante() {
      irParaEtapaParticipante(1, false);

      window.addEventListener("resize", function() {
        atualizarEtapaParticipante();
      });
    }

    function inicializarSelectsMobile() {
      selectsMobileParticipante.forEach(function(id) {
        const select = document.getElementById(id);

        if (!select || select.dataset.mobileSelectPronto === "sim") return;

        select.dataset.mobileSelectPronto = "sim";
        select.classList.add("mobile-select-original");

        const botao = document.createElement("button");
        botao.type = "button";
        botao.className = "mobile-select-trigger placeholder";
        botao.setAttribute("data-select-id", id);
        botao.onclick = function() {
          abrirSeletorMobile(id);
        };

        select.insertAdjacentElement("afterend", botao);
        select.addEventListener("change", function() {
          atualizarBotaoSelectMobile(id);
          limparErroVisualCampo(select);
        });

        atualizarBotaoSelectMobile(id);
      });
    }

    function ehSelectMobile(id) {
      return selectsMobileParticipante.indexOf(id) >= 0;
    }

    function obterBotaoSelectMobile(id) {
      return document.querySelector('.mobile-select-trigger[data-select-id="' + id + '"]');
    }

    function atualizarBotoesSelectsMobile() {
      selectsMobileParticipante.forEach(function(id) {
        atualizarBotaoSelectMobile(id);
      });
    }

    function atualizarBotaoSelectMobile(id) {
      const select = document.getElementById(id);
      const botao = obterBotaoSelectMobile(id);

      if (!select || !botao) return;

      const texto = select.options[select.selectedIndex]
        ? select.options[select.selectedIndex].text
        : "Selecione";

      botao.textContent = select.value ? texto : "Selecione";
      botao.classList.toggle("placeholder", !select.value);
    }

    function abrirSeletorMobile(id) {
      const select = document.getElementById(id);
      const overlay = document.getElementById("mobileSelectOverlay");
      const titulo = document.getElementById("mobileSelectTitulo");
      const opcoes = document.getElementById("mobileSelectOpcoes");

      if (!select || !overlay || !titulo || !opcoes) return;

      selectMobileAtual = id;
      titulo.textContent = obterLabelCampoParticipante(id);
      opcoes.innerHTML = "";

      Array.prototype.forEach.call(select.options, function(option) {
        const botao = document.createElement("button");
        const valor = option.value;
        const texto = option.text || "Selecione";

        botao.type = "button";
        botao.className = "mobile-select-option" +
          (valor === select.value ? " selecionado" : "") +
          (!valor ? " placeholder" : "");
        botao.textContent = texto;
        botao.onclick = function() {
          selecionarOpcaoMobile(id, valor);
        };

        opcoes.appendChild(botao);
      });

      overlay.classList.add("ativo");
      overlay.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }

    function selecionarOpcaoMobile(id, valor) {
      const select = document.getElementById(id);

      if (!select) return;

      select.value = valor;
      dispararChangeCampo(select);
      fecharSeletorMobile();
    }

    function dispararChangeCampo(campo) {
      let evento;

      try {
        evento = new Event("change", { bubbles: true });
      } catch (erro) {
        evento = document.createEvent("HTMLEvents");
        evento.initEvent("change", true, false);
      }

      campo.dispatchEvent(evento);
    }

    function fecharSeletorMobile() {
      const overlay = document.getElementById("mobileSelectOverlay");

      if (!overlay) return;

      overlay.classList.remove("ativo");
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      selectMobileAtual = "";
    }

    function fecharSeletorMobilePorFora(event) {
      if (event && event.target && event.target.id === "mobileSelectOverlay") {
        fecharSeletorMobile();
      }
    }

    function obterLabelCampoParticipante(id) {
      const label = document.querySelector('label[for="' + id + '"]');

      return label ? label.textContent.trim() : "Selecione";
    }

    function formularioParticipanteMobile() {
      return window.matchMedia && window.matchMedia("(max-width: 780px)").matches;
    }

    function avancarEtapaParticipante() {
      if (etapaParticipanteAtual < etapasParticipante.length) {
        irParaEtapaParticipante(etapaParticipanteAtual + 1, true);
      }
    }

    function voltarEtapaParticipante() {
      if (etapaParticipanteAtual > 1) {
        irParaEtapaParticipante(etapaParticipanteAtual - 1, true);
      }
    }

    function irParaEtapaParticipante(numeroEtapa, rolar) {
      const conteudo = document.getElementById("conteudo");
      const etapa = Math.max(1, Math.min(etapasParticipante.length, Number(numeroEtapa) || 1));
      const dadosEtapa = etapasParticipante[etapa - 1];

      etapaParticipanteAtual = etapa;

      if (conteudo) {
        conteudo.setAttribute("data-etapa", String(etapa));
      }

      atualizarEtapaParticipante();

      if (rolar !== false && formularioParticipanteMobile() && conteudo) {
        conteudo.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }

    function atualizarEtapaParticipante() {
      const dadosEtapa = etapasParticipante[etapaParticipanteAtual - 1] || etapasParticipante[0];
      const contador = document.getElementById("contadorEtapaMobile");
      const titulo = document.getElementById("tituloEtapaMobile");
      const barra = document.getElementById("barraEtapaMobile");

      if (contador) contador.innerText = dadosEtapa.numero + "/" + etapasParticipante.length;
      if (titulo) titulo.innerText = dadosEtapa.titulo;
      if (barra) barra.style.width = ((dadosEtapa.numero / etapasParticipante.length) * 100) + "%";
    }

    function obterEtapaCampoParticipante(id) {
      const mapa = {
        cpf: 1,
        nome: 1,
        sexo: 1,
        dataNascimento: 1,
        estadoCivil: 1,
        numeroFilhos: 1,
        postoGraduacao: 2,
        re: 2,
        opmAtual: 2,
        situacaoStatus: 2,
        dataIngresso: 2,
        cep: 3,
        rua: 3,
        numero: 3,
        bairro: 3,
        cidade: 3,
        estado: 3,
        complemento: 3,
        telefone: 4,
        email: 4
      };

      return mapa[id] || 1;
    }

    function irParaCampoParticipante(id) {
      const campo = document.getElementById(id);

      if (!campo) return;

      if (formularioParticipanteMobile()) {
        irParaEtapaParticipante(obterEtapaCampoParticipante(id), true);
      }

      setTimeout(function() {
        if (formularioParticipanteMobile() && ehSelectMobile(id)) {
          abrirSeletorMobile(id);
          return;
        }

        try {
          campo.focus();
        } catch (erro) {}
      }, 160);
    }

    function enviarCadastro() {
      const participante = lerFormulario();

      if (!validarCamposObrigatoriosParticipante()) return;
      if (!validarDatasFormulario(["dataIngresso", "dataNascimento", "dataInatividade"], ["dataIngresso", "dataNascimento"])) return;

      document.getElementById("btnEnviar").disabled = true;
      definirStatusEnvioCadastro(true, "Enviando cadastro...");
      mostrarStatus("Enviando cadastro...", "");

      google.script.run
        .withSuccessHandler(function(retorno) {
          mostrarStatus("Cadastro enviado com sucesso. Pronto para novo preenchimento.", "success");
          definirStatusEnvioCadastro(false, "Pronto para novo preenchimento.", "success");
          limparFormulario();
          irParaEtapaParticipante(1, true);
          document.getElementById("btnEnviar").disabled = false;
        })
        .withFailureHandler(function(erro) {
          document.getElementById("btnEnviar").disabled = false;
          definirStatusEnvioCadastro(false, obterMensagemErro(erro), "error");
          mostrarStatus(obterMensagemErro(erro), "error");
        })
        .registrarParticipanteEventoPublico(tokenEvento, participante);
    }

    function validarCamposObrigatoriosParticipante() {
      const campos = [
        { id: "nome", label: "Nome" },
        { id: "cpf", label: "CPF" },
        { id: "sexo", label: "Sexo" },
        { id: "dataNascimento", label: "Data de nascimento" },
        { id: "estadoCivil", label: "Estado civil" },
        { id: "postoGraduacao", label: "Posto/Graduacao" },
        { id: "re", label: "R.E." },
        { id: "opmAtual", label: "OPM atual" },
        { id: "situacaoStatus", label: "Situacao/Status" },
        { id: "dataIngresso", label: "Data de ingresso" },
        { id: "cep", label: "CEP" },
        { id: "rua", label: "Rua" },
        { id: "numero", label: "Numero" },
        { id: "bairro", label: "Bairro" },
        { id: "cidade", label: "Cidade" },
        { id: "estado", label: "Estado" },
        { id: "telefone", label: "Telefone" },
        { id: "email", label: "E-mail" }
      ];

      for (let i = 0; i < campos.length; i++) {
        const item = campos[i];
        const campo = document.getElementById(item.id);

        if (!campo) continue;

        if (!campo.value.trim()) {
          marcarErroVisualCampo(campo);
          mostrarStatus(item.label + " e obrigatorio.", "error");
          irParaCampoParticipante(item.id);
          return false;
        }

        limparErroVisualCampo(campo);
      }

      const campoCep = document.getElementById("cep");
      const cepNumeros = campoCep ? campoCep.value.replace(/\D/g, "") : "";

      if (cepNumeros.length !== 8) {
        if (campoCep) campoCep.style.border = "2px solid #d32f2f";
        mostrarStatus("Informe um CEP valido.", "error");
        irParaCampoParticipante("cep");
        return false;
      }

      if (cepParticipanteInexistente && cepNumeros === ultimoCepConsultado) {
        if (campoCep) campoCep.style.border = "2px solid #d32f2f";
        mostrarStatus("CEP inexistente ou nao encontrado.", "error");
        irParaCampoParticipante("cep");
        return false;
      }

      return true;
    }

    function lerFormulario() {
      return {
        postoGraduacao: valorCampo("postoGraduacao"),
        re: valorCampo("re"),
        cpf: valorCampo("cpf"),
        nome: valorCampo("nome"),
        situacaoStatus: valorCampo("situacaoStatus"),
        email: valorCampo("email"),
        telefone: valorCampo("telefone"),
        dataIngresso: valorDataCampo("dataIngresso"),
        dataNascimento: valorDataCampo("dataNascimento"),
        sexo: valorCampo("sexo"),
        opmAtual: valorCampo("opmAtual"),
        dataInatividade: valorDataCampo("dataInatividade"),
        estadoCivil: valorCampo("estadoCivil"),
        numeroFilhos: valorCampo("numeroFilhos"),
        cep: valorCampo("cep"),
        rua: valorCampo("rua"),
        bairro: valorCampo("bairro"),
        cidade: valorCampo("cidade"),
        estado: valorCampo("estado"),
        numero: valorCampo("numero"),
        complemento: valorCampo("complemento")
      };
    }

    function valorCampo(id) {
      const campo = document.getElementById(id);
      return campo ? campo.value.trim() : "";
    }

    function valorDataCampo(id) {
      const campo = document.getElementById(id);
      return campo ? converterDataBrasilParaISO(campo.value) : "";
    }

    function converterMaiusculasSemAcento(campo) {
      campo.value = String(campo.value || "")
        .toUpperCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");
    }

    function sugerirDominioEmail(campo) {
      const lista = document.getElementById("sugestoesEmail");

      if (!lista) return;

      const dominio = "policiamilitar.sp.gov.br";
      const valor = String((campo && campo.value) || "").trim();
      const partes = valor.split("@");

      if (partes.length !== 2 || !partes[0]) {
        lista.innerHTML = "";
        return;
      }

      const usuario = partes[0];
      const dominioDigitado = partes[1].toLowerCase();

      if (dominioDigitado && dominio.indexOf(dominioDigitado) !== 0) {
        lista.innerHTML = "";
        return;
      }

      const sugestao = usuario + "@" + dominio;

      if (valor.toLowerCase() === sugestao.toLowerCase()) {
        lista.innerHTML = "";
        return;
      }

      lista.innerHTML = '<option value="' + escaparAttr(sugestao) + '"></option>';
    }

    function mascaraRE(campo) {
      let valor = campo.value.toUpperCase().replace(/[^0-9A]/g, "");
      let numerosAntesHifen = "";
      let digitoFinal = "";

      for (let i = 0; i < valor.length; i++) {
        const caractere = valor.charAt(i);

        if (numerosAntesHifen.length < 6) {
          if (/[0-9]/.test(caractere)) numerosAntesHifen += caractere;
          continue;
        }

        if (!digitoFinal && /[0-9A]/.test(caractere)) {
          digitoFinal = caractere;
          break;
        }
      }

      campo.value = digitoFinal ? numerosAntesHifen + "-" + digitoFinal : numerosAntesHifen;
    }

    function mascaraCPF(campo) {
      let valor = campo.value.replace(/\D/g, "").substring(0, 11);

      valor = valor.replace(/(\d{3})(\d)/, "$1.$2");
      valor = valor.replace(/(\d{3})(\d)/, "$1.$2");
      valor = valor.replace(/(\d{3})(\d{1,2})$/, "$1-$2");

      campo.value = valor;
    }

    function mascaraTelefone(campo) {
      let valor = campo.value.replace(/\D/g, "").substring(0, 11);

      if (valor.length <= 10) {
        valor = valor.replace(/(\d{2})(\d)/, "($1) $2");
        valor = valor.replace(/(\d{4})(\d)/, "$1-$2");
      } else {
        valor = valor.replace(/(\d{2})(\d)/, "($1) $2");
        valor = valor.replace(/(\d{5})(\d)/, "$1-$2");
      }

      campo.value = valor;
    }

    function mascaraCEP(campo) {
      let valor = campo.value.replace(/\D/g, "").substring(0, 8);
      cepParticipanteInexistente = false;

      valor = valor.replace(/(\d{5})(\d)/, "$1-$2");

      campo.value = valor;
    }

    function mascaraDataBrasil(campo) {
      let valor = campo.value.replace(/\D/g, "").substring(0, 8);

      valor = valor.replace(/(\d{2})(\d)/, "$1/$2");
      valor = valor.replace(/(\d{2})(\d)/, "$1/$2");

      campo.value = valor;
    }

    function validarAnoDataCampo(campo) {
      if (!campo.value) {
        limparErroVisualCampo(campo);
        return true;
      }

      if (dataBrasilValida(campo.value)) {
        limparErroVisualCampo(campo);
        return true;
      }

      marcarErroVisualCampo(campo);
      return false;
    }

    function validarDatasFormulario(ids, obrigatorios) {
      const obrigatoriosMapa = {};
      let valido = true;
      let primeiroCampoInvalido = "";

      (obrigatorios || []).forEach(function(id) {
        obrigatoriosMapa[id] = true;
      });

      ids.forEach(function(id) {
        const campo = document.getElementById(id);
        if (!campo) return;

        if (obrigatoriosMapa[id] && !campo.value.trim()) {
          marcarErroVisualCampo(campo);
          valido = false;
          if (!primeiroCampoInvalido) primeiroCampoInvalido = id;
          return;
        }

        if (!validarAnoDataCampo(campo)) {
          valido = false;
          if (!primeiroCampoInvalido) primeiroCampoInvalido = id;
        }
      });

      if (!valido) {
        mostrarStatus("Confira as datas no formato dd/mm/aaaa.", "error");
        if (primeiroCampoInvalido) irParaCampoParticipante(primeiroCampoInvalido);
      }

      return valido;
    }

    function dataBrasilValida(valor) {
      const partes = String(valor || "").trim().match(/^(\d{2})\/(\d{2})\/(\d{4})$/);

      if (!partes) return false;

      const dia = Number(partes[1]);
      const mes = Number(partes[2]);
      const ano = Number(partes[3]);

      if (ano < 1 || ano > 9999 || mes < 1 || mes > 12 || dia < 1) return false;

      const data = new Date(ano, mes - 1, dia);

      return data.getFullYear() === ano &&
        data.getMonth() === mes - 1 &&
        data.getDate() === dia;
    }

    function converterDataBrasilParaISO(valor) {
      const partes = String(valor || "").trim().match(/^(\d{2})\/(\d{2})\/(\d{4})$/);

      if (!partes) return "";

      return partes[3] + "-" + partes[2] + "-" + partes[1];
    }

    function limparErroVisualCampo(campo) {
      const botaoSelect = campo && campo.tagName === "SELECT"
        ? obterBotaoSelectMobile(campo.id)
        : null;

      campo.style.border = "1px solid var(--line)";

      if (botaoSelect) {
        botaoSelect.classList.remove("erro");
      }
    }

    function marcarErroVisualCampo(campo) {
      const botaoSelect = campo && campo.tagName === "SELECT"
        ? obterBotaoSelectMobile(campo.id)
        : null;

      campo.style.border = "2px solid #d32f2f";

      if (botaoSelect) {
        botaoSelect.classList.add("erro");
      }
    }

    function buscarCepParticipante() {
      const campoCep = document.getElementById("cep");
      const cep = campoCep.value.replace(/\D/g, "");

      if (cep.length !== 8) return;

      ultimoCepConsultado = cep;
      cepParticipanteInexistente = false;
      fetch("https://viacep.com.br/ws/" + cep + "/json/")
        .then(function(resposta) {
          return resposta.json();
        })
        .then(function(dados) {
          if (!dados.erro) {
            limparErroVisualCampo(campoCep);
            document.getElementById("rua").value = dados.logradouro || "";
            document.getElementById("bairro").value = dados.bairro || "";
            document.getElementById("cidade").value = dados.localidade || "";
            document.getElementById("estado").value = dados.uf || "";
          } else {
            cepParticipanteInexistente = true;
            campoCep.style.border = "2px solid #d32f2f";
            ["rua", "bairro", "cidade", "estado"].forEach(function(id) {
              const campo = document.getElementById(id);
              if (campo) campo.value = "";
            });
            mostrarStatus("CEP inexistente ou nao encontrado.", "error");
          }
        })
        .catch(function() {
          mostrarStatus("Erro ao buscar CEP.", "error");
        });
    }

    function limparFormulario() {
      [
        "postoGraduacao", "re", "cpf", "nome", "situacaoStatus", "email", "telefone",
        "dataIngresso", "dataNascimento", "sexo", "opmAtual", "dataInatividade",
        "estadoCivil", "cep", "rua", "bairro", "cidade", "estado", "numero", "complemento"
      ].forEach(function(id) {
        const campo = document.getElementById(id);
        if (campo) {
          campo.value = "";
          limparErroVisualCampo(campo);
        }
      });

      document.getElementById("numeroFilhos").value = "0";
      atualizarBotoesSelectsMobile();
      ultimoCepConsultado = "";
      cepParticipanteInexistente = false;
    }

    function mostrarStatus(mensagem, tipo) {
      const el = document.getElementById("statusPagina");
      el.className = "status" + (tipo ? " " + tipo : "");
      el.innerText = mensagem || "";
    }

    function obterMensagemErro(erro) {
      return erro && erro.message ? erro.message : "Nao foi possivel concluir a operacao.";
    }

    function definirStatusEnvioCadastro(enviando, texto, tipo) {
      const el = document.getElementById("statusEnvioCadastro");

      if (!el) return;

      el.className = "saving-inline" + (tipo ? " " + tipo : "");
      el.innerHTML = enviando
        ? '<span class="saving-spinner"></span><span>' + escaparAttr(texto || "Enviando...") + '</span>'
        : escaparAttr(texto || "");
    }

    function escaparAttr(valor) {
      return String(valor === null || valor === undefined ? "" : valor)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }
  </script>
</body>
