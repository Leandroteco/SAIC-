<!DOCTYPE html>
<!--
  SAIC - Cadastro publico de participante
  Aberto por token do evento coletivo. Nao exige conta Google.
-->
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Participante - Evento Coletivo</title>
  <style>
    :root {
      --bg: #eef4f7;
      --surface: #ffffff;
      --ink: #263033;
      --muted: #66747c;
      --line: #d8e4e8;
      --red: #b31f2a;
      --blue: #315f72;
      --green: #2f7d55;
      --shadow: 0 18px 38px rgba(31, 48, 56, 0.10);
      --radius: 8px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: var(--bg);
      color: var(--ink);
      font-family: Arial, Helvetica, sans-serif;
    }

    button,
    input,
    select {
      font: inherit;
    }

    .page {
      width: min(980px, calc(100% - 28px));
      margin: 24px auto;
    }

    .banner {
      position: relative;
      overflow: hidden;
      padding: 26px 28px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: linear-gradient(135deg, #ffffff 0%, #eef6f8 100%);
      box-shadow: var(--shadow);
    }

    .banner::before,
    .banner::after {
      content: "";
      position: absolute;
      left: 0;
      width: 100%;
      height: 8px;
    }

    .banner::before {
      top: 0;
      background: linear-gradient(100deg, var(--red) 0%, rgba(179, 31, 42, 0.7) 34%, transparent 86%);
      clip-path: polygon(0 0, 100% 0, 88% 100%, 0 100%);
    }

    .banner::after {
      bottom: 0;
      background: linear-gradient(280deg, #75848a 0%, rgba(117, 132, 138, 0.62) 36%, transparent 88%);
      clip-path: polygon(12% 0, 100% 0, 100% 100%, 0 100%);
    }

    .eyebrow {
      margin: 0 0 8px;
      color: var(--red);
      font-size: 13px;
      font-weight: 800;
      text-transform: uppercase;
    }

    h1 {
      margin: 0;
      color: var(--ink);
      font-size: clamp(28px, 5vw, 42px);
      line-height: 1.08;
    }

    .subtitle {
      display: block;
      margin-top: 8px;
      color: var(--muted);
      font-weight: 700;
    }

    .status {
      min-height: 22px;
      margin: 16px 0;
      color: var(--muted);
      font-weight: 700;
    }

    .status.error {
      color: #b42318;
    }

    .status.success {
      color: var(--green);
    }

    .card {
      margin-top: 16px;
      padding: 22px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface);
      box-shadow: var(--shadow);
    }

    .event-info {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
      margin-bottom: 18px;
    }

    .info-box {
      padding: 12px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: #f7fbfc;
    }

    .info-box small {
      display: block;
      color: var(--muted);
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
    }

    .info-box strong {
      display: block;
      margin-top: 5px;
      color: var(--ink);
      font-size: 14px;
    }

    h2 {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 0 0 18px;
      color: var(--ink);
      font-size: 19px;
      line-height: 1.2;
    }

    h2::before {
      content: "";
      width: 4px;
      height: 24px;
      border-radius: 999px;
      background: var(--red);
    }

    .grid-3 {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    .field-full {
      grid-column: 1 / -1;
    }

    label {
      display: block;
      margin-bottom: 7px;
      color: var(--ink);
      font-size: 13px;
      font-weight: 800;
    }

    input,
    select {
      width: 100%;
      min-height: 42px;
      padding: 10px 12px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: #ffffff;
      color: var(--ink);
      outline: none;
    }

    input:focus,
    select:focus {
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(49, 95, 114, 0.14);
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 18px;
    }

    .mobile-wizard,
    .mobile-only {
      display: none;
    }

    .mobile-select-trigger,
    .mobile-select-overlay {
      display: none;
    }

    .btn-primary {
      min-height: 46px;
      padding: 12px 18px;
      border: 0;
      border-radius: var(--radius);
      background: var(--blue);
      color: #ffffff;
      cursor: pointer;
      font-weight: 900;
    }

    .btn-secondary {
      min-height: 46px;
      padding: 12px 18px;
      border: 1px solid #c7d7dc;
      border-radius: var(--radius);
      background: #ffffff;
      color: var(--blue);
      cursor: pointer;
      font-weight: 900;
    }

    .btn-primary:disabled {
      cursor: not-allowed;
      opacity: 0.62;
    }

    .saving-inline {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 28px;
      color: var(--muted);
      font-size: 13px;
      font-weight: 800;
    }

    .saving-inline.success {
      color: var(--green);
    }

    .saving-inline.error {
      color: #b42318;
    }

    .saving-spinner {
      width: 16px;
      height: 16px;
      border: 2px solid rgba(49, 95, 114, 0.18);
      border-top-color: var(--blue);
      border-radius: 999px;
      animation: girar 0.8s linear infinite;
    }

    @keyframes girar {
      to {
        transform: rotate(360deg);
      }
    }

    .note {
      margin: 8px 0 0;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.45;
    }

    @media (max-width: 780px), (max-device-width: 780px), (hover: none) and (pointer: coarse) {
      body {
        overflow-x: hidden;
        background: #edf4f6;
      }

      .page {
        width: min(520px, calc(100% - 28px));
        max-width: 520px;
        margin: 0 auto;
        padding: 0 12px 20px;
        zoom: 1.55;
      }

      .banner {
        position: sticky;
        top: 0;
        z-index: 20;
        margin: 0 -12px 12px;
        padding: 18px 18px 20px;
        border: 0;
        border-radius: 0 0 22px 22px;
        background: linear-gradient(145deg, #ffffff 0%, #eef7f9 62%, #e3eef2 100%);
        box-shadow: 0 12px 26px rgba(24, 46, 54, 0.14);
      }

      .banner::before,
      .banner::after {
        height: 5px;
      }

      .eyebrow {
        margin-bottom: 6px;
        font-size: 11px;
        letter-spacing: 0;
      }

      .subtitle {
        margin-top: 8px;
        font-size: 12px;
        line-height: 1.25;
      }

      .status {
        display: none;
        flex: 0 0 auto;
        min-height: 0;
        margin: 0 0 6px;
        padding: 8px 10px;
        border-radius: 12px;
        background: #ffffff;
        font-size: 12px;
        line-height: 1.25;
      }

      .status.error,
      .status.success {
        display: block;
      }

      .card {
        margin-top: 12px;
        padding: 14px;
        border-radius: 18px;
        box-shadow: 0 10px 24px rgba(24, 46, 54, 0.10);
      }

      .event-info {
        display: none;
      }

      .mobile-wizard {
        display: block;
        margin: 4px 0 14px;
        padding: 14px;
        border: 1px solid #dbe7eb;
        border-radius: 16px;
        background: #f7fbfc;
      }

      .wizard-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      .wizard-count {
        min-width: 48px;
        padding: 6px 10px;
        border-radius: 999px;
        background: var(--blue);
        color: #ffffff;
        font-size: 13px;
        font-weight: 900;
        text-align: center;
      }

      .wizard-title {
        color: var(--ink);
        font-size: 17px;
        font-weight: 900;
        text-align: right;
      }

      .wizard-progress {
        height: 8px;
        margin-top: 12px;
        overflow: hidden;
        border-radius: 999px;
        background: #dce9ed;
      }

      .wizard-progress span {
        display: block;
        width: 25%;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, var(--red), var(--blue));
        transition: width 0.2s ease;
      }

      .info-box {
        min-height: 72px;
        padding: 11px 12px;
        border-radius: 14px;
        background: #f7fbfc;
      }

      .info-box small {
        font-size: 11px;
      }

      .info-box strong {
        font-size: 14px;
        overflow-wrap: anywhere;
      }

      h1 {
        font-size: 25px;
      }

      h2 {
        margin-top: 22px;
        margin-bottom: 12px;
        font-size: 16px;
        line-height: 1.2;
      }

      .section-heading {
        display: none;
      }

      .desktop-data-inatividade {
        display: none;
      }

      .grid-3 {
        grid-template-columns: 1fr;
        gap: 12px;
      }

      #conteudo[data-etapa="3"] .grid-dados-participante,
      #conteudo:not([data-etapa="3"]) .grid-endereco-participante {
        display: none;
      }

      .campo-participante {
        display: none;
      }

      #conteudo[data-etapa="1"] .etapa-1,
      #conteudo[data-etapa="2"] .etapa-2,
      #conteudo[data-etapa="3"] .etapa-3,
      #conteudo[data-etapa="4"] .etapa-4 {
        display: block;
      }

      .mobile-oculto {
        display: none !important;
      }

      .ordem-1 { order: 1; }
      .ordem-2 { order: 2; }
      .ordem-3 { order: 3; }
      .ordem-4 { order: 4; }
      .ordem-5 { order: 5; }
      .ordem-6 { order: 6; }
      .ordem-7 { order: 7; }

      .grid-3 > div {
        padding: 10px;
        border: 1px solid #dbe7eb;
        border-radius: 16px;
        background: #f9fcfd;
      }

      label {
        margin-bottom: 8px;
        font-size: 14px;
        line-height: 1.25;
      }

      input,
      select,
      button {
        min-height: 56px;
        padding: 13px 14px;
        border-radius: 13px;
      }

      input,
      select {
        font-size: 17px;
      }

      button {
        font-size: 16px;
      }

      input,
      select {
        border-color: #cfdde2;
        background: #ffffff;
        font-weight: 700;
      }

      select.mobile-select-original {
        display: none !important;
      }

      .mobile-select-trigger {
        display: flex;
        width: 100%;
        min-height: 56px;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 13px 14px;
        border: 1px solid #cfdde2;
        border-radius: 13px;
        background: #ffffff;
        color: var(--ink);
        font-size: 17px;
        font-weight: 700;
        line-height: 1.2;
        text-align: left;
      }

      .mobile-select-trigger::after {
        content: "";
        width: 9px;
        height: 9px;
        flex: 0 0 auto;
        border-right: 2px solid var(--blue);
        border-bottom: 2px solid var(--blue);
        transform: rotate(45deg);
      }

      .mobile-select-trigger.placeholder {
        color: #66747c;
      }

      .mobile-select-trigger.erro {
        border: 2px solid #d32f2f;
      }

      .mobile-select-overlay.ativo {
        display: flex;
      }

      .mobile-select-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        align-items: flex-end;
        padding: 18px;
        background: rgba(15, 23, 42, 0.46);
      }

      .mobile-select-panel {
        width: 100%;
        max-height: min(76vh, 620px);
        overflow: hidden;
        border-radius: 22px;
        background: #ffffff;
        box-shadow: 0 -18px 42px rgba(15, 23, 42, 0.24);
      }

      .mobile-select-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 16px 18px;
        border-bottom: 1px solid #dbe7eb;
      }

      .mobile-select-header strong {
        color: var(--ink);
        font-size: 18px;
        line-height: 1.2;
      }

      .mobile-select-header button {
        min-height: 40px;
        padding: 8px 12px;
        border: 1px solid #cfdde2;
        border-radius: 12px;
        background: #f7fbfc;
        color: var(--blue);
        font-size: 14px;
        font-weight: 900;
      }

      .mobile-select-options {
        max-height: calc(min(76vh, 620px) - 74px);
        overflow-y: auto;
        padding: 8px;
        -webkit-overflow-scrolling: touch;
      }

      .mobile-select-option {
        display: flex;
        width: 100%;
        min-height: 54px;
        align-items: center;
        justify-content: space-between;
        padding: 13px 14px;
        border: 0;
        border-radius: 14px;
        background: #ffffff;
        color: var(--ink);
        font-size: 16px;
        font-weight: 800;
        text-align: left;
      }

      .mobile-select-option + .mobile-select-option {
        margin-top: 4px;
      }

      .mobile-select-option.selecionado {
        background: #e7f1f4;
        color: var(--blue);
      }

      .mobile-select-option.placeholder {
        color: #66747c;
      }

      input:focus,
      select:focus {
        box-shadow: 0 0 0 4px rgba(49, 95, 114, 0.16);
      }

      .actions {
        display: grid;
        grid-template-columns: 1fr 1.3fr;
        gap: 12px;
        position: sticky;
        bottom: 0;
        z-index: 18;
        margin: 20px -14px -14px;
        padding: 12px 14px calc(12px + env(safe-area-inset-bottom));
        border-top: 1px solid #dbe7eb;
        border-radius: 0 0 18px 18px;
        background: rgba(249, 252, 253, 0.96);
        backdrop-filter: blur(10px);
      }

      body.android .actions {
        position: static;
        z-index: auto;
        margin: 20px 0 0;
        padding: 12px 0 0;
        border-radius: 18px;
        background: transparent;
        backdrop-filter: none;
      }

      body.android .actions button {
        pointer-events: auto;
      }

      #conteudo[data-etapa="1"] .actions {
        grid-template-columns: 1fr;
      }

      .mobile-only {
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      #btnEnviar {
        display: none;
      }

      #conteudo[data-etapa="1"] #btnVoltarEtapa,
      #conteudo[data-etapa="4"] #btnAvancarEtapa {
        display: none;
      }

      #conteudo[data-etapa="4"] #btnEnviar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .btn-primary {
        width: 100%;
        min-height: 58px;
        border-radius: 15px;
        box-shadow: 0 12px 24px rgba(49, 95, 114, 0.22);
      }

      .btn-secondary {
        width: 100%;
        min-height: 58px;
        border-radius: 15px;
      }

      .saving-inline {
        grid-column: 1 / -1;
        width: 100%;
        min-height: 22px;
        justify-content: center;
        text-align: center;
      }

      .note {
        display: none;
      }

      @supports not (zoom: 1) {
        .page {
          transform: scale(1.55);
          transform-origin: top center;
          margin-bottom: 260px;
        }
      }
    }

    @media (max-width: 430px), (max-device-width: 430px) {
      .event-info {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .banner {
        border-radius: 0 0 18px 18px;
      }

      .card {
        border-radius: 16px;
      }

      .info-box {
        min-height: 68px;
        padding: 10px;
      }

      h1 {
        font-size: 23px;
      }
    }
  </style>
</head>

<body>
  <main class="page">
    <header class="banner">
      <p class="eyebrow">Evento Coletivo</p>
      <h1 id="tituloEvento">Cadastro de Participante</h1>
      <span class="subtitle">Sistema de Gest&atilde;o dos Atendimentos do SiSMen</span>
    </header>

    <div id="statusPagina" class="status">Carregando evento...</div>

    <section id="conteudo" class="card" data-etapa="1" style="display:none;">
      <div class="event-info">
        <div class="info-box">
          <small>Tipo</small>
          <strong id="infoTipo">-</strong>
        </div>
        <div class="info-box">
          <small>Data</small>
          <strong id="infoData">-</strong>
        </div>
        <div class="info-box">
          <small>NAPS</small>
          <strong id="infoNaps">-</strong>
        </div>
        <div class="info-box">
          <small>Tema</small>
          <strong id="infoTema">-</strong>
        </div>
      </div>

      <div class="mobile-wizard" aria-live="polite">
        <div class="wizard-row">
          <span id="contadorEtapaMobile" class="wizard-count">1/4</span>
          <strong id="tituloEtapaMobile" class="wizard-title">Identifica&ccedil;&atilde;o</strong>
        </div>
        <div class="wizard-progress"><span id="barraEtapaMobile"></span></div>
      </div>

      <h2 class="section-heading">Dados Pessoais e Funcionais</h2>
      <div class="grid-3 grid-dados-participante">
        <div class="campo-participante etapa-2 ordem-1">
          <label for="postoGraduacao">Posto/Gradua&ccedil;&atilde;o</label>
          <select id="postoGraduacao">
            <option value="">Selecione</option>
            <option>Sd PM</option>
            <option>Cb PM</option>
            <option>3&ordm; Sgt PM</option>
            <option>2&ordm; Sgt PM</option>
            <option>1&ordm; Sgt PM</option>
            <option>Subten PM</option>
            <option>Asp of PM</option>
            <option>2&ordm; Ten PM</option>
            <option>1&ordm; Ten PM</option>
            <option>Cap PM</option>
            <option>Maj PM</option>
            <option>Ten Cel PM</option>
            <option>Cel PM</option>
          </select>
        </div>
        <div class="campo-participante etapa-2 ordem-2">
          <label for="re">R.E.</label>
          <input id="re" type="text" placeholder="000000-0" oninput="mascaraRE(this)">
        </div>
        <div class="campo-participante etapa-1 ordem-2">
          <label for="cpf">CPF</label>
          <input id="cpf" type="text" placeholder="000.000.000-00" oninput="mascaraCPF(this)">
        </div>
        <div class="field-full campo-participante etapa-1 ordem-1">
          <label for="nome">Nome</label>
          <input id="nome" type="text" oninput="converterMaiusculasSemAcento(this)" required>
        </div>
        <div class="campo-participante etapa-2 ordem-4">
          <label for="situacaoStatus">Situa&ccedil;&atilde;o/Status</label>
          <select id="situacaoStatus">
            <option value="">Selecione</option>
            <option>agregado(a)</option>
            <option>ativo administrativo</option>
            <option>ativo operacional</option>
            <option>exonerado(a)</option>
            <option>inativo</option>
          </select>
        </div>
        <div class="campo-participante etapa-4 ordem-2">
          <label for="email">E-mail</label>
          <input id="email" type="email" list="sugestoesEmail" oninput="sugerirDominioEmail(this)">
          <datalist id="sugestoesEmail"></datalist>
        </div>
        <div class="campo-participante etapa-4 ordem-1">
          <label for="telefone">Telefone</label>
          <input id="telefone" type="text" placeholder="(00) 00000-0000" oninput="mascaraTelefone(this)">
        </div>
        <div class="campo-participante etapa-2 ordem-5">
          <label for="dataIngresso">Data de ingresso</label>
          <input id="dataIngresso" type="text" inputmode="numeric" maxlength="10" placeholder="dd/mm/aaaa" oninput="mascaraDataBrasil(this)" onblur="validarAnoDataCampo(this)">
        </div>
        <div class="campo-participante etapa-1 ordem-4">
          <label for="dataNascimento">Data de nascimento</label>
          <input id="dataNascimento" type="text" inputmode="numeric" maxlength="10" placeholder="dd/mm/aaaa" oninput="mascaraDataBrasil(this)" onblur="validarAnoDataCampo(this)">
        </div>
        <div class="campo-participante etapa-1 ordem-3">
          <label for="sexo">Sexo</label>
          <select id="sexo">
            <option value="">Selecione</option>
            <option>masculino</option>
            <option>feminino</option>
          </select>
        </div>
        <div class="campo-participante etapa-2 ordem-3">
          <label for="opmAtual">OPM atual</label>
          <input id="opmAtual" type="text" list="listaOPM" placeholder="Digite ou selecione a OPM" oninput="converterMaiusculasSemAcento(this)">
          <datalist id="listaOPM">
  <option value="1.BAEP">1.BAEP</option>
<option value="1.BPAMB">1.BPAMB</option>
<option value="1.BPCHQ">1.BPCHQ</option>
<option value="1.BPM/I">1.BPM/I</option>
<option value="1.BPM/M">1.BPM/M</option>
<option value="1.BPRV">1.BPRV</option>
<option value="1.BPTRAN">1.BPTRAN</option>
<option value="1.EM/PM">1.EM/PM</option>
<option value="1.GB">1.GB</option>
<option value="10.BAEP">10.BAEP</option>
<option value="10.BPM/I">10.BPM/I</option>
<option value="10.BPM/M">10.BPM/M</option>
<option value="10.GB">10.GB</option>
<option value="11.BAEP">11.BAEP</option>
<option value="11.BPM/I">11.BPM/I</option>
<option value="11.BPM/M">11.BPM/M</option>
<option value="11.GB">11.GB</option>
<option value="12.BAEP">12.BAEP</option>
<option value="12.BPM/I">12.BPM/I</option>
