<!DOCTYPE html>
<!--
  SAIC - Incidente Critico
  Tela disponivel para usuarios autorizados do sistema.
-->
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <base target="_top">
  <title>Incidente Cr&iacute;tico - SiSMen</title>
  <style>
    :root {
      --bg: #eef4f7;
      --surface: #ffffff;
      --surface-soft: #f7fbfc;
      --ink: #263033;
      --muted: #66747c;
      --line: #d8e4e8;
      --red: #b31f2a;
      --red-soft: #f5e1e3;
      --blue: #315f72;
      --blue-soft: #dbeef5;
      --green: #2f7d55;
      --shadow: 0 18px 38px rgba(31, 48, 56, 0.10);
      --radius: 8px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: Arial, Helvetica, sans-serif;
      margin: 0;
      min-height: 100vh;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    button {
      border: 0;
      cursor: pointer;
      font-weight: 800;
    }

    button:disabled {
      cursor: not-allowed;
      opacity: 0.62;
    }

    label {
      color: var(--ink);
      display: block;
      font-size: 13px;
      font-weight: 800;
      margin-bottom: 7px;
    }

    input,
    select,
    textarea {
      background: #ffffff;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      color: var(--ink);
      min-height: 42px;
      outline: none;
      padding: 10px 12px;
      width: 100%;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(49, 95, 114, 0.14);
    }

    input[readonly] {
      background: var(--surface-soft);
      color: var(--muted);
      font-weight: 800;
    }

    .app-shell {
      display: grid;
      grid-template-columns: 250px minmax(0, 1fr);
      min-height: 100vh;
    }

    .sidebar {
      background: linear-gradient(180deg, #26373d 0%, #37545e 62%, #4a6870 100%);
      color: #ffffff;
      height: 100vh;
      overflow-y: auto;
      padding: 24px 18px;
      position: sticky;
      top: 0;
    }

    .sidebar::after {
      background: linear-gradient(180deg, transparent, rgba(179, 31, 42, 0.78), transparent);
      content: "";
      height: 100%;
      position: absolute;
      right: 0;
      top: 0;
      width: 2px;
    }

    .brand {
      border-bottom: 1px solid rgba(255, 255, 255, 0.16);
      padding-bottom: 22px;
    }

    .brand strong {
      display: block;
      font-size: 20px;
      line-height: 1.1;
    }

    .brand span {
      color: rgba(255, 255, 255, 0.76);
      display: block;
      font-size: 12px;
      margin-top: 4px;
    }

    .side-nav {
      display: grid;
      gap: 8px;
      margin-top: 26px;
    }

    .side-nav button {
      background: transparent;
      border-radius: var(--radius);
      color: rgba(255, 255, 255, 0.84);
      min-height: 42px;
      padding: 10px 12px;
      text-align: left;
    }

    .side-nav button.active,
    .side-nav button:hover {
      background: rgba(255, 255, 255, 0.14);
      color: #ffffff;
    }

    .side-nav-separator {
      background: rgba(255, 255, 255, 0.16);
      height: 1px;
      margin: 10px 0;
    }

    .side-nav button.nav-voltar {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.18);
      color: #ffffff;
    }

    .content {
      min-width: 0;
      padding: 28px;
    }

    .page-banner {
      background: linear-gradient(135deg, #ffffff 0%, #eef6f8 100%);
      border: 1px solid rgba(216, 228, 232, 0.8);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      min-height: 142px;
      overflow: hidden;
      padding: 28px 30px;
      position: relative;
    }

    .page-banner::before,
    .page-banner::after {
      content: "";
      height: 8px;
      left: 0;
      pointer-events: none;
      position: absolute;
      width: 100%;
    }

    .page-banner::before {
      background: linear-gradient(100deg, var(--red) 0%, rgba(179, 31, 42, 0.7) 34%, transparent 86%);
      clip-path: polygon(0 0, 100% 0, 88% 100%, 0 100%);
      top: 0;
    }

    .page-banner::after {
      background: linear-gradient(280deg, #75848a 0%, rgba(117, 132, 138, 0.62) 36%, transparent 88%);
      bottom: 0;
      clip-path: polygon(12% 0, 100% 0, 100% 100%, 0 100%);
    }

    .banner-content {
      align-items: center;
      display: flex;
      gap: 20px;
      justify-content: space-between;
      position: relative;
      z-index: 1;
    }

    .eyebrow {
      color: var(--red);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0;
      margin: 0 0 8px;
      text-transform: uppercase;
    }

    .page-banner h1 {
      color: var(--ink);
      font-size: clamp(30px, 4vw, 44px);
      letter-spacing: 0;
      line-height: 1.08;
      margin: 0;
    }

    .page-banner span {
      color: var(--muted);
      display: block;
      font-weight: 700;
      margin-top: 8px;
    }

    .summary-card {
      background: rgba(255, 255, 255, 0.88);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      min-width: 230px;
      padding: 16px;
    }

    .summary-card small {
      color: var(--muted);
      display: block;
      font-weight: 800;
    }

    .summary-card strong {
      color: var(--ink);
      display: block;
      font-size: 18px;
      margin-top: 6px;
    }

    .status-line {
      color: var(--muted);
      font-size: 14px;
      font-weight: 700;
      margin: 18px 0;
      min-height: 22px;
    }

    .status-line.error {
      color: #b42318;
    }

    .status-line.success {
      color: var(--green);
    }

    .section {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      margin-top: 18px;
      padding: 22px;
    }

    .section-title {
      align-items: center;
      color: var(--ink);
      display: flex;
      font-size: 19px;
      gap: 10px;
      line-height: 1.2;
      margin: 0 0 18px;
    }

    .section-title::before {
      background: var(--red);
      border-radius: 999px;
      content: "";
      height: 24px;
      width: 4px;
    }

    .grid-2,
    .grid-3,
    .grid-4 {
      display: grid;
      gap: 16px;
    }

    .grid-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .grid-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .grid-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .field-span-2 {
      grid-column: span 2;
    }

    .check-field {
      background: var(--surface-soft);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      min-height: 42px;
      padding: 10px 12px;
    }

    .check-field > label {
      margin-bottom: 8px;
    }

    .checkbox-row {
      display: flex;
      flex-direction: column;
      flex-wrap: wrap;
      gap: 8px;
    }

    .checkbox-option {
      align-items: center;
      color: var(--ink);
      display: flex;
      font-size: 13px;
      font-weight: 800;
      gap: 7px;
      margin: 0;
    }

    .checkbox-option input {
      min-height: auto;
      width: auto;
    }

    .actions {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 18px;
    }

    .btn-primary {
      background: var(--blue);
      border-radius: var(--radius);
      box-shadow: 0 10px 20px rgba(49, 95, 114, 0.16);
      color: #ffffff;
      min-height: 44px;
      padding: 11px 16px;
    }

    .btn-secondary {
      background: #ffffff;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      color: var(--ink);
      min-height: 44px;
      padding: 11px 16px;
    }

    .saving-inline {
      align-items: center;
      color: var(--muted);
      display: inline-flex;
      font-size: 13px;
      font-weight: 800;
      gap: 8px;
      min-height: 28px;
    }

    .saving-inline.success {
      color: var(--green);
    }

    .saving-inline.error {
      color: #b42318;
    }

    .saving-spinner,
    .navegacao-spinner {
      animation: girar 0.8s linear infinite;
      border-radius: 999px;
      border-style: solid;
    }

    .saving-spinner {
      border-color: rgba(49, 95, 114, 0.18);
      border-top-color: var(--blue);
      border-width: 2px;
      height: 16px;
      width: 16px;
    }

    @keyframes girar {
      to {
        transform: rotate(360deg);
      }
    }

    .navegacao-overlay {
      align-items: center;
      background: rgba(15, 23, 42, 0.42);
      display: none;
      inset: 0;
      justify-content: center;
      padding: 22px;
      position: fixed;
      z-index: 150;
    }

    .navegacao-card {
      align-items: center;
      background: #ffffff;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: 0 24px 60px rgba(15, 23, 42, 0.24);
      color: var(--ink);
      display: inline-flex;
      gap: 12px;
      min-width: 260px;
      padding: 18px 22px;
    }

    .navegacao-spinner {
      border-color: rgba(49, 95, 114, 0.18);
      border-top-color: var(--blue);
      border-width: 3px;
      height: 22px;
      width: 22px;
    }

    .navegacao-card strong {
      font-size: 15px;
      font-weight: 900;
    }

    .required-note {
      color: var(--muted);
      font-size: 12px;
      line-height: 1.45;
      margin: 8px 0 0;
    }

    @media (max-width: 980px) {
      .app-shell {
        grid-template-columns: 1fr;
      }

      .sidebar {
        height: auto;
        position: relative;
      }

      .content {
        padding: 18px;
      }

      .banner-content {
        align-items: stretch;
        flex-direction: column;
      }

      .grid-2,
      .grid-3,
      .grid-4,
      .field-span-2 {
        grid-column: 1 / -1;
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 620px) {
      body {
        font-size: 16px;
        line-height: 1.5;
      }

      input,
      select,
      textarea,
      button {
        font-size: 16px;
        min-height: 52px;
        padding: 13px 14px;
      }
    }
  </style>
</head>

<body>
  <div id="navegacaoOverlay" class="navegacao-overlay" aria-live="polite" aria-label="Carregando pagina">
    <div class="navegacao-card">
      <span class="navegacao-spinner"></span>
      <strong id="navegacaoMensagem">Carregando...</strong>
    </div>
  </div>

