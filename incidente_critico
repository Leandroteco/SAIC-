        <button type="button" class="active">Incidente Cr&iacute;tico</button>
        <div class="side-nav-separator" aria-hidden="true"></div>
        <button id="nav-voltar-atendimento" type="button" class="nav-voltar" onclick="voltarAoAtendimento()">Voltar ao Atendimento</button>
      </nav>
    </aside>

    <main class="content">
      <header class="page-banner">
        <div class="banner-content">
          <div>
            <p class="eyebrow">Incidente Cr&iacute;tico</p>
