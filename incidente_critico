  <script>
    const webAppUrl = "<?= webAppUrl ?>";
    let tokenGoogle = "<?= tokenGoogleInicial ?>";
    let usuarioLogado = <?!= usuarioInicialJson ?>;
    let mensagemLoginInicial = <?!= JSON.stringify(mensagemLoginInicial || "") ?>;

    window.addEventListener("load", function() {
      if (!tokenGoogle || !usuarioLogado || !usuarioLogado.autorizado) {
        mostrarStatus(mensagemLoginInicial || "Abra Incidente Cr\u00edtico pelo menu do formulario.", "error");
        bloquearTela();
        return;
      }

      document.getElementById("resumoResponsavel").innerText = formatarResponsavelSistema(usuarioLogado.nome || usuarioLogado.email || "Responsavel");
      document.getElementById("resumoNaps").innerText = usuarioLogado.naps || "NAPS nao informado";
      preencherPsicologoResponsavel();
      preencherDatasIncidenteSeVazias();
      carregarNumeroRelatorioIncidente();
      carregarOpcoesEquipeIncidente();
      registrarLimpezaStatusAoEditar();
      mostrarStatus("Pronto para registrar incidente critico.", "");
    });

    function voltarAoAtendimento() {
      if (!tokenGoogle || !webAppUrl) {
        mostrarStatus("Sessao expirada. Acesse novamente pelo formulario.", "error");
        return;
      }

      const botao = document.getElementById("nav-voltar-atendimento");
      if (botao) {
        botao.disabled = true;
        botao.innerText = "Carregando Atendimento...";
      }

      mostrarCarregamentoNavegacao("Carregando Atendimento...");

      const form = document.createElement("form");
      form.method = "post";
      form.action = webAppUrl;
      form.target = "_top";
      form.style.display = "none";

      const campoToken = document.createElement("input");
      campoToken.type = "hidden";
      campoToken.name = "credential";
      campoToken.value = tokenGoogle;

      const campoDestino = document.createElement("input");
      campoDestino.type = "hidden";
      campoDestino.name = "state";
      campoDestino.value = "index";

      form.appendChild(campoToken);
      form.appendChild(campoDestino);
      document.body.appendChild(form);

      setTimeout(function() {
        form.submit();
        form.remove();
      }, 80);
    }

    function salvarIncidente() {
      if (!validarFormularioIncidente()) return;

      definirStatusSalvar(true, "Salvando incidente cr\u00edtico...");

      google.script.run
        .withSuccessHandler(function(retorno) {
          definirStatusSalvar(false, "Salvo.", "success");
          limparFormularioIncidente();
          carregarNumeroRelatorioIncidente();
          mostrarStatus(retorno && retorno.mensagem ? retorno.mensagem : "Incidente Cr\u00edtico salvo com sucesso.", "success");
        })
        .withFailureHandler(function(erro) {
          definirStatusSalvar(false, obterMensagemErro(erro), "error");
          mostrarStatus(obterMensagemErro(erro), "error");
        })
        .salvarIncidenteCritico(montarDadosIncidente(), tokenGoogle);
    }

    function montarDadosIncidente() {
      return {
        numeroRelatorio: valorCampo("numeroRelatorio"),
        dataFato: valorDataCampo("dataFato"),
        dataAcionamento: valorDataCampo("dataAcionamento"),
        postoGraduacao: valorCampo("postoGraduacao"),
        re: valorCampo("re"),
        nome: valorCampo("nome"),
        opmAtual: valorCampo("opmAtual"),
        situacaoStatus: valorCampo("situacaoStatus"),
        oficialSobreaviso: valorCampo("oficialSobreaviso"),
        psicologo: valorCampo("psicologo"),
        assistenteSocial: valorCampo("assistenteSocial"),
        motorista: valorCampo("motorista"),
        vitima: valorCampo("vitima"),
        sexo: valorCampo("sexo"),
        modalidade: valorCampo("modalidade"),
        servico: obterServicoIncidente()
      };
    }

    function validarFormularioIncidente() {
      const idsObrigatorios = [
        "dataFato",
        "dataAcionamento",
        "postoGraduacao",
        "re",
        "nome",
        "opmAtual",
        "situacaoStatus",
        "vitima",
        "sexo",
        "modalidade"
      ];
      const camposComErro = [];

      document.querySelectorAll("input, select, textarea").forEach(limparErroVisualCampo);

      idsObrigatorios.forEach(function(id) {
        const campo = document.getElementById(id);

        if (campo && !campo.value.trim()) {
          marcarCampoObrigatorio(campo);
          camposComErro.push(campo);
        }
      });

      if (!validarDatasFormulario(["dataFato", "dataAcionamento"], ["dataFato", "dataAcionamento"])) {
        camposComErro.push(document.getElementById("dataFato"));
      }

      if (camposComErro.length > 0) {
        mostrarStatus("Preencha os campos obrigatorios destacados.", "error");
        camposComErro[0].focus();
        return false;
      }

      return true;
    }

    function limparFormularioIncidente() {
      document.querySelectorAll("input, select, textarea").forEach(function(campo) {
        if (campo.id === "numeroRelatorio" || campo.id === "psicologo") return;

        if (campo.type === "checkbox") {
          campo.checked = false;
        } else {
          campo.value = "";
        }

        limparErroVisualCampo(campo);
      });

      preencherPsicologoResponsavel();
      preencherDatasIncidenteSeVazias();
    }

    function carregarNumeroRelatorioIncidente() {
      const campo = document.getElementById("numeroRelatorio");
      if (campo) campo.value = "Carregando...";

      google.script.run
        .withSuccessHandler(function(retorno) {
          if (campo) {
            campo.value = retorno && retorno.numeroRelatorio
              ? retorno.numeroRelatorio
              : "Gerado ao salvar";
          }
        })
        .withFailureHandler(function() {
          if (campo) campo.value = "Gerado ao salvar";
        })
        .obterNumeroRelatorioIncidenteCritico(tokenGoogle);
    }

    function preencherDatasIncidenteSeVazias() {
      const hoje = formatarDataBrasil(new Date());
      const campos = ["dataFato", "dataAcionamento"];

      campos.forEach(function(id) {
        const campo = document.getElementById(id);
        if (campo && !campo.value.trim()) campo.value = hoje;
      });
    }

    function formatarDataBrasil(data) {
      const dia = String(data.getDate()).padStart(2, "0");
      const mes = String(data.getMonth() + 1).padStart(2, "0");
      const ano = data.getFullYear();

      return dia + "/" + mes + "/" + ano;
    }

    function alternarServicoFolga(campoMarcado) {
      if (!campoMarcado || !campoMarcado.checked) return;

      ["servico", "folga", "inTinere"].forEach(function(id) {
        const campo = document.getElementById(id);
        if (campo && campo !== campoMarcado) campo.checked = false;
      });
    }

    function obterServicoIncidente() {
      if (document.getElementById("servico") && document.getElementById("servico").checked) return "servico";
      if (document.getElementById("folga") && document.getElementById("folga").checked) return "folga";
      if (document.getElementById("inTinere") && document.getElementById("inTinere").checked) return "in tinere";

      return "";
    }

    function preencherPsicologoResponsavel() {
      const campo = document.getElementById("psicologo");
      if (!campo) return;

      campo.value = usuarioLogado && (usuarioLogado.nome || usuarioLogado.email)
        ? formatarResponsavelSistema(usuarioLogado.nome || usuarioLogado.email)
        : "";
      limparErroVisualCampo(campo);
    }

    function formatarResponsavelSistema(texto) {
      const original = String(texto || "").trim();
      const conectivos = {
        "da": true,
        "de": true,
        "do": true,
        "das": true,
        "dos": true,
        "e": true
      };

      if (!original) return "";
      if (original.indexOf("@") >= 0) return original.toLowerCase();

      return original
        .toLowerCase()
        .split(/\s+/)
        .map(function(parte, indice) {
          const limpa = parte.normalize("NFD").replace(/[\u0300-\u036f]/g, "");

          if (limpa === "pm") return "PM";
          if (indice > 0 && conectivos[limpa]) return limpa;
          if (/^\d/.test(parte)) return parte.replace(/[a-zA-Z]+/g, function(trecho) {
            return trecho.charAt(0).toUpperCase() + trecho.slice(1);
          });

          return parte.charAt(0).toUpperCase() + parte.slice(1);
        })
        .join(" ");
    }

    function carregarOpcoesEquipeIncidente() {
      google.script.run
        .withSuccessHandler(function(opcoes) {
          popularListaEquipeIncidente("listaOficialSobreaviso", opcoes && opcoes.oficialSobreaviso);
          popularListaEquipeIncidente("listaAssistenteSocial", opcoes && opcoes.assistenteSocial);
          popularListaEquipeIncidente("listaMotorista", opcoes && opcoes.motorista);
        })
        .withFailureHandler(function() {})
        .obterOpcoesEquipeIncidente(tokenGoogle);
    }

    function popularListaEquipeIncidente(idLista, nomes) {
      const lista = document.getElementById(idLista);
      if (!lista) return;

      lista.innerHTML = "";
      (nomes || []).forEach(function(nome) {
        const option = document.createElement("option");
        option.value = nome;
        lista.appendChild(option);
      });
    }

    function registrarLimpezaStatusAoEditar() {
      document.querySelectorAll("input, select, textarea").forEach(function(campo) {
        campo.addEventListener("input", limparStatusOperacao);
        campo.addEventListener("change", limparStatusOperacao);
      });
    }

    function limparStatusOperacao() {
      mostrarStatus("", "");
      definirStatusSalvar(false, "");
    }

    function bloquearTela() {
      document.querySelectorAll("input, select, textarea, button:not(#nav-voltar-atendimento)").forEach(function(campo) {
        campo.disabled = true;
      });
    }

    function mostrarCarregamentoNavegacao(texto) {
      const overlay = document.getElementById("navegacaoOverlay");
      const mensagem = document.getElementById("navegacaoMensagem");

      if (mensagem) mensagem.innerText = texto || "Carregando...";
      if (overlay) overlay.style.display = "flex";
    }

    function definirStatusSalvar(salvando, texto, tipo) {
      const el = document.getElementById("statusSalvarIncidente");
      const botao = document.getElementById("btnSalvarIncidente");

      if (botao) botao.disabled = salvando;
      if (!el) return;

      el.className = "saving-inline" + (tipo ? " " + tipo : "");
      el.innerHTML = salvando
        ? '<span class="saving-spinner"></span><span>' + escaparHtml(texto || "Salvando...") + '</span>'
        : escaparHtml(texto || "");
    }

    function valorCampo(id) {
      const campo = document.getElementById(id);
      return campo ? campo.value.trim() : "";
    }

    function valorDataCampo(id) {
      const campo = document.getElementById(id);
      return campo ? converterDataBrasilParaISO(campo.value) : "";
    }

    function converterMaiusculasSemAcento(campo) {
      campo.value = String(campo.value || "")
        .toUpperCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");
    }

    function mascaraRE(campo) {
      let valor = campo.value.toUpperCase().replace(/[^0-9A]/g, "");
      let numerosAntesHifen = "";
      let digitoFinal = "";

      for (let i = 0; i < valor.length; i++) {
        const caractere = valor.charAt(i);

        if (numerosAntesHifen.length < 6) {
          if (/[0-9]/.test(caractere)) numerosAntesHifen += caractere;
          continue;
        }

        if (!digitoFinal && /[0-9A]/.test(caractere)) {
          digitoFinal = caractere;
          break;
        }
      }

      campo.value = digitoFinal ? numerosAntesHifen + "-" + digitoFinal : numerosAntesHifen;
    }

    function mascaraDataBrasil(campo) {
      let valor = campo.value.replace(/\D/g, "").substring(0, 8);

      valor = valor.replace(/(\d{2})(\d)/, "$1/$2");
      valor = valor.replace(/(\d{2})(\d)/, "$1/$2");

      campo.value = valor;
    }

    function validarAnoDataCampo(campo) {
      if (!campo.value) {
        limparErroVisualCampo(campo);
        return true;
      }

      if (dataBrasilValida(campo.value)) {
        limparErroVisualCampo(campo);
        return true;
      }

      campo.style.border = "2px solid #d32f2f";
      return false;
    }

    function validarDatasFormulario(ids, obrigatorios) {
      const obrigatoriosMapa = {};
      let valido = true;

      (obrigatorios || []).forEach(function(id) {
        obrigatoriosMapa[id] = true;
      });

      ids.forEach(function(id) {
        const campo = document.getElementById(id);
        if (!campo) return;

        if (obrigatoriosMapa[id] && !campo.value.trim()) {
          campo.style.border = "2px solid #d32f2f";
          valido = false;
          return;
        }

        if (!validarAnoDataCampo(campo)) {
          valido = false;
        }
      });

      if (!valido) {
        mostrarStatus("Confira as datas no formato dd/mm/aaaa.", "error");
      }

      return valido;
    }

    function dataBrasilValida(valor) {
      const partes = String(valor || "").trim().match(/^(\d{2})\/(\d{2})\/(\d{4})$/);

      if (!partes) return false;

      const dia = Number(partes[1]);
      const mes = Number(partes[2]);
      const ano = Number(partes[3]);

      if (ano < 1 || ano > 9999 || mes < 1 || mes > 12 || dia < 1) return false;

      const data = new Date(ano, mes - 1, dia);

      return data.getFullYear() === ano &&
        data.getMonth() === mes - 1 &&
        data.getDate() === dia;
    }

    function converterDataBrasilParaISO(valor) {
      const partes = String(valor || "").trim().match(/^(\d{2})\/(\d{2})\/(\d{4})$/);

      if (!partes) return "";

      return partes[3] + "-" + partes[2] + "-" + partes[1];
    }

    function limparErroVisualCampo(campo) {
      if (!campo) return;
      campo.style.border = "1px solid var(--line)";
    }

    function marcarCampoObrigatorio(campo) {
      if (!campo) return;
      campo.style.border = "2px solid #d32f2f";
    }

    function mostrarStatus(mensagem, tipo) {
      const el = document.getElementById("statusTela");
      el.className = "status-line" + (tipo ? " " + tipo : "");
      el.innerText = mensagem || "";
    }

    function obterMensagemErro(erro) {
      return erro && erro.message ? erro.message : "Nao foi possivel concluir a operacao.";
    }

    function escaparHtml(valor) {
      return String(valor === null || valor === undefined ? "" : valor)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }
  </script>
