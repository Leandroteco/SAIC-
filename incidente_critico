          limparStatusOperacao();
          if (deveOcultarFicha) ocultarBotaoFichaIncidente();
        });

        campo.addEventListener("change", function() {
          if (deveOcultarFicha) marcarAlteracaoPendenteNavegacao();
          limparStatusOperacao();
          if (deveOcultarFicha) ocultarBotaoFichaIncidente();
        });
      });
