  <script>
    const webAppUrl = "<?= webAppUrl ?>";
    let tokenGoogle = "<?= tokenGoogleInicial ?>";
    let usuarioLogado = <?!= usuarioInicialJson ?>;
    let mensagemLoginInicial = <?!= JSON.stringify(mensagemLoginInicial || "") ?>;
    let ultimoIncidenteSalvoNumero = "";
    let ultimosIncidentesCarregados = false;
    let ultimosIncidentesCarregando = false;
    let navegacaoAlteracoesPendentes = false;

    window.addEventListener("load", function() {
      if (!tokenGoogle || !usuarioLogado || !usuarioLogado.autorizado) {
        mostrarStatus(mensagemLoginInicial || "Abra Incidente Cr\u00edtico pelo menu do formulario.", "error");
        bloquearTela();
        return;
      }

      preencherPsicologoResponsavel();
      preencherDatasIncidenteSeVazias();
      carregarNumeroRelatorioIncidente();
      carregarOpcoesEquipeIncidente();
      configurarMenuPrincipalPorPerfil();
      registrarLimpezaStatusAoEditar();
      atualizarEscalaPorSituacao();
      mostrarStatus("Pronto para registrar incidente critico.", "");
    });

    document.addEventListener("click", function(evento) {
      const wrapper = document.querySelector(".ultimos-incidentes-wrapper");

      if (wrapper && !wrapper.contains(evento.target)) {
        fecharUltimosIncidentes();
      }
    });

    function usuarioPodeAcessarPPMS() {
      const valor = usuarioLogado && usuarioLogado.acessoPpms;

      return valor === true ||
        String(valor || "")
          .toLowerCase()
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .trim() === "sim";
    }

    function configurarMenuPrincipalPorPerfil() {
      const botaoPPMS = document.getElementById("btnNavPPMS");

      if (botaoPPMS) {
        botaoPPMS.style.display = usuarioPodeAcessarPPMS() ? "" : "none";
      }
    }

    function navegarModuloPrincipal(pagina) {
      if (pagina === "incidente_critico") return;

      if (!tokenGoogle || !webAppUrl) {
        mostrarStatus("Sessao expirada. Acesse novamente pelo formulario.", "error");
        return;
      }

      if (pagina === "ppms" && !usuarioPodeAcessarPPMS()) {
        mostrarStatus("Recurso disponivel somente para usuarios autorizados.", "error");
        return;
      }

      if (!confirmarNavegacaoComAlteracoesPendentes()) return;

      mostrarCarregamentoNavegacao(obterMensagemCarregamentoModulo(pagina));

      const form = document.createElement("form");
      form.method = "post";
      form.action = webAppUrl;
      form.target = "_top";
      form.style.display = "none";

      const campoToken = document.createElement("input");
      campoToken.type = "hidden";
      campoToken.name = "credential";
      campoToken.value = tokenGoogle;

      const campoDestino = document.createElement("input");
      campoDestino.type = "hidden";
      campoDestino.name = "state";
      campoDestino.value = pagina;

      form.appendChild(campoToken);
      form.appendChild(campoDestino);
      document.body.appendChild(form);

      setTimeout(function() {
        form.submit();
        form.remove();
      }, 80);
    }

    function obterMensagemCarregamentoModulo(pagina) {
      const mensagens = {
        index: "Carregando Atendimento...",
        eventos_coletivos: "Carregando Grupos e Palestras...",
        ppms: "Carregando PPMS..."
      };

      return mensagens[pagina] || "Carregando...";
    }

    function confirmarNavegacaoComAlteracoesPendentes() {
      if (!navegacaoAlteracoesPendentes) return true;

      return window.confirm("Há dados preenchidos que ainda não foram salvos. Deseja sair mesmo assim?");
    }

    function marcarAlteracaoPendenteNavegacao() {
      navegacaoAlteracoesPendentes = true;
    }

    function limparAlteracaoPendenteNavegacao() {
      navegacaoAlteracoesPendentes = false;
    }

    function salvarIncidente() {
      if (!validarFormularioIncidente()) return;

      definirStatusSalvar(true, "Salvando incidente cr\u00edtico...");

      google.script.run
        .withSuccessHandler(function(retorno) {
          definirStatusSalvar(false, "Salvo.", "success");
          ultimoIncidenteSalvoNumero = retorno && retorno.numeroRelatorio ? retorno.numeroRelatorio : valorCampo("numeroRelatorio");
          limparFormularioIncidente();
          limparAlteracaoPendenteNavegacao();
          carregarNumeroRelatorioIncidente();
          mostrarBotaoFichaIncidente(ultimoIncidenteSalvoNumero);
          ultimosIncidentesCarregados = false;
          mostrarStatus(retorno && retorno.mensagem ? retorno.mensagem : "Incidente Cr\u00edtico salvo com sucesso.", "success");
        })
        .withFailureHandler(function(erro) {
          definirStatusSalvar(false, obterMensagemErro(erro), "error");
          mostrarStatus(obterMensagemErro(erro), "error");
        })
        .salvarIncidenteCritico(montarDadosIncidente(), tokenGoogle);
    }

    function mostrarBotaoFichaIncidente(numeroRelatorio) {
      const botao = document.getElementById("btnImprimirFichaIncidente");

      if (!botao) return;

      ultimoIncidenteSalvoNumero = numeroRelatorio || "";
      botao.classList.toggle("ativo", !!ultimoIncidenteSalvoNumero);
    }

    function ocultarBotaoFichaIncidente() {
      const botao = document.getElementById("btnImprimirFichaIncidente");

      ultimoIncidenteSalvoNumero = "";
      if (botao) botao.classList.remove("ativo");
    }

    function imprimirFichaIncidenteSalva() {
      if (!ultimoIncidenteSalvoNumero) {
        mostrarStatus("Salve o incidente antes de imprimir a ficha.", "error");
        return;
      }

      imprimirFichaIncidentePorNumero(ultimoIncidenteSalvoNumero, true);
    }

    function alternarUltimosIncidentes(evento) {
      if (evento) evento.stopPropagation();

      const painel = document.getElementById("painelUltimosIncidentes");
      if (!painel) return;

      const estaAberto = painel.classList.contains("ativo");

      if (estaAberto) {
        fecharUltimosIncidentes();
        return;
      }

      painel.classList.add("ativo");
      carregarUltimosIncidentes(false);
    }

    function fecharUltimosIncidentes() {
      const painel = document.getElementById("painelUltimosIncidentes");
      if (painel) painel.classList.remove("ativo");
    }

    function carregarUltimosIncidentes(forcarAtualizacao) {
      const painel = document.getElementById("painelUltimosIncidentes");
      if (!painel || ultimosIncidentesCarregando) return;
      if (ultimosIncidentesCarregados && !forcarAtualizacao) return;

      if (!window.google || !google.script || !google.script.run) {
        painel.innerHTML = '<div class="ultimos-vazio">Abra pelo Apps Script para carregar a lista.</div>';
        return;
      }

      ultimosIncidentesCarregando = true;
      painel.innerHTML = '<div class="ultimos-vazio">Carregando...</div>';

      google.script.run
        .withSuccessHandler(function(lista) {
          ultimosIncidentesCarregando = false;
          ultimosIncidentesCarregados = true;
          renderizarUltimosIncidentes(lista || []);
        })
        .withFailureHandler(function(erro) {
          ultimosIncidentesCarregando = false;
          painel.innerHTML = '<div class="ultimos-vazio">Erro ao carregar: ' + escaparHtml(obterMensagemErro(erro)) + '</div>';
        })
        .obterUltimosIncidentesCriticosResponsavel(tokenGoogle);
    }

    function renderizarUltimosIncidentes(lista) {
      const painel = document.getElementById("painelUltimosIncidentes");
      if (!painel) return;

      if (!lista.length) {
        painel.innerHTML = '<div class="ultimos-titulo">&Uacute;ltimos incidentes</div>' +
          '<div class="ultimos-vazio">Nenhum incidente salvo por este usu&aacute;rio.</div>';
        return;
      }

      painel.innerHTML = '<div class="ultimos-titulo">&Uacute;ltimos incidentes</div>' + lista.map(function(item) {
        const numero = escaparHtml(item.numeroRelatorio || "");
        const nome = escaparHtml(formatarTextoFichaIncidente(item.nome || "Sem nome", "nome"));
        const detalhe = [
          item.dataFato ? "Fato em " + item.dataFato : "",
          item.modalidade ? formatarTextoFichaIncidente(item.modalidade, "titulo") : "",
          item.re ? "R.E. " + item.re : ""
        ].filter(Boolean).join(" - ");

        return '<button type="button" class="ultimo-incidente-item" data-numero="' + numero + '">' +
          '<strong>' + nome + '</strong>' +
          '<span>' + escaparHtml(numero + (detalhe ? " - " + detalhe : "")) + '</span>' +
        '</button>';
      }).join("");

      painel.querySelectorAll(".ultimo-incidente-item").forEach(function(botao) {
        botao.addEventListener("click", function() {
          imprimirFichaIncidentePorNumero(this.getAttribute("data-numero"), false);
          fecharUltimosIncidentes();
        });
      });
    }

    function imprimirFichaIncidentePorNumero(numeroRelatorio, ocultarBotaoDepois) {
      const numero = String(numeroRelatorio || "").trim();
      const janela = window.open("", "_blank");

      if (!numero) {
        mostrarStatus("Incidente n\u00e3o informado para impress\u00e3o.", "error");
        return;
      }

      if (!janela) {
        mostrarStatus("O navegador bloqueou a janela de impress\u00e3o. Libere pop-ups para o sistema.", "error");
        return;
      }

      janela.document.write("<p style='font-family:Arial;padding:24px;'>Carregando ficha de incidente cr&iacute;tico...</p>");

      google.script.run
        .withSuccessHandler(function(ficha) {
