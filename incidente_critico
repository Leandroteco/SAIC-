    function validarFormularioIncidente() {
      const idsObrigatorios = [
        "dataFato",
        "dataAcionamento",
        "postoGraduacao",
        "re",
        "nome",
        "opmAtual",
        "situacaoStatus",
        "vitima",
        "sexo",
        "modalidade"
      ];
      const camposComErro = [];
      let opmInvalida = false;

      document.querySelectorAll("input, select, textarea").forEach(limparErroVisualCampo);

      idsObrigatorios.forEach(function(id) {
        const campo = document.getElementById(id);

        if (campo && !campo.value.trim()) {
          marcarCampoObrigatorio(campo);
          camposComErro.push(campo);
        }
      });

      if (!validarDatasFormulario(["dataFato", "dataAcionamento"], ["dataFato", "dataAcionamento"])) {
        camposComErro.push(document.getElementById("dataFato"));
      }

      const campoOPM = document.getElementById("opmAtual");
      if (campoOPM && campoOPM.value.trim() && !padronizarCampoOPM(campoOPM)) {
        marcarCampoObrigatorio(campoOPM);
        if (!camposComErro.includes(campoOPM)) camposComErro.push(campoOPM);
        opmInvalida = true;
      }

      if (camposComErro.length > 0) {
        mostrarStatus(opmInvalida ? "Selecione uma OPM válida da lista." : "Preencha os campos obrigatorios destacados.", "error");
        camposComErro[0].focus();
        return false;
      }

      return true;
    }

    function limparFormularioIncidente() {
      document.querySelectorAll("input, select, textarea").forEach(function(campo) {
        if (campo.id === "numeroRelatorio" || campo.id === "psicologo") return;

        if (campo.type === "checkbox") {
          campo.checked = false;
        } else {
          campo.value = "";
        }

        limparErroVisualCampo(campo);
      });

      preencherPsicologoResponsavel();
      preencherDatasIncidenteSeVazias();
      atualizarEscalaPorSituacao();
      limparAlteracaoPendenteNavegacao();
    }

    function carregarNumeroRelatorioIncidente() {
      const campo = document.getElementById("numeroRelatorio");
      if (campo) campo.value = "Carregando...";

      google.script.run
        .withSuccessHandler(function(retorno) {
          if (campo) {
            campo.value = retorno && retorno.numeroRelatorio
              ? retorno.numeroRelatorio
              : "Gerado ao salvar";
          }
        })
        .withFailureHandler(function() {
          if (campo) campo.value = "Gerado ao salvar";
        })
        .obterNumeroRelatorioIncidenteCritico(tokenGoogle);
