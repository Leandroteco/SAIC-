    function padronizarCampoOPM(campo) {
      const valor = campo ? String(campo.value || "").trim() : "";

      if (!campo || !valor) return true;

      const chave = chaveComparacaoOPM(valor);
      const encontrado = obterOpcoesOPM().find(function(opcao) {
        return chaveComparacaoOPM(opcao) === chave;
      });

      if (encontrado) {
        campo.value = encontrado;
        limparErroVisualCampo(campo);
        return true;
      }

      return false;
    }

    function mascaraRE(campo) {
      let valor = campo.value.toUpperCase().replace(/[^0-9A]/g, "");
      let numerosAntesHifen = "";
      let digitoFinal = "";

      for (let i = 0; i < valor.length; i++) {
        const caractere = valor.charAt(i);

        if (numerosAntesHifen.length < 6) {
          if (/[0-9]/.test(caractere)) numerosAntesHifen += caractere;
          continue;
        }

        if (!digitoFinal && /[0-9A]/.test(caractere)) {
          digitoFinal = caractere;
          break;
        }
      }

      campo.value = digitoFinal ? numerosAntesHifen + "-" + digitoFinal : numerosAntesHifen;
    }

    function mascaraDataBrasil(campo) {
      let valor = campo.value.replace(/\D/g, "").substring(0, 8);

      valor = valor.replace(/(\d{2})(\d)/, "$1/$2");
      valor = valor.replace(/(\d{2})(\d)/, "$1/$2");

      campo.value = valor;
    }

    function validarAnoDataCampo(campo) {
      if (!campo.value) {
        limparErroVisualCampo(campo);
        return true;
      }

      if (dataBrasilValida(campo.value)) {
        limparErroVisualCampo(campo);
        return true;
      }

      campo.style.border = "2px solid #d32f2f";
      return false;
    }

    function validarDatasFormulario(ids, obrigatorios) {
      const obrigatoriosMapa = {};
      let valido = true;

      (obrigatorios || []).forEach(function(id) {
        obrigatoriosMapa[id] = true;
      });

      ids.forEach(function(id) {
        const campo = document.getElementById(id);
        if (!campo) return;

        if (obrigatoriosMapa[id] && !campo.value.trim()) {
          campo.style.border = "2px solid #d32f2f";
          valido = false;
          return;
        }

        if (!validarAnoDataCampo(campo)) {
          valido = false;
        }
      });

      if (!valido) {
        mostrarStatus("Confira as datas no formato dd/mm/aaaa.", "error");
      }

      return valido;
    }

    function dataBrasilValida(valor) {
      const partes = String(valor || "").trim().match(/^(\d{2})\/(\d{2})\/(\d{4})$/);

      if (!partes) return false;

      const dia = Number(partes[1]);
      const mes = Number(partes[2]);
      const ano = Number(partes[3]);

      if (ano < 1 || ano > 9999 || mes < 1 || mes > 12 || dia < 1) return false;

      const data = new Date(ano, mes - 1, dia);

      return data.getFullYear() === ano &&
        data.getMonth() === mes - 1 &&
        data.getDate() === dia;
    }

    function converterDataBrasilParaISO(valor) {
      const partes = String(valor || "").trim().match(/^(\d{2})\/(\d{2})\/(\d{4})$/);

      if (!partes) return "";

      return partes[3] + "-" + partes[2] + "-" + partes[1];
    }

    function limparErroVisualCampo(campo) {
      if (!campo) return;
      campo.style.border = "1px solid var(--line)";
    }

    function marcarCampoObrigatorio(campo) {
      if (!campo) return;
      campo.style.border = "2px solid #d32f2f";
    }

    function mostrarStatus(mensagem, tipo) {
      const el = document.getElementById("statusTela");
      el.className = "status-line" + (tipo ? " " + tipo : "");
      el.innerText = mensagem || "";
    }

    function obterMensagemErro(erro) {
      return erro && erro.message ? erro.message : "Nao foi possivel concluir a operacao.";
    }

    function escaparHtml(valor) {
      return String(valor === null || valor === undefined ? "" : valor)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }
  </script>
