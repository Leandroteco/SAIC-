    function valorFichaIncidente(valor) {
      const texto = String(valor === null || valor === undefined ? "" : valor).trim();
      return texto ? escaparHtml(texto) : "&nbsp;";
    }

    function formatarTextoFichaIncidente(valor, modo) {
      const texto = String(valor === null || valor === undefined ? "" : valor).trim();

      if (!texto) return "";
      if (modo === "upper") return texto.toUpperCase();
      if (modo === "nome" || modo === "titulo") return formatarResponsavelSistema(texto);

      return texto;
    }

    function normalizarTextoFichaIncidente(valor) {
      return String(valor || "")
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .trim();
    }

